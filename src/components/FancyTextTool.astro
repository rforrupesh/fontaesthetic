---
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  title: string;
  intro: string;
}
const { title, intro } = Astro.props;

// The 67 style cards are identical across languages (only style output changes,
// not the labels), so we reuse the exact markup extracted from the original
// static tool rather than duplicating 600 lines per language.
const gridHtml = fs.readFileSync(
  path.resolve('./src/components/_grid_only.html'),
  'utf-8'
);
---
<header>
  <h1>{title}</h1>
  <p>{intro}</p>
</header>

<div class="input-row">
  <span class="input-icon" aria-hidden="true">✎</span>
  <input id="srcInput" type="text" maxlength="60" placeholder="Type your text here" autocomplete="off" spellcheck="false" autofocus />
</div>

<Fragment set:html={gridHtml} />

<script src="../scripts/fancy-text-engine.js"></script>
