---
import { languages } from '../i18n';

interface Props {
  lang: string;
  // optional: map of lang -> full path (without base) to link directly to
  // the translated equivalent of the CURRENT page (e.g. a blog post whose
  // slug differs per language). If not provided, falls back to homepage.
  alternates?: Record<string, string>;
}
const { lang, alternates } = Astro.props;
const base = import.meta.env.BASE_URL;

// `alternates[code]` (if provided) is a bare path WITHOUT the language
// prefix, e.g. "/blog/how-to-use-custom-fonts/" — same convention as
// BaseLayout's `alternates` prop and the `getPath()` helper.
function hrefFor(code: string) {
  const bare = alternates?.[code];
  if (bare) {
    const clean = bare.replace(/^\/+/, '');
    return code === 'en' ? `${base}${clean}` : `${base}${code}/${clean}`;
  }
  return code === 'en' ? base : `${base}${code}/`;
}
---

<div class="lang-wrap relative inline-block">
  <select
    class="lang-select appearance-none bg-surface-2 text-text border border-border rounded-md pl-2.5 pr-7 py-1.5 text-sm cursor-pointer transition-colors duration-150 hover:border-primary focus:outline-none focus:border-primary"
    aria-label="Language switcher"
  >
    {Object.entries(languages).map(([code, info]) => (
      <option value={hrefFor(code)} selected={code === lang}>{info.native}</option>
    ))}
  </select>
  <svg class="lang-arrow pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 text-text-muted" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M6 9l6 6 6-6" />
  </svg>
</div>

<style>
  .lang-select {
    background-image: none;
  }
  .lang-select option {
    background: var(--color-surface-2);
    color: var(--color-text);
  }
</style>

<script>
  // Navbar renders this component twice (desktop bar + mobile panel), so
  // select by class and wire up every instance rather than relying on a
  // single unique id.
  document.querySelectorAll<HTMLSelectElement>('.lang-select').forEach((select) => {
    select.addEventListener('change', () => {
      if (select.value) window.location.href = select.value;
    });
  });
</script>
