---
interface Props {
  currentLang: 'en' | 'fr' | 'hi';
  translations?: Partial<Record<'en' | 'fr' | 'hi', string>>;
}
const { currentLang, translations } = Astro.props;
const base = import.meta.env.BASE_URL;
const langs = [
  { code: 'en', label: 'EN' },
  { code: 'fr', label: 'FR' },
  { code: 'hi', label: 'HI' }
];

// current URL path (includes base, e.g. /fontaesthetic/hi/blog/)
let pathname = Astro.url.pathname;
if (pathname.startsWith(base)) {
  pathname = pathname.slice(base.length);
}

// strip current lang prefix (fr/ or hi/) to get the "rest" of the path
let rest = pathname;
if (currentLang !== 'en' && rest.startsWith(`${currentLang}/`)) {
  rest = rest.slice(currentLang.length + 1);
}

function hrefFor(code: 'en' | 'fr' | 'hi') {
  // if an exact translated path is provided (e.g. for blog articles with
  // per-language slugs), use that. Otherwise fall back to same section,
  // just swapping the language prefix.
  if (translations && translations[code]) {
    const p = translations[code]!.replace(/^\//, '');
    return `${base}${p}`;
  }
  const prefix = code === 'en' ? '' : `${code}/`;
  return `${base}${prefix}${rest}`;
}
---
<div class="lang-switch">
  {langs.map((l) => (
    <a href={hrefFor(l.code)} class={l.code === currentLang ? 'active' : ''}>
      {l.label}
    </a>
  ))}
</div>
