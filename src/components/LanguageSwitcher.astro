---
interface Props {
  currentLang: 'en' | 'fr' | 'hi';
}
const { currentLang } = Astro.props;
const base = import.meta.env.BASE_URL;
const langs = [
  { code: 'en', label: 'EN' },
  { code: 'fr', label: 'FR' },
  { code: 'hi', label: 'HI' }
];
---
<div style="display:flex; gap:8px;">
  {langs.map((l) => {
    const prefix = l.code === 'en' ? '' : `${l.code}/`;
    const active = l.code === currentLang;
    return (
      <a
        href={`${base}${prefix}`}
        style={`padding:4px 10px; border-radius:6px; text-decoration:none; font-size:13px; border:1px solid #2a2a35; ${active ? 'background:#8b5cf6; color:#fff; border-color:#8b5cf6;' : 'color:#aaa;'}`}
      >
        {l.label}
      </a>
    );
  })}
</div>
