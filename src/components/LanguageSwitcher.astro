---
import { languages } from '../i18n';

interface Props {
  lang: string;
  // optional: map of lang -> full path (without base) to link directly to
  // the translated equivalent of the CURRENT page (e.g. a blog post whose
  // slug differs per language). If not provided, falls back to homepage.
  alternates?: Record<string, string>;
  // optional: restrict which languages show up in the dropdown, for pages
  // that only exist in one language (e.g. an English-only tool page). If
  // not provided, all configured languages are shown as usual.
  availableLangs?: string[];
  // compact: icon-only globe button (used in the mobile header)
  compact?: boolean;
}
const { lang, alternates, availableLangs, compact = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const visibleLanguages = availableLangs
  ? Object.fromEntries(Object.entries(languages).filter(([code]) => availableLangs.includes(code)))
  : languages;

// `alternates[code]` (if provided) is a bare path WITHOUT the language
// prefix, e.g. "/blog/how-to-use-custom-fonts/" — same convention as
// BaseLayout's `alternates` prop and the `getPath()` helper.
function hrefFor(code: string) {
  const bare = alternates?.[code];
  if (bare) {
    const clean = bare.replace(/^\/+/, '');
    return code === 'en' ? `${base}${clean}` : `${base}${code}/${clean}`;
  }
  return code === 'en' ? base : `${base}${code}/`;
}

// language code -> country flag file in /public/flags (real SVGs, so they look
// identical on every device; emoji flags don't render on Windows)
const flagFile: Record<string, string> = {
  en: 'gb', fr: 'fr', ar: 'sa', th: 'th', tr: 'tr', id: 'id', vi: 'vn',
  pl: 'pl', es: 'es', it: 'it', ja: 'jp', de: 'de', pt: 'pt',
};
const flagSrc = (c: string) => `${base}flags/${flagFile[c] ?? 'gb'}.svg`;

const current = languages[lang as keyof typeof languages] ?? languages.en;
---

<div class="lang-dropdown relative inline-block text-left">
  {compact ? (
    <button
      type="button"
      class="lang-trigger w-9 h-9 rounded-md bg-surface-2 border border-border flex items-center justify-center text-text-muted hover:text-text hover:border-primary transition-colors duration-150 cursor-pointer"
      aria-haspopup="listbox"
      aria-expanded="false"
      aria-label={`Language: ${current.native}`}
    >
      <img src={flagSrc(lang)} alt="" width="22" height="16" class="w-[22px] h-4 rounded-[3px] object-cover ring-1 ring-black/15" />
    </button>
  ) : (
    <button
      type="button"
      class="lang-trigger flex items-center gap-1.5 bg-surface-2 text-text border border-border rounded-md pl-2.5 pr-2 py-1.5 text-sm cursor-pointer transition-colors duration-150 hover:border-primary"
      aria-haspopup="listbox"
      aria-expanded="false"
    >
      <img src={flagSrc(lang)} alt="" width="20" height="15" class="w-5 h-[15px] rounded-[3px] object-cover ring-1 ring-black/15" />
      <span class="lang-trigger-label">{current.native}</span>
      <svg class="lang-arrow shrink-0 text-text-muted transition-transform duration-150" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 9l6 6 6-6" />
      </svg>
    </button>
  )}

  <ul
    class="lang-menu hidden fixed z-[100] w-max py-1 bg-surface border border-border rounded-md shadow-lg max-h-[60vh] overflow-y-auto"
    role="listbox"
  >
    {Object.entries(visibleLanguages).map(([code, info]) => (
      <li role="option" aria-selected={code === lang}>
        <a
          href={hrefFor(code)}
          class:list={[
            'lang-option block px-3 py-2 text-sm whitespace-nowrap transition-colors duration-150 hover:bg-surface-2 hover:text-text',
            code === lang ? 'text-primary' : 'text-text-muted',
          ]}
        >
          <span class="inline-flex items-center gap-2.5"><img src={flagSrc(code)} alt="" width="20" height="15" loading="lazy" class="w-5 h-[15px] rounded-[3px] object-cover ring-1 ring-black/15" />{info.native}</span>
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  // Navbar renders this component twice (desktop bar + mobile panel), so
  // select by class and wire up every instance rather than relying on a
  // single unique id.
  const GAP = 6; // space kept between the trigger and the menu

  // The menu is moved to <body> while open so no ancestor (header backdrop-filter,
  // transformed mobile links, overflow:hidden panels) can clip or re-anchor it.
  const homes = new WeakMap<HTMLElement, HTMLElement>();

  function closeAll() {
    document.querySelectorAll<HTMLElement>('.lang-menu').forEach((m) => {
      m.classList.add('hidden');
      const home = homes.get(m);
      if (home && m.parentElement !== home) home.appendChild(m);
    });
    document.querySelectorAll<HTMLElement>('.lang-trigger').forEach((t) => t.setAttribute('aria-expanded', 'false'));
    document.querySelectorAll<HTMLElement>('.lang-arrow').forEach((a) => a.classList.remove('rotate-180'));
  }

  // Menu uses position:fixed and its top/left are calculated fresh on every
  // open, so it never affects the surrounding layout (no reflow, no new
  // margin/padding on the trigger or its neighbours) and always flips to
  // whichever side (up/down, left/right) actually has room in the viewport.
  function positionMenu(trigger: HTMLElement, menu: HTMLElement) {
    const triggerRect = trigger.getBoundingClientRect();
    const menuRect = menu.getBoundingClientRect();
    const vw = window.innerWidth;
    const vh = window.innerHeight;

    const spaceBelow = vh - triggerRect.bottom;
    const openUp = spaceBelow < menuRect.height + GAP && triggerRect.top > spaceBelow;
    const top = openUp
      ? Math.max(GAP, triggerRect.top - menuRect.height - GAP)
      : triggerRect.bottom + GAP;

    const spaceRight = vw - triggerRect.right;
    const alignLeft = spaceRight < menuRect.width && triggerRect.left >= menuRect.width;
    const left = alignLeft
      ? triggerRect.right - menuRect.width
      : Math.min(triggerRect.left, vw - menuRect.width - GAP);

    menu.style.top = `${top}px`;
    menu.style.left = `${Math.max(GAP, left)}px`;
  }

  document.querySelectorAll<HTMLElement>('.lang-dropdown').forEach((wrap) => {
    const trigger = wrap.querySelector<HTMLButtonElement>('.lang-trigger');
    const menu = wrap.querySelector<HTMLUListElement>('.lang-menu');
    const arrow = wrap.querySelector<SVGElement>('.lang-arrow');
    if (!trigger || !menu) return;

    function open() {
      homes.set(menu!, wrap as HTMLElement);
      document.body.appendChild(menu!);
      menu!.classList.remove('hidden');
      positionMenu(trigger!, menu!);
      trigger!.setAttribute('aria-expanded', 'true');
      arrow?.classList.add('rotate-180');
    }

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';
      closeAll();
      if (!isOpen) open();
    });

    menu.addEventListener('click', (e) => e.stopPropagation());
  });

  document.addEventListener('click', closeAll);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAll();
  });
  // Reposition (or just close) if the viewport changes shape while open.
  let lastW = window.innerWidth;
  window.addEventListener('resize', () => {
    if (window.innerWidth !== lastW) { lastW = window.innerWidth; closeAll(); }
  });
  window.addEventListener('scroll', (e) => {
    const t = e.target as Node | null;
    // scrolling the language list itself must not close it
    if (t instanceof Element && t.closest('.lang-menu')) return;
    closeAll();
  }, true);
</script>
