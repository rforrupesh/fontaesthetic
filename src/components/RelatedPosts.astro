---
import { t, getPath } from '../i18n';

interface RelatedPost { title: string; description: string; slug: string; image?: string; }

interface Props {
  lang: string;
  posts: RelatedPost[];
}

const { lang, posts } = Astro.props;
const strings = t(lang);
---

{posts.length > 0 && (
  <section class="mt-12 pt-8 border-t border-border">
    <h2 class="text-xl mb-5">{strings.sidebar.related}</h2>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
      {posts.map((post) => (
        <a class="card overflow-hidden flex flex-col" href={getPath(lang, `/blog/${post.slug}/`)}>
          {post.image && <img src={post.image} alt={post.title} loading="lazy" class="w-full aspect-video object-cover" />}
          <div class="p-4">
            <h3 class="text-[.95rem] mb-1.5">{post.title}</h3>
            <p class="text-[.82rem] text-text-muted m-0">{post.description}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
)}
