---
import en from '../i18n/en.json';
import fr from '../i18n/fr.json';
import hi from '../i18n/hi.json';

interface Props {
  lang: 'en' | 'fr' | 'hi';
}
const { lang } = Astro.props;
const dict = { en, fr, hi }[lang];
const base = import.meta.env.BASE_URL;
const prefix = lang === 'en' ? '' : `${lang}/`;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-links">
      <a href={`${base}${prefix}about/`}>{dict.footer.about}</a>
      <a href={`${base}${prefix}privacy-policy/`}>{dict.footer.privacy}</a>
      <a href={`${base}${prefix}contact/`}>{dict.footer.contact}</a>
    </div>
    <div>&copy; {year} FontAesthetic. {dict.footer.copyright}</div>
  </div>
</footer>
