---
import { Image } from 'astro:assets';
import { t, getPath } from '../i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import SocialLinks from './SocialLinks.astro';
import logo from '../assets/logo_fontaesthetic.png';
interface Props { lang: string; alternates?: Record<string, string>; availableLangs?: string[]; }
const { lang, alternates, availableLangs } = Astro.props;
const strings = t(lang);
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-border bg-surface text-text-muted text-sm">
  <div class="container grid gap-10 py-12 sm:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <a href={getPath(lang, '/')} class="flex items-center gap-2 w-fit">
        <Image
          src={logo}
          alt={strings.site.name}
          width={480}
          height={89}
          format="webp"
          loading="lazy"
          class="h-7 w-auto max-w-[120px] object-contain"
        />
        <strong class="text-text text-base">{strings.site.name}</strong>
      </a>
      <p class="mt-3 max-w-[26ch] leading-relaxed">{strings.footer.madeWith}</p>
    </div>

    <div>
      <h2 class="text-text font-semibold mb-3">{strings.footer.explore}</h2>
      <nav class="flex flex-col gap-2.5">
        <a href={getPath(lang, '/about/')} class="w-fit hover:text-primary transition-colors duration-150">{strings.footer.about}</a>
        <a href={getPath(lang, '/blog/')} class="w-fit hover:text-primary transition-colors duration-150">{strings.footer.blog}</a>
        <a href={getPath(lang, '/contact/')} class="w-fit hover:text-primary transition-colors duration-150">{strings.footer.contact}</a>
        <a href={getPath(lang, '/privacy-policy/')} class="w-fit hover:text-primary transition-colors duration-150">{strings.footer.privacy}</a>
      </nav>
    </div>

    <div>
      <h2 class="text-text font-semibold mb-3">{strings.footer.follow}</h2>
      <SocialLinks size="sm" />
      <div class="mt-5 flex items-center gap-2.5">
        <ThemeToggle />
        <LanguageSwitcher lang={lang} alternates={alternates} availableLangs={availableLangs} />
      </div>
    </div>
  </div>

  <div class="border-t border-border">
    <div class="container py-5 text-xs">
      &copy; {year} {strings.site.name}. {strings.footer.rights}
    </div>
  </div>
</footer>
