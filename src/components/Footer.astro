---
import { Image } from 'astro:assets';
import { t, getPath } from '../i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import SocialLinks from './SocialLinks.astro';
import logo from '../assets/logo_fontaesthetic.png';
interface Props { lang: string; alternates?: Record<string, string>; availableLangs?: string[]; }
const { lang, alternates, availableLangs } = Astro.props;
const strings = t(lang);
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-border bg-surface text-text-muted text-sm">
  <div class="container py-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between border-b border-border">
    <a href={getPath(lang, '/')} class="flex items-center gap-2 w-fit">
      <Image
        src={logo}
        alt={strings.site.name}
        width={480}
        height={89}
        format="webp"
        loading="lazy"
        class="h-7 w-auto max-w-[120px] object-contain"
      />
      <strong class="text-text text-base">{strings.site.name}</strong>
    </a>
    <p class="text-text-muted">{strings.site.tagline}</p>
  </div>

  <div class="container py-10 grid gap-8 sm:grid-cols-[1fr_1fr_auto]">
    <div>
      <h2 class="text-text font-semibold mb-3">{strings.footer.company}</h2>
      <nav class="flex flex-col gap-2.5">
        <a href={getPath(lang, '/about/')} class="w-fit hover:text-primary transition-colors duration-150">{strings.footer.about}</a>
        <a href={getPath(lang, '/contact/')} class="w-fit hover:text-primary transition-colors duration-150">{strings.footer.contact}</a>
      </nav>
    </div>

    <div>
      <h2 class="text-text font-semibold mb-3">{strings.footer.explore}</h2>
      <nav class="flex flex-col gap-2.5">
        <a href={getPath(lang, '/blog/')} class="w-fit hover:text-primary transition-colors duration-150">{strings.footer.blog}</a>
        <a href={getPath(lang, '/privacy-policy/')} class="w-fit hover:text-primary transition-colors duration-150">{strings.footer.privacy}</a>
      </nav>
    </div>

    <div class="flex flex-col gap-4 sm:items-end">
      <div class="flex items-center gap-2.5">
        <ThemeToggle />
        <LanguageSwitcher lang={lang} alternates={alternates} availableLangs={availableLangs} />
      </div>
      <div>
        <span class="block mb-2 sm:text-right">{strings.footer.follow}</span>
        <SocialLinks size="sm" />
      </div>
    </div>
  </div>

  <div class="border-t border-border">
    <div class="container py-5 flex flex-col-reverse gap-2 sm:flex-row sm:items-center sm:justify-between text-xs">
      <span>&copy; {year} {strings.site.name}. {strings.footer.rights}</span>
      <a href={getPath(lang, '/privacy-policy/')} class="hover:text-primary transition-colors duration-150">{strings.footer.privacy}</a>
    </div>
  </div>
</footer>
