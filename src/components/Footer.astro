---
import { useTranslations } from '../i18n/ui';
interface Props {
  lang: 'en' | 'fr' | 'es';
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const prefixFor = (l: string) => (l === 'en' ? '' : `/${l}`);
const p = prefixFor(lang);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="site-footer-grid">
      <div class="site-footer-col">
        <a href={p || '/'} class="site-footer-brand">
          <img src="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%231a73e8'/%3E%3Ctext x='16' y='23' font-family='Google Sans,sans-serif' font-size='19' font-weight='700' fill='white' text-anchor='middle'%3EF%3C/text%3E%3C/svg%3E" alt="FontAesthetic logo">
          Font<span>Aesthetic</span>
        </a>
        <p class="site-footer-tagline">{t('footer.tagline')}</p>
      </div>

      <div class="site-footer-col">
        <h4>{t('footer.company')}</h4>
        <ul>
          <li><a href={`${p}/about/`}>{t('footer.about')}</a></li>
          <li><a href={`${p}/blog/`}>{t('footer.blog')}</a></li>
          <li><a href={`${p}/contact/`}>{t('footer.contact')}</a></li>
        </ul>
      </div>

      <div class="site-footer-col">
        <h4>{t('footer.legal')}</h4>
        <ul>
          <li><a href={`${p}/privacy/`}>{t('footer.privacy')}</a></li>
          <li><a href={`${p}/terms/`}>{t('footer.terms')}</a></li>
        </ul>
      </div>

      <div class="site-footer-col">
        <h4>{t('footer.tools')}</h4>
        <ul>
          <li><a href={`${p}/fancy-text/`}>{t('nav.fancytext')}</a></li>
          <li><a href={`${p}/emoji/`}>{t('footer.emoji')}</a></li>
        </ul>
      </div>
    </div>

    <div class="site-footer-bottom">
      <span>All styles are real Unicode characters — copy and paste anywhere.</span>
      <span>© {year} FontAesthetic.</span>
    </div>
  </div>
</footer>
