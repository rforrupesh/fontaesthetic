---
import en from '../i18n/en.json';
import fr from '../i18n/fr.json';
import hi from '../i18n/hi.json';

interface Props {
  lang: 'en' | 'fr' | 'hi';
}
const { lang } = Astro.props;
const dict = { en, fr, hi }[lang];
const base = import.meta.env.BASE_URL;
const prefix = lang === 'en' ? '' : `${lang}/`;
const year = new Date().getFullYear();
---
<footer style="border-top:1px solid #2a2a35; margin-top:40px; padding:24px; text-align:center; color:#888; font-size:14px;">
  <div style="display:flex; justify-content:center; gap:20px; margin-bottom:10px;">
    <a href={`${base}${prefix}about/`} style="text-decoration:none; color:#aaa;">{dict.footer.about}</a>
    <a href={`${base}${prefix}privacy-policy/`} style="text-decoration:none; color:#aaa;">{dict.footer.privacy}</a>
    <a href={`${base}${prefix}contact/`} style="text-decoration:none; color:#aaa;">{dict.footer.contact}</a>
  </div>
  <div>&copy; {year} FontAesthetic. {dict.footer.copyright}</div>
</footer>
