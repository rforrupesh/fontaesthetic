---
import { t, getPath } from '../i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import SocialLinks from './SocialLinks.astro';
interface Props { lang: string; alternates?: Record<string, string>; availableLangs?: string[]; }
const { lang, alternates, availableLangs } = Astro.props;
const strings = t(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-border mt-10 pt-8 pb-6 text-text-muted text-sm">
  <div class="container grid gap-8 sm:grid-cols-[1.3fr_1fr_1fr] mb-6">
    <div>
      <strong class="text-text text-base">{strings.site.name}</strong>
      <p class="mt-1.5 max-w-xs text-[.85rem]">{strings.footer.madeWith}</p>
    </div>

    <nav class="flex flex-col gap-1.5 text-[.85rem]">
      <a href={getPath(lang, '/about/')} class="hover:text-text transition-colors duration-150">{strings.footer.about}</a>
      <a href={getPath(lang, '/blog/')} class="hover:text-text transition-colors duration-150">{strings.footer.blog}</a>
      <a href={getPath(lang, '/contact/')} class="hover:text-text transition-colors duration-150">{strings.footer.contact}</a>
      <a href={getPath(lang, '/privacy-policy/')} class="hover:text-text transition-colors duration-150">{strings.footer.privacy}</a>
    </nav>

    <div class="flex flex-col gap-2.5">
      <span class="text-text-muted text-[.85rem]">{strings.footer.follow}</span>
      <SocialLinks size="sm" />
      <div class="mt-0.5 flex items-center gap-2.5">
        <ThemeToggle />
        <LanguageSwitcher lang={lang} alternates={alternates} availableLangs={availableLangs} />
      </div>
    </div>
  </div>

  <div class="container border-t border-border pt-4 text-center text-xs">
    &copy; {year} {strings.site.name}. {strings.footer.rights}
  </div>
</footer>
