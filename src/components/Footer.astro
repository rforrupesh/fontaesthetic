---
import { t, getPath } from '../i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
interface Props { lang: string; }
const { lang } = Astro.props;
const strings = t(lang);
const year = new Date().getFullYear();

const socials = [
  {
    name: 'Facebook',
    href: 'https://facebook.com/fontaesthetic',
    path: 'M13.5 9H15V6h-1.75C11.24 6 10 7.24 10 9.25V11H8v3h2v7h3v-7h2.1l.4-3H13v-1.35c0-.45.15-.65.5-.65Z',
  },
  {
    name: 'X',
    href: 'https://x.com/fontaesthetic',
    path: 'M4 4l7.2 9.4L4.4 20H6l6-6.5 4.4 6.5H20l-7.5-9.9L19 4h-1.6l-5.5 6-4-6H4Zm2.4 1.3h2l9.2 13.4h-2L6.4 5.3Z',
  },
  {
    name: 'Reddit',
    href: 'https://reddit.com/r/fontaesthetic',
    path: 'M20 12.3c0-1-.8-1.8-1.8-1.8-.5 0-.9.2-1.3.5-1.1-.7-2.5-1.2-4.1-1.3l.8-3.3 2.5.6a1.3 1.3 0 1 0 .1-.7l-2.8-.6a.4.4 0 0 0-.4.3l-.9 3.7c-1.6.1-3 .6-4.1 1.3-.3-.3-.8-.5-1.3-.5-1 0-1.8.8-1.8 1.8 0 .7.4 1.3 1 1.6a3 3 0 0 0 0 .5c0 2.2 2.6 4 5.9 4s5.9-1.8 5.9-4l-.1-.5c.6-.3 1-.9 1-1.6ZM9 13.2a1 1 0 1 1 2 0 1 1 0 0 1-2 0Zm5.7 2.4c-.7.7-1.9 1-2.7 1s-2-.3-2.7-1a.3.3 0 0 1 .4-.5c.6.5 1.4.8 2.3.8s1.7-.3 2.3-.8a.3.3 0 0 1 .4.5Zm-.2-1.4a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z',
  },
  {
    name: 'YouTube',
    href: 'https://youtube.com/@fontaesthetic',
    path: 'M21.6 8.2a2.5 2.5 0 0 0-1.8-1.8C18.1 6 12 6 12 6s-6.1 0-7.8.4A2.5 2.5 0 0 0 2.4 8.2 26 26 0 0 0 2 12.5a26 26 0 0 0 .4 4.3 2.5 2.5 0 0 0 1.8 1.8C5.9 19 12 19 12 19s6.1 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8 26 26 0 0 0 .4-4.3 26 26 0 0 0-.4-4.3ZM10 15.5v-6l5.2 3-5.2 3Z',
  },
  {
    name: 'Pinterest',
    href: 'https://pinterest.com/fontaesthetic',
    path: 'M12 3a9 9 0 0 0-3.3 17.4c0-.7-.1-1.9.1-2.7l1.3-5.5s-.3-.7-.3-1.6c0-1.5.9-2.6 1.9-2.6.9 0 1.4.7 1.4 1.5 0 .9-.6 2.3-.9 3.5-.3 1.1.5 2 1.6 2 1.9 0 3.2-2.4 3.2-5.3 0-2.2-1.5-3.8-4.2-3.8-3 0-4.9 2.3-4.9 4.8 0 .9.3 1.5.7 2 .2.2.2.3.1.5l-.2.9c-.1.3-.3.4-.6.3-1.1-.5-1.6-1.9-1.6-3.4 0-2.5 2.1-5.5 6.3-5.5 3.4 0 5.6 2.4 5.6 5.1 0 3.5-1.9 6.1-4.7 6.1-.9 0-1.8-.5-2.1-1.1l-.6 2.3c-.2.8-.6 1.7-1 2.3.9.3 1.9.4 2.9.4A9 9 0 0 0 12 3Z',
  },
];
---

<footer class="border-t border-border mt-16 pt-12 pb-8 text-text-muted text-sm">
  <div class="container grid gap-10 sm:grid-cols-[1.3fr_1fr_1fr] mb-8">
    <div>
      <strong class="text-text text-base">{strings.site.name}</strong>
      <p class="mt-2 max-w-xs">{strings.footer.madeWith}</p>
    </div>

    <nav class="flex flex-col gap-2">
      <a href={getPath(lang, '/about/')} class="hover:text-text transition-colors duration-150">{strings.footer.about}</a>
      <a href={getPath(lang, '/blog/')} class="hover:text-text transition-colors duration-150">{strings.footer.blog}</a>
      <a href={getPath(lang, '/contact/')} class="hover:text-text transition-colors duration-150">{strings.footer.contact}</a>
      <a href={getPath(lang, '/privacy-policy/')} class="hover:text-text transition-colors duration-150">{strings.footer.privacy}</a>
    </nav>

    <div class="flex flex-col gap-3">
      <span class="text-text-muted">{strings.footer.follow}</span>
      <div class="flex gap-3">
        {socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.name}
            class="w-8 h-8 rounded-md bg-surface-2 border border-border flex items-center justify-center text-text-muted hover:text-text hover:border-primary transition-colors duration-150"
          >
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d={s.path} /></svg>
          </a>
        ))}
      </div>
      <div class="mt-1 flex items-center gap-3">
        <ThemeToggle />
        <LanguageSwitcher lang={lang} />
      </div>
    </div>
  </div>

  <div class="container border-t border-border pt-5 text-center text-xs">
    &copy; {year} {strings.site.name}. {strings.footer.rights}
  </div>
</footer>
