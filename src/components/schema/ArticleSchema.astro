---
interface Props {
  headline: string;
  description: string;
  url: string;         // absolute canonical URL of the article
  image?: string;       // absolute image URL
  datePublished: Date;
  dateModified?: Date;
  siteName: string;
  logoUrl: string;      // absolute, used for publisher.logo
  lang: string;
  author?: { displayName: string; type?: string; url?: string; sameAs?: string; image?: string };
}
const { headline, description, url, image, datePublished, dateModified, siteName, logoUrl, lang, author } = Astro.props;

const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline,
  description,
  inLanguage: lang,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  ...(image ? { image: [image] } : {}),
  datePublished: datePublished.toISOString(),
  dateModified: (dateModified ?? datePublished).toISOString(),
  author: author
    ? {
        '@type': author.type ?? 'Person',
        name: author.displayName,
        ...(author.url ? { url: author.url } : {}),
        ...(author.sameAs ? { sameAs: [author.sameAs] } : {}),
      }
    : { '@type': 'Organization', name: siteName },
  publisher: {
    '@type': 'Organization',
    name: siteName,
    logo: {
      '@type': 'ImageObject',
      url: logoUrl,
    },
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(article)} />
