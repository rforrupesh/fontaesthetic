---
interface Props {
  name: string;
  siteUrl: string; // absolute, e.g. https://rforrupesh.github.io/fontaesthetic/
  logoUrl: string; // absolute
}
const { name, siteUrl, logoUrl } = Astro.props;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}#organization`,
  name,
  url: siteUrl,
  logo: {
    '@type': 'ImageObject',
    '@id': `${siteUrl}#logo`,
    url: logoUrl,
    contentUrl: logoUrl,
  },
  image: { '@id': `${siteUrl}#logo` },
};
---

<script type="application/ld+json" set:html={JSON.stringify(organization)} />
