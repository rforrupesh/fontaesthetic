---
// Theme menu: System (default) / Light / Dark. The button shows the icon of the
// current choice; the menu lists all three. State lives on <html data-theme-pref>,
// set by the inline script in BaseLayout (which also exposes window.__setThemePref).
import { t } from '../i18n';

interface Props { lang?: string; }
const { lang = 'en' } = Astro.props;
const s = t(lang).theme;

const options = [
  { value: 'system', label: s.system },
  { value: 'light', label: s.light },
  { value: 'dark', label: s.dark },
];
---

<div class="theme-menu relative shrink-0">
  <button
    type="button"
    class="theme-toggle w-9 h-9 rounded-md bg-surface-2 border border-border flex items-center justify-center text-text-muted hover:text-text hover:border-primary transition-colors duration-150"
    aria-label={s.label}
    aria-haspopup="menu"
    aria-expanded="false"
  >
    <svg class="ic ic-system" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" />
    </svg>
    <svg class="ic ic-light" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
    </svg>
    <svg class="ic ic-dark" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
      <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z" />
    </svg>
  </button>

  <div class="theme-list card absolute end-0 top-[calc(100%+6px)] z-50 min-w-[130px] p-1 flex-col" role="menu" hidden>
    {options.map((o) => (
      <button type="button" role="menuitemradio" aria-checked="false" data-theme-value={o.value}
        class="theme-opt w-full text-start text-[.85rem] px-3 py-2 rounded-md text-text hover:bg-surface-2 flex items-center justify-between gap-3">
        <span>{o.label}</span>
        <span class="theme-check text-primary" aria-hidden="true">✓</span>
      </button>
    ))}
  </div>
</div>

<style is:global>
  .theme-list:not([hidden]) { display: flex; }
  .theme-opt .theme-check { visibility: hidden; }
  .theme-opt[aria-checked='true'] .theme-check { visibility: visible; }
</style>

<script>
  const menus = document.querySelectorAll<HTMLElement>('.theme-menu');
  const root = document.documentElement;

  const closeAll = () => menus.forEach((m) => {
    m.querySelector<HTMLElement>('.theme-list')!.hidden = true;
    m.querySelector('.theme-toggle')!.setAttribute('aria-expanded', 'false');
  });

  const syncChecks = () => {
    const pref = root.getAttribute('data-theme-pref') || 'system';
    document.querySelectorAll<HTMLElement>('.theme-opt').forEach((o) =>
      o.setAttribute('aria-checked', String(o.dataset.themeValue === pref)));
  };

  menus.forEach((m) => {
    const btn = m.querySelector<HTMLButtonElement>('.theme-toggle')!;
    const list = m.querySelector<HTMLElement>('.theme-list')!;

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = list.hidden;
      closeAll();
      list.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      if (open) syncChecks();
    });

    list.addEventListener('click', (e) => {
      const opt = (e.target as HTMLElement).closest<HTMLElement>('.theme-opt');
      if (!opt) return;
      (window as any).__setThemePref(opt.dataset.themeValue);
      syncChecks();
      closeAll();
    });
  });

  document.addEventListener('click', closeAll);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(); });
  syncChecks();
</script>
