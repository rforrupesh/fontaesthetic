---
import { t } from '../i18n';

// "Add Text to Photo" tool. Everything runs in the visitor's browser on a <canvas>:
// the photo is never uploaded, there is no login and nothing is stamped on the export.
// UI strings default to English; add a `photoTool` object to a language JSON to translate.
interface Props { lang: string; }
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;

const defaults = {
  heading: 'Add Text to Photo',
  subheading: 'Add text to any image online for free. Pick from 65 Google Fonts, style it, and download in full quality. No login, no watermark, and your photo never leaves your device.',
  dropTitle: 'Drop a photo here',
  dropHint: 'or paste an image (Ctrl+V), JPG, PNG, WebP',
  choose: 'Choose a photo',
  samples: 'No photo handy? Try a sample:',
  private: 'Private: your photo stays in your browser',
  addText: 'Add text',
  duplicate: 'Duplicate',
  remove: 'Delete',
  undo: 'Undo',
  redo: 'Redo',
  change: 'Change photo',
  download: 'Download',
  format: 'Format',
  quality: 'Quality',
  tabText: 'Text',
  tabFont: 'Font',
  tabEffects: 'Effects',
  tabPresets: 'Presets',
  emptyHint: 'Tap a text on the photo to edit it, or press Add text.',
  yourText: 'Your text',
  size: 'Size',
  color: 'Color',
  bold: 'Bold',
  italic: 'Italic',
  alignLeft: 'Align left',
  alignCenter: 'Align center',
  alignRight: 'Align right',
  searchFont: 'Search fonts…',
  all: 'All',
  catSans: 'Sans',
  catSerif: 'Serif',
  catDisplay: 'Display',
  catScript: 'Script',
  catMono: 'Mono',
  noFonts: 'No fonts match your search.',
  opacity: 'Opacity',
  rotation: 'Rotation',
  letterSpacing: 'Letter spacing',
  lineHeight: 'Line height',
  outline: 'Outline',
  outlineWidth: 'Width',
  shadow: 'Shadow',
  shadowBlur: 'Softness',
  background: 'Background box',
  bgOpacity: 'Opacity',
  bgPadding: 'Padding',
  front: 'Bring to front',
  back: 'Send to back',
  errImage: 'Sorry, that file could not be opened as an image. Try a JPG, PNG or WebP.',
  errExport: 'Sorry, the image could not be exported. Try a smaller photo or another format.',
  presetMeme: 'Meme',
  presetAesthetic: 'Aesthetic',
  presetNeon: 'Neon',
  presetQuote: 'Quote',
  presetTitle: 'Bold title',
  presetHandwritten: 'Handwritten',
  presetRetro: 'Retro',
  presetElegant: 'Elegant',
};
const L = { ...defaults, ...(((t(lang) as any).photoTool) ?? {}) } as typeof defaults;

const swatches = ['#ffffff', '#000000', '#ff3b30', '#ff9500', '#ffd60a', '#34c759', '#00c7be', '#0a7aff', '#5e5ce6', '#ff6b9d', '#a2845e', '#8e8e93'];
const aligns = [
  { v: 'left', label: L.alignLeft, d: 'M3 6h18M3 12h12M3 18h16' },
  { v: 'center', label: L.alignCenter, d: 'M3 6h18M6 12h12M4 18h16' },
  { v: 'right', label: L.alignRight, d: 'M3 6h18M9 12h12M5 18h16' },
];
const presetList = [
  { key: 'meme', label: L.presetMeme },
  { key: 'aesthetic', label: L.presetAesthetic },
  { key: 'neon', label: L.presetNeon },
  { key: 'quote', label: L.presetQuote },
  { key: 'title', label: L.presetTitle },
  { key: 'handwritten', label: L.presetHandwritten },
  { key: 'retro', label: L.presetRetro },
  { key: 'elegant', label: L.presetElegant },
];
---

<section class="py-8 pb-6">
  <div class="wrap">
    <div class="text-center mb-6">
      <h1 class="text-[clamp(1.6rem,3.4vw,2.2rem)] mb-2">{L.heading}</h1>
      <p class="text-text-muted text-sm max-w-[680px] mx-auto">{L.subheading}</p>
    </div>

    <div id="ptt-root" data-base={base} data-err-image={L.errImage} data-err-export={L.errExport} data-your-text={L.yourText} data-no-fonts={L.noFonts}>

      <!-- Step 1: choose a photo -->
      <div id="ptt-start" class="max-w-[640px] mx-auto">
        <div id="ptt-drop" class="card ptt-drop text-center px-5 py-10" tabindex="0" role="button" aria-label={L.choose}>
          <svg class="mx-auto mb-3 text-primary" viewBox="0 0 24 24" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3"/><circle cx="8.5" cy="9.5" r="1.8"/><path d="m21 16-5-5-8 8"/></svg>
          <p class="font-semibold text-lg mb-1">{L.dropTitle}</p>
          <p class="text-text-muted text-sm mb-4">{L.dropHint}</p>
          <button type="button" id="ptt-choose" class="btn">{L.choose}</button>
          <input type="file" id="ptt-file" accept="image/*" class="sr-only" tabindex="-1" aria-hidden="true" />
        </div>
        <p id="ptt-msg" class="text-center text-sm mt-3" style="color:#ff6b6b" role="alert" hidden></p>
        <div class="mt-5 text-center">
          <p class="text-text-muted text-sm mb-2">{L.samples}</p>
          <div class="flex justify-center gap-2.5 flex-wrap">
            <button type="button" class="ptt-sample" data-sample="sunset" aria-label="Sunset sample" style="background:linear-gradient(135deg,#ff9a56,#ff4e7e 55%,#5b3cc4)"></button>
            <button type="button" class="ptt-sample" data-sample="ocean" aria-label="Ocean sample" style="background:linear-gradient(135deg,#8be3ff,#1b7fd6 55%,#0b2a6b)"></button>
            <button type="button" class="ptt-sample" data-sample="forest" aria-label="Forest sample" style="background:linear-gradient(135deg,#d4f08a,#37a65a 55%,#0d4a3a)"></button>
          </div>
        </div>
        <p class="text-center text-text-muted text-xs mt-5 inline-flex w-full items-center justify-center gap-1.5">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
          {L.private}
        </p>
      </div>

      <!-- Step 2: editor -->
      <div id="ptt-editor" hidden>
        <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_340px] items-start">

          <!-- Canvas side -->
          <div class="min-w-0">
            <div class="card p-2 mb-3 flex flex-wrap items-center gap-1.5">
              <button type="button" id="ptt-add" class="btn"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>{L.addText}</button>
              <button type="button" id="ptt-dup" class="ptt-icon" aria-label={L.duplicate} title={L.duplicate}><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 0 1 2-2h9"/></svg></button>
              <button type="button" id="ptt-del" class="ptt-icon" aria-label={L.remove} title={L.remove}><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3"/></svg></button>
              <span class="w-px h-6 bg-border mx-1" aria-hidden="true"></span>
              <button type="button" id="ptt-undo" class="ptt-icon" aria-label={L.undo} title={L.undo}><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 14 4 9l5-5"/><path d="M4 9h10a6 6 0 0 1 0 12h-3"/></svg></button>
              <button type="button" id="ptt-redo" class="ptt-icon" aria-label={L.redo} title={L.redo}><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 14 5-5-5-5"/><path d="M20 9H10a6 6 0 0 0 0 12h3"/></svg></button>
              <button type="button" id="ptt-change" class="ptt-ghost ml-auto"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3"/><circle cx="8.5" cy="9.5" r="1.6"/><path d="m21 16-5-5-8 8"/></svg>{L.change}</button>
            </div>

            <div id="ptt-stage" class="card ptt-stage p-3 flex items-center justify-center">
              <canvas id="ptt-canvas" role="img" aria-label="Photo editor canvas"></canvas>
            </div>

            <div class="card p-3 mt-3 flex flex-wrap items-center gap-3">
              <label class="flex items-center gap-2 text-sm text-text-muted">{L.format}
                <select id="ptt-format" class="ptt-input !w-auto">
                  <option value="png">PNG</option>
                  <option value="jpeg">JPG</option>
                  <option value="webp">WebP</option>
                </select>
              </label>
              <label id="ptt-q-wrap" class="flex items-center gap-2 text-sm text-text-muted" hidden>{L.quality}
                <input id="ptt-quality" type="range" min="0.5" max="1" step="0.01" value="0.92" class="ptt-range !w-28" />
              </label>
              <button type="button" id="ptt-download" class="btn ml-auto justify-center max-sm:w-full">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0 4-4m-4 4-4-4M5 20h14"/></svg>{L.download}
              </button>
            </div>
            <p id="ptt-msg2" class="text-sm mt-2" style="color:#ff6b6b" role="alert" hidden></p>
          </div>

          <!-- Controls side -->
          <div class="card p-3 lg:sticky lg:top-[calc(var(--header-h)+12px)]">
            <div class="ptt-tabs" role="tablist">
              <button type="button" role="tab" class="ptt-tab" data-tab="text" aria-selected="true">{L.tabText}</button>
              <button type="button" role="tab" class="ptt-tab" data-tab="font" aria-selected="false">{L.tabFont}</button>
              <button type="button" role="tab" class="ptt-tab" data-tab="effects" aria-selected="false">{L.tabEffects}</button>
              <button type="button" role="tab" class="ptt-tab" data-tab="presets" aria-selected="false">{L.tabPresets}</button>
            </div>

            <p id="ptt-empty" class="text-text-muted text-sm mt-3" hidden>{L.emptyHint}</p>

            <fieldset id="ptt-controls" class="mt-3 border-0 p-0 m-0 min-w-0" disabled>
              <!-- TEXT -->
              <div data-pane="text" class="flex flex-col gap-3">
                <textarea id="ptt-text" data-prop="text" rows="3" class="ptt-input" placeholder={L.yourText}></textarea>
                <label class="ptt-row"><span>{L.size}</span><input type="range" data-prop="size" min="0.02" max="0.4" step="0.002" class="ptt-range" /></label>
                <div>
                  <div class="ptt-label mb-1.5">{L.color}</div>
                  <div class="flex flex-wrap items-center gap-1.5">
                    <input type="color" data-prop="color" class="ptt-color" aria-label={L.color} />
                    {swatches.map((c) => <button type="button" class="ptt-swatch" data-swatch={c} style={`background:${c}`} aria-label={c}></button>)}
                  </div>
                </div>
                <div class="flex flex-wrap gap-1.5">
                  <button type="button" class="ptt-icon ptt-tog" data-prop="bold" data-toggle aria-label={L.bold} title={L.bold} aria-pressed="false"><b>B</b></button>
                  <button type="button" class="ptt-icon ptt-tog" data-prop="italic" data-toggle aria-label={L.italic} title={L.italic} aria-pressed="false"><i style="font-family:serif">I</i></button>
                  <span class="w-px h-6 bg-border mx-1 self-center" aria-hidden="true"></span>
                  {aligns.map((a) => (
                    <button type="button" class="ptt-icon ptt-tog" data-prop="align" data-value={a.v} aria-label={a.label} title={a.label} aria-pressed="false">
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d={a.d}/></svg>
                    </button>
                  ))}
                </div>
              </div>

              <!-- FONT -->
              <div data-pane="font" hidden>
                <input id="ptt-font-search" type="search" class="ptt-input mb-2" placeholder={L.searchFont} aria-label={L.searchFont} />
                <div class="flex flex-wrap gap-1.5 mb-2" id="ptt-cats">
                  <button type="button" class="ptt-chip" data-cat="all" aria-pressed="true">{L.all}</button>
                  <button type="button" class="ptt-chip" data-cat="sans" aria-pressed="false">{L.catSans}</button>
                  <button type="button" class="ptt-chip" data-cat="serif" aria-pressed="false">{L.catSerif}</button>
                  <button type="button" class="ptt-chip" data-cat="display" aria-pressed="false">{L.catDisplay}</button>
                  <button type="button" class="ptt-chip" data-cat="script" aria-pressed="false">{L.catScript}</button>
                  <button type="button" class="ptt-chip" data-cat="mono" aria-pressed="false">{L.catMono}</button>
                </div>
                <div id="ptt-font-list" class="ptt-fontlist" role="listbox" aria-label={L.tabFont}></div>
              </div>

              <!-- EFFECTS -->
              <div data-pane="effects" class="flex flex-col gap-3" hidden>
                <label class="ptt-row"><span>{L.opacity}</span><input type="range" data-prop="opacity" min="0.1" max="1" step="0.01" class="ptt-range" /></label>
                <label class="ptt-row"><span>{L.rotation}</span><input type="range" data-prop="rot" min="-180" max="180" step="1" class="ptt-range" /></label>
                <label class="ptt-row"><span>{L.letterSpacing}</span><input type="range" data-prop="ls" min="-0.05" max="0.5" step="0.005" class="ptt-range" /></label>
                <label class="ptt-row"><span>{L.lineHeight}</span><input type="range" data-prop="lh" min="0.8" max="2.2" step="0.05" class="ptt-range" /></label>

                <div class="ptt-group">
                  <label class="ptt-check"><input type="checkbox" data-prop="stroke.on" /> {L.outline}</label>
                  <label class="ptt-row"><span>{L.outlineWidth}</span><input type="range" data-prop="stroke.w" min="0.01" max="0.3" step="0.005" class="ptt-range" /></label>
                  <div class="ptt-row"><span>{L.color}</span><input type="color" data-prop="stroke.color" class="ptt-color" aria-label={`${L.outline} ${L.color}`} /></div>
                </div>
                <div class="ptt-group">
                  <label class="ptt-check"><input type="checkbox" data-prop="shadow.on" /> {L.shadow}</label>
                  <label class="ptt-row"><span>{L.shadowBlur}</span><input type="range" data-prop="shadow.blur" min="0" max="0.6" step="0.005" class="ptt-range" /></label>
                  <div class="ptt-row"><span>{L.color}</span><input type="color" data-prop="shadow.color" class="ptt-color" aria-label={`${L.shadow} ${L.color}`} /></div>
                </div>
                <div class="ptt-group">
                  <label class="ptt-check"><input type="checkbox" data-prop="bg.on" /> {L.background}</label>
                  <label class="ptt-row"><span>{L.bgOpacity}</span><input type="range" data-prop="bg.opacity" min="0.05" max="1" step="0.01" class="ptt-range" /></label>
                  <label class="ptt-row"><span>{L.bgPadding}</span><input type="range" data-prop="bg.pad" min="0" max="0.8" step="0.01" class="ptt-range" /></label>
                  <div class="ptt-row"><span>{L.color}</span><input type="color" data-prop="bg.color" class="ptt-color" aria-label={`${L.background} ${L.color}`} /></div>
                </div>
                <div class="flex gap-2">
                  <button type="button" id="ptt-front" class="ptt-ghost flex-1 justify-center">{L.front}</button>
                  <button type="button" id="ptt-back" class="ptt-ghost flex-1 justify-center">{L.back}</button>
                </div>
              </div>
            </fieldset>

            <!-- PRESETS (always usable: creates a text if none is selected) -->
            <div data-pane="presets" class="grid grid-cols-2 gap-2 mt-3" hidden>
              {presetList.map((p) => <button type="button" class="ptt-ghost justify-center py-3" data-preset={p.key}>{p.label}</button>)}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .ptt-drop { border-style: dashed; border-width: 2px; cursor: pointer; transition: border-color .15s, background-color .15s; }
  .ptt-drop:hover, .ptt-drop:focus-visible, .ptt-drop.is-over { border-color: var(--color-primary); background: color-mix(in srgb, var(--color-primary) 8%, var(--color-surface)); outline: none; }
  .ptt-sample { width: 74px; height: 50px; border-radius: .6rem; border: 2px solid var(--color-border); cursor: pointer; transition: transform .15s, border-color .15s; }
  .ptt-sample:hover, .ptt-sample:focus-visible { transform: translateY(-2px); border-color: var(--color-primary); outline: none; }

  .ptt-stage { background-color: var(--color-surface-2); background-image: linear-gradient(45deg, rgba(128,128,128,.12) 25%, transparent 25%, transparent 75%, rgba(128,128,128,.12) 75%), linear-gradient(45deg, rgba(128,128,128,.12) 25%, transparent 25%, transparent 75%, rgba(128,128,128,.12) 75%); background-size: 20px 20px; background-position: 0 0, 10px 10px; min-height: 240px; }
  .ptt-stage.is-over { outline: 2px dashed var(--color-primary); outline-offset: -6px; }
  #ptt-canvas { display: block; max-width: 100%; max-height: 68vh; width: auto; height: auto; touch-action: none; border-radius: 4px; box-shadow: 0 2px 14px rgba(0,0,0,.35); user-select: none; -webkit-user-select: none; }

  .ptt-icon, .ptt-ghost { display: inline-flex; align-items: center; gap: .4rem; background: var(--color-surface-2); color: var(--color-text); border: 1px solid var(--color-border); border-radius: var(--radius-md); cursor: pointer; font-size: .85rem; font-weight: 600; transition: border-color .15s, color .15s, background-color .15s; }
  .ptt-icon { justify-content: center; width: 2.25rem; height: 2.25rem; }
  .ptt-ghost { padding: .5rem .8rem; }
  .ptt-icon:hover:not(:disabled), .ptt-ghost:hover:not(:disabled) { border-color: var(--color-primary); color: var(--color-primary); }
  .ptt-icon:focus-visible, .ptt-ghost:focus-visible, .ptt-chip:focus-visible, .ptt-tab:focus-visible, .ptt-swatch:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .ptt-icon:disabled, .ptt-ghost:disabled { opacity: .45; cursor: not-allowed; }
  .ptt-tog[aria-pressed="true"] { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }

  .ptt-tabs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px; background: var(--color-surface-2); padding: 3px; border-radius: var(--radius-md); }
  .ptt-tab { padding: .45rem .2rem; font-size: .8rem; font-weight: 600; color: var(--color-text-muted); background: transparent; border: 0; border-radius: 6px; cursor: pointer; }
  .ptt-tab[aria-selected="true"] { background: var(--color-surface); color: var(--color-text); box-shadow: 0 1px 3px rgba(0,0,0,.3); }

  .ptt-input { width: 100%; background: var(--color-surface-2); border: 1px solid var(--color-border); border-radius: var(--radius-md); color: var(--color-text); font: inherit; font-size: .9rem; padding: .5rem .65rem; }
  .ptt-input:focus { outline: 2px solid var(--color-primary); outline-offset: 0; border-color: transparent; }
  textarea.ptt-input { resize: vertical; min-height: 4.2rem; }

  .ptt-label, .ptt-row > span { font-size: .78rem; font-weight: 600; color: var(--color-text-muted); }
  .ptt-row { display: grid; grid-template-columns: 7.5rem 1fr; align-items: center; gap: .6rem; }
  .ptt-range { width: 100%; accent-color: var(--color-primary); height: 1.4rem; cursor: pointer; }
  .ptt-color { width: 2.1rem; height: 2.1rem; padding: 0; border: 1px solid var(--color-border); border-radius: 6px; background: none; cursor: pointer; }
  .ptt-swatch { width: 1.6rem; height: 1.6rem; border-radius: 50%; border: 2px solid var(--color-border); cursor: pointer; padding: 0; }
  .ptt-swatch:hover { transform: scale(1.12); border-color: var(--color-text); }
  .ptt-group { display: flex; flex-direction: column; gap: .6rem; padding: .7rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: color-mix(in srgb, var(--color-surface-2) 55%, transparent); }
  .ptt-check { display: flex; align-items: center; gap: .5rem; font-weight: 600; font-size: .88rem; cursor: pointer; }
  .ptt-check input { accent-color: var(--color-primary); width: 1rem; height: 1rem; }

  .ptt-chip { font-size: .75rem; font-weight: 600; padding: .25rem .65rem; border-radius: 999px; border: 1px solid var(--color-border); background: var(--color-surface-2); color: var(--color-text-muted); cursor: pointer; }
  .ptt-chip[aria-pressed="true"] { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }
  .ptt-fontlist { max-height: 300px; overflow-y: auto; display: flex; flex-direction: column; gap: 4px; padding-right: 2px; }
  .ptt-fontitem { text-align: left; background: var(--color-surface-2); color: var(--color-text); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: .5rem .75rem; font-size: 1.15rem; line-height: 1.3; cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ptt-fontitem:hover { border-color: var(--color-primary); }
  .ptt-fontitem[aria-selected="true"] { border-color: var(--color-primary); background: color-mix(in srgb, var(--color-primary) 14%, var(--color-surface-2)); }
  .ptt-fontitem small { display: block; font: 500 .68rem var(--font-sans); color: var(--color-text-muted); }
  #ptt-controls:disabled { opacity: .45; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (max-width: 420px) { .ptt-row { grid-template-columns: 6rem 1fr; } }
</style>

<script>
  import { TOOL_FONTS } from '../lib/toolFonts';
  import type { ToolFont } from '../lib/toolFonts';

  // ---------- types & state ----------
  interface Layer {
    id: number; text: string; font: string; size: number; x: number; y: number; rot: number;
    color: string; bold: boolean; italic: boolean; align: 'left' | 'center' | 'right';
    ls: number; lh: number; opacity: number;
    stroke: { on: boolean; w: number; color: string };
