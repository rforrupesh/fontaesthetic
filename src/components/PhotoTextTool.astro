  function local(l: Layer, p: { x: number; y: number }) {
    const a = (l.rot * Math.PI) / 180, dx = p.x - l.x * canvas.width, dy = p.y - l.y * canvas.height;
    return { x: dx * Math.cos(a) + dy * Math.sin(a), y: -dx * Math.sin(a) + dy * Math.cos(a) };
  }
  function hitHandle(l: Layer, p: { x: number; y: number; k: number }): 'resize' | 'rotate' | null {
    const b = boxes.get(l.id); if (!b) return null;
    const q = local(l, p), m = 6 * p.k, r = 16 * p.k;
    const hw = b.w / 2 + m, hh = b.h / 2 + m;
    if (Math.hypot(q.x, q.y - (hh + 34 * p.k)) < r) return 'rotate';
    for (const sx of [-1, 1]) for (const sy of [-1, 1]) if (Math.hypot(q.x - sx * hw, q.y - sy * hh) < r) return 'resize';
    for (const sx of [-1, 1]) if (Math.abs(q.x - sx * hw) < 8 * p.k && Math.abs(q.y) < 14 * p.k) return 'resize';
    for (const sy of [-1, 1]) if (Math.abs(q.y - sy * hh) < 8 * p.k && Math.abs(q.x) < 14 * p.k) return 'resize';
    return null;
  }
  function hitLayer(p: { x: number; y: number; k: number }): Layer | null {
    for (let i = layers.length - 1; i >= 0; i--) {
      const l = layers[i], b = boxes.get(l.id); if (!b) continue;
      const q = local(l, p), m = 8 * p.k;
      if (Math.abs(q.x) <= b.w / 2 + m && Math.abs(q.y) <= b.h / 2 + m) return l;
    }
    return null;
  }
  canvas.addEventListener('pointerdown', (e) => {
    if (e.button > 0) return;
    const p = pt(e); const cur = sel();
    let d: Drag | null = null;
    if (cur) {
      const h = hitHandle(cur, p);
      if (h) d = { kind: h, id: cur.id, dx: 0, dy: 0, d0: Math.hypot(p.x - cur.x * canvas.width, p.y - cur.y * canvas.height) || 1, size0: cur.size };
    }
    if (!d) {
      const hit = hitLayer(p);
      if (hit) { selectedId = hit.id; d = { kind: 'move', id: hit.id, dx: p.x - hit.x * canvas.width, dy: p.y - hit.y * canvas.height, d0: 1, size0: hit.size }; syncControls(); }
      else if (selectedId !== null) { selectedId = null; syncControls(); }
    }
    drag = d; if (d) canvas.setPointerCapture(e.pointerId);
    render();
  });
  canvas.addEventListener('pointermove', (e) => {
    const p = pt(e);
    if (!drag) {
      const cur = sel(); const h = cur ? hitHandle(cur, p) : null;
      canvas.style.cursor = h === 'rotate' ? 'grab' : h === 'resize' ? 'nwse-resize' : hitLayer(p) ? 'move' : 'default';
      return;
    }
    const l = layers.find((x) => x.id === drag!.id); if (!l) return;
    if (drag.kind === 'move') { l.x = clamp((p.x - drag.dx) / canvas.width, 0, 1); l.y = clamp((p.y - drag.dy) / canvas.height, 0, 1); }
    else if (drag.kind === 'resize') { l.size = clamp(drag.size0 * (Math.hypot(p.x - l.x * canvas.width, p.y - l.y * canvas.height) / drag.d0), 0.01, 0.6); }
    else {
      let a = (Math.atan2(p.y - l.y * canvas.height, p.x - l.x * canvas.width) * 180) / Math.PI - 90;
      a = ((a + 540) % 360) - 180;
      const snapTo = Math.round(a / 45) * 45; if (Math.abs(a - snapTo) < 3) a = snapTo;
      l.rot = Math.round(a * 10) / 10;
    }
    syncControls(); render();
  });
  const endDrag = () => { if (drag) { drag = null; commit(); } };
  canvas.addEventListener('pointerup', endDrag);
  canvas.addEventListener('pointercancel', endDrag);
  canvas.addEventListener('dblclick', () => { if (sel()) { showTab('text'); $<HTMLTextAreaElement>('ptt-text').focus(); } });

  // ---------- keyboard ----------
  document.addEventListener('keydown', (e) => {
    if (editorEl.hidden) return;
    const t = e.target as HTMLElement;
    if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.isContentEditable)) return;
    const mod = e.ctrlKey || e.metaKey;
    if (mod && e.key.toLowerCase() === 'z') { e.preventDefault(); restore(e.shiftKey ? histIdx + 1 : histIdx - 1); return; }
    if (mod && e.key.toLowerCase() === 'y') { e.preventDefault(); restore(histIdx + 1); return; }
    if (mod && e.key.toLowerCase() === 'd') { e.preventDefault(); duplicate(); return; }
    const l = sel(); if (!l) return;
    if (e.key === 'Delete' || e.key === 'Backspace') { e.preventDefault(); remove(); return; }
    const step = e.shiftKey ? 0.02 : 0.004;
    const mv: Record<string, [number, number]> = { ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, -step], ArrowDown: [0, step] };
    if (mv[e.key]) { e.preventDefault(); l.x = clamp(l.x + mv[e.key][0], 0, 1); l.y = clamp(l.y + mv[e.key][1], 0, 1); render(); commitSoon(); }
    if (e.key === 'Escape') { selectedId = null; syncControls(); render(); }
  });

  // ---------- upload inputs ----------
  $('ptt-choose').addEventListener('click', (e) => { e.stopPropagation(); fileEl.click(); });
  dropEl.addEventListener('click', () => fileEl.click());
  dropEl.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileEl.click(); } });
  fileEl.addEventListener('change', () => { loadFile(fileEl.files?.[0]); fileEl.value = ''; });
  const over = (el: HTMLElement, on: boolean) => el.classList.toggle('is-over', on);
  for (const el of [dropEl, stageEl]) {
    el.addEventListener('dragover', (e) => { e.preventDefault(); over(el, true); });
    el.addEventListener('dragleave', () => over(el, false));
    el.addEventListener('drop', (e) => { e.preventDefault(); over(el, false); loadFile((e as DragEvent).dataTransfer?.files?.[0]); });
  }
  document.addEventListener('paste', (e) => {
    const f = [...(e.clipboardData?.files || [])].find((x) => x.type.startsWith('image/'));
    if (f) { e.preventDefault(); loadFile(f); }
  });
  document.querySelectorAll<HTMLButtonElement>('[data-sample]').forEach((b) => b.addEventListener('click', () => makeSample(b.dataset.sample!)));

  // ---------- export ----------
  const fmtEl = $<HTMLSelectElement>('ptt-format'), qWrap = $('ptt-q-wrap'), qEl = $<HTMLInputElement>('ptt-quality');
  fmtEl.addEventListener('change', () => { qWrap.hidden = fmtEl.value === 'png'; });
  $('ptt-download').addEventListener('click', async () => {
    if (!src) return;
    msg2.hidden = true;
    const btn = $('ptt-download') as HTMLButtonElement; btn.disabled = true;
    try {
      await Promise.all(layers.map((l) => ensureFont(l.font)));
      await document.fonts.ready;
      let k = 1; const area = src.w * src.h, side = Math.max(src.w, src.h);
      if (area > 16_000_000) k = Math.sqrt(16_000_000 / area);
      if (side * k > 8192) k = 8192 / side;
      const W = Math.round(src.w * k), H = Math.round(src.h * k);
      const c = document.createElement('canvas'); c.width = W; c.height = H;
      const g = c.getContext('2d')!; g.imageSmoothingQuality = 'high';
      const type = fmtEl.value; const mime = `image/${type}`;
      if (type === 'jpeg') { g.fillStyle = '#ffffff'; g.fillRect(0, 0, W, H); }
      drawScene(g, W, H, src.source, false);
      const blob: Blob | null = await new Promise((res) => c.toBlob(res, mime, parseFloat(qEl.value)));
      if (!blob) throw new Error('export');
      const a = document.createElement('a'); a.href = URL.createObjectURL(blob);
      a.download = `text-on-photo.${type === 'jpeg' ? 'jpg' : type}`;
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(a.href), 4000);
    } catch {
      msg2.textContent = root.dataset.errExport || ''; msg2.hidden = false;
    } finally { btn.disabled = false; }
  });

  // keep the selection handles crisp when the layout (and so the canvas CSS size) changes
  window.addEventListener('resize', render);
</script>
