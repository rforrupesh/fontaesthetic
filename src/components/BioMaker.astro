const ALL=(()=>{
 const seen=new Set(),out=[];
 const add=(m,t,f,n)=>{if(seen.has(t))return;seen.add(t);out.push({m,t,f,n})};
 STYLES.forEach(([n,t,f])=>add("styles",t,f,n));
 TEMPLATES.forEach(([m,t])=>add(m,t));
 MORE.split("\n").forEach(l=>l.trim()&&add("aesthetic",l.replace(/name/g,"{text}")));
 return out;
})();
const PAGE=24;let shown=PAGE;
// bios the user styled by hand (template -> text); the font filter must not overwrite these
const edits=new Map();

function fontChar(s,c){
 const [up,low,ex={}]=MAPS[s];
 return String.fromCodePoint(ex[c]||(c<"a"?up+c.charCodeAt(0)-65:low+c.charCodeAt(0)-97));
}
function convert(t,s){
 if(s==="normal")return t;
 if(s==="curvy")return t.replace(/[a-z]/gi,c=>CURVY[c.toLowerCase().charCodeAt(0)-97]);
 if(s==="small")return t.replace(/[a-z]/gi,c=>SMALL[c.toLowerCase().charCodeAt(0)-97]);
 return t.replace(/[a-zA-Z]/g,c=>fontChar(s,c));
}
function chips(box,items,value,pick,cls=""){
 box.replaceChildren();
 items.forEach(([k,label,name])=>{
  const b=document.createElement("button");
  b.type="button";b.className="bm-chip "+cls+(box.id==="bm-fonts"&&(k==="double"||k==="full")?" bm-wide":"");b.textContent=label;
  if(name)b.setAttribute("aria-label",name);
  b.setAttribute("aria-pressed",String(k===value));
  b.onclick=()=>{pick(k);box.querySelectorAll(".bm-chip").forEach(c=>c.setAttribute("aria-pressed",String(c===b)));results()};
  box.append(b);
 });
}
function filters(){
 chips($("fonts"),FONTS.map(([k,n])=>[k,convert(n,k),n]),st.font,k=>st.font=k,"bm-l bm-ck");
 chips($("moods"),MOODS,st.mood,k=>st.mood=k,"bm-ck");
}
function results(keep){
 if(!keep)shown=PAGE;
 hideTip();
 const text=txt.value.trim(),list=$("list");
 list.replaceChildren();
 $("empty").hidden=!!text;$("rh").hidden=!text;$("num").textContent="";$("done").textContent=I.done;$("more").hidden=true;
 const sum=[FONTS.find(f=>f[0]===st.font)[1],st.mood!=="all"&&MOODS.find(m=>m[0]===st.mood)[1]].filter(Boolean);
 $("fsum").textContent=sum.join(", ");
 if(!text)return;
 const rows=ALL.filter(r=>st.mood==="all"||r.m===st.mood);
 $("num").textContent=fmt(I.numBios,rows.length);
 $("done").textContent=fmt(I.showBios,rows.length);
 rows.slice(0,shown).forEach(r=>{
  const bio=edits.has(r.t)?edits.get(r.t):r.t.replace(/\{text\}/g,()=>convert(text,r.f||st.font)).trimEnd();
  const li=document.createElement("li"),box=document.createElement("div"),p=document.createElement("p"),b=document.createElement("button");
  box.className="bm-txt";
  if(r.n){const n=document.createElement("p");n.className="bm-nm";n.textContent=r.n;box.append(n)}
  p.className="bm-bio";p.textContent=bio;box.append(p);
  if(Array.from(bio).length>150){const w=document.createElement("p");w.className="bm-warn";w.textContent=I.tooLong;box.append(w)}
  b.type="button";b.className="btn bm-copy";b.textContent=I.copy;
  b.setAttribute("aria-label",I.copyAria+" "+bio);
  b.onclick=()=>copy(p.textContent,b);
  li.className="card bm-row";li.dataset.k=r.t;
  li.append(box,b);list.append(li);
 });
 const left=rows.length-shown;
 $("more").hidden=left<=0;
 $("more").textContent=fmt(I.showMore,Math.min(PAGE,left));
}
async function copy(t,b){
 try{await navigator.clipboard.writeText(t)}catch{
  const x=document.createElement("textarea");x.value=t;document.body.append(x);x.select();document.execCommand("copy");x.remove();
 }
 document.querySelectorAll(".bm-copy.bm-done").forEach(d=>{d.textContent=I.copy;d.classList.remove("bm-done")});
 b.textContent=I.copied;b.classList.add("bm-done");$("live").textContent=I.copiedLive;
 setTimeout(()=>{b.textContent=I.copy;b.classList.remove("bm-done")},1800);
}

// Filter sheet open/close (mobile)
function setOpen(o){
 $("fl").classList.toggle("is-open",o);
 $("ftoggle").setAttribute("aria-expanded",o);
 document.documentElement.style.overflow=o?"hidden":"";
}
txt.addEventListener("input",()=>{edits.clear();results()});
$("more").onclick=()=>{shown+=PAGE;results(true)};
$("ftoggle").onclick=()=>setOpen(!$("fl").classList.contains("is-open"));
$("done").onclick=()=>{setOpen(false);$("rh").scrollIntoView({block:"start"})};
$("scrim").onclick=()=>setOpen(false);
addEventListener("keydown",e=>{if(e.key==="Escape")setOpen(false)});
matchMedia("(min-width:861px)").addEventListener("change",e=>{if(e.matches)setOpen(false)});
$("reset").onclick=()=>{st.font=DEFAULT_FONT;st.mood="all";filters();results()};
// ---- Selection tooltip: style selected words inside a bio ----
const REV={};
(()=>{
 for(const k in MAPS)for(const c of "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz")REV[fontChar(k,c)]=c;
 Array.from(CURVY).forEach((ch,i)=>{if(ch.charCodeAt(0)>127)REV[ch]=String.fromCharCode(65+i)});
 Array.from(SMALL).forEach((ch,i)=>{if(ch.charCodeAt(0)>127)REV[ch]=String.fromCharCode(97+i)});
})();
const MARKS=/[\u0332\u0336]/g;
const plain=t=>Array.from(t).map(ch=>REV[ch]||ch).join("");
function mark(t,m){
 if(t.includes(m))return t.split(m).join("");
 return Array.from(t).map(ch=>/\s/.test(ch)||ch===m?ch:ch+m).join("");
}
function restyle(k,t){
 if(k==="normal")return plain(t).replace(MARKS,"");
 if(k==="underline")return mark(t,"\u0332");
 if(k==="strike")return mark(t,"\u0336");
 return convert(plain(t),k);
}
const TIPS=[["bold","Bold"],["italic","Italic"],["bolditalic","Bold italic"],["underline","Underline"],["strike","Strikethrough"],null,
 ["script","Cursive"],["gothic","Gothic"],["gothicb","Bold gothic"],["double","Double struck"],["sans","Sans serif"],["sansb","Bold sans"],["mono","Monospace"],["bubble","Bubble"],["full","Fullwidth"],["small","Small caps"],["curvy","Curvy"],null,
 ["normal","Normal (remove style)"]];
const tipLabel=k=>k==="underline"?"U\u0332":k==="strike"?"S\u0336":k==="normal"?"Aa":convert("Ab",k);
const tip=document.createElement("div");
tip.className="bm-tip";tip.setAttribute("role","toolbar");tip.setAttribute("aria-label",I.toolbar);
TIPS.forEach(t=>{
 if(!t){const sp=document.createElement("span");sp.className="bm-sep";sp.setAttribute("aria-hidden","true");tip.append(sp);return}
 const b=document.createElement("button");
 b.type="button";b.dataset.k=t[0];b.title=t[1];b.setAttribute("aria-label",t[1]);b.textContent=tipLabel(t[0]);
 tip.append(b);
});
document.body.append(tip);

let cur=null,pressing=false,selTimer=0;
const coarse=matchMedia("(pointer:coarse)");
const bioOf=n=>{const e=n&&(n.nodeType===3?n.parentElement:n);return e&&e.closest?e.closest(".bm-bio"):null};
function placeTip(){
 if(!cur)return;
 const n=cur.p.firstChild;if(!n)return;
 const rg=document.createRange();
 rg.setStart(n,Math.min(cur.start,n.length));rg.setEnd(n,Math.min(cur.end,n.length));
 const r=rg.getBoundingClientRect(),vh=innerHeight,vw=document.documentElement.clientWidth;
 if(r.bottom<0||r.top>vh){tip.classList.remove("show");return}
 tip.style.left="0px";tip.style.top="0px";
 const w=tip.offsetWidth,h=tip.offsetHeight;
 let top=coarse.matches?r.bottom+16:r.top-h-10,pos=coarse.matches?"bottom":"top";
 if(top<8){top=r.bottom+10;pos="bottom"}
 if(top+h>vh-8){top=Math.max(8,r.top-h-10);pos="top"}
 tip.dataset.pos=pos;
 tip.style.top=top+"px";
 const left=Math.max(8,Math.min(r.left+r.width/2-w/2,vw-w-8));
 tip.style.left=left+"px";
 tip.style.setProperty("--ox",Math.max(12,Math.min(w-12,r.left+r.width/2-left))+"px");
 tip.classList.add("show");
}
function hideTip(){cur=null;tip.classList.remove("show")}
function checkSel(){
 if(pressing)return;
 const s=getSelection();
 if(!s||!s.rangeCount||s.isCollapsed)return hideTip();
 const r=s.getRangeAt(0),p=bioOf(r.startContainer);
 if(!p)return hideTip();
 const pre=document.createRange();pre.selectNodeContents(p);pre.setEnd(r.startContainer,r.startOffset);
 const start=pre.toString().length;
 const end=bioOf(r.endContainer)===p?start+r.toString().length:p.textContent.length;
 if(!p.textContent.slice(start,end).trim())return hideTip();
 cur={p,start,end};
 placeTip();
}
function refreshBio(li){
 const p=li.querySelector(".bm-bio"),t=p.textContent;
 li.querySelector(".bm-copy").setAttribute("aria-label",I.copyAria+" "+t);
 let w=li.querySelector(".bm-warn");
 const over=Array.from(t).length>150;
 if(over&&!w){w=document.createElement("p");w.className="bm-warn";w.textContent=I.tooLong;li.querySelector(".bm-txt").append(w)}
 else if(!over&&w)w.remove();
}
function applyStyle(k,name){
 if(!cur)return;
 const {p,start,end}=cur,t=p.textContent;
 const out=restyle(k,t.slice(start,end));
 p.textContent=t.slice(0,start)+out+t.slice(end);
 cur.end=start+out.length;
 const n=p.firstChild,rg=document.createRange();
 rg.setStart(n,start);rg.setEnd(n,cur.end);
 const s=getSelection();s.removeAllRanges();s.addRange(rg);
 const li=p.closest("li");
 edits.set(li.dataset.k,p.textContent);
 refreshBio(li);
 placeTip();
 $("live").textContent=I.applied;
}
tip.addEventListener("mousedown",e=>e.preventDefault());
tip.addEventListener("pointerdown",()=>{pressing=true});
tip.addEventListener("click",e=>{const b=e.target.closest("button");if(!b)return;b.classList.remove("bm-hit");void b.offsetWidth;b.classList.add("bm-hit");applyStyle(b.dataset.k,b.title)});
tip.addEventListener("animationend",e=>e.target.classList.remove("bm-hit"));
["pointerup","pointercancel"].forEach(ev=>document.addEventListener(ev,()=>{
 if(pressing)setTimeout(()=>{pressing=false;checkSel()},350);
}));
document.addEventListener("selectionchange",()=>{clearTimeout(selTimer);selTimer=setTimeout(checkSel,80)});
addEventListener("scroll",()=>{if(cur)placeTip()},{passive:true});
addEventListener("resize",()=>{if(cur)placeTip()});
addEventListener("keydown",e=>{if(e.key==="Escape")hideTip()});

filters();results();

</script>
