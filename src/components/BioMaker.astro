---
// Aesthetic Bio Maker: type a name, get copy-ready bios in Unicode fonts + decorative templates.
// Runs fully in the browser. Styles use the site's theme tokens (--color-*), so light/dark just work.
import { bioText } from '../lib/bioMakerText';
interface Props { lang?: string; }
const { lang = 'en' } = Astro.props;
const T = bioText(lang);
// Only what the script needs (moods + dynamic messages) is passed to the browser.
const i18n = {
  moods: T.moods, showBios: T.showBios, done: T.done, showMore: T.showMore, numBios: T.numBios,
  copy: T.copy, copied: T.copied, copiedLive: T.copiedLive, tooLong: T.tooLong, copyAria: T.copyAria,
  toolbar: T.toolbar, applied: T.applied,
};
---

<section class="bm-root py-8 pb-6" data-i18n={JSON.stringify(i18n)}>
  <div class="wrap">
    <div class="text-center mb-6">
      <h1 class="text-[clamp(1.6rem,3.4vw,2.2rem)] mb-2">{T.h1}</h1>
      <p class="text-text-muted text-sm max-w-[680px] mx-auto">{T.lead}</p>
    </div>

    <div class="bm-app">
      <section class="bm-in card p-3">
        <label for="bm-txt">{T.label}</label>
        <textarea id="bm-txt" rows="2" maxlength="150" dir="auto" placeholder={T.placeholder}>mina, soft little life</textarea>
      </section>

      <aside class="bm-fl" id="bm-fl" aria-label={T.filters}>
        <button class="bm-ftoggle" id="bm-ftoggle" type="button" aria-expanded="false" aria-controls="bm-fbody"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/></svg><b>{T.filters}</b><span class="bm-fsum" id="bm-fsum"></span><span class="bm-chev" aria-hidden="true">▾</span></button>
        <div class="bm-scrim" id="bm-scrim"></div>
        <div class="bm-fbody" id="bm-fbody">
          <div class="bm-fh"><h2>{T.filters}</h2><button class="bm-link" id="bm-reset" type="button">{T.reset}</button></div>
          <div class="bm-grp" role="group" aria-labelledby="bm-g1"><div class="bm-gl" id="bm-g1">{T.font}</div><div class="bm-chips" id="bm-fonts"></div></div>
          <div class="bm-grp" role="group" aria-labelledby="bm-g2"><div class="bm-gl" id="bm-g2">{T.mood}</div><div class="bm-chips" id="bm-moods"></div></div>
          <button class="btn bm-apply" id="bm-done" type="button">{T.done}</button>
        </div>
      </aside>

      <section class="bm-rs" aria-labelledby="bm-rh">
        <div class="bm-rs-head"><h2 id="bm-rh">{T.yourBios}</h2><span id="bm-num"></span></div>
        <p class="bm-empty" id="bm-empty" hidden>{T.empty}</p>
        <ul class="bm-list" id="bm-list"></ul>
        <button class="btn bm-more" id="bm-more" type="button" hidden>{T.showMore.replace("{n}", "")}</button>
      </section>
    </div>
  </div>
  <div class="bm-sr" id="bm-live" aria-live="polite"></div>
</section>

<style is:global>
  .bm-root{--bm-soft:color-mix(in srgb,var(--color-primary) 14%,var(--color-surface));--bm-soft-2:color-mix(in srgb,var(--color-primary) 22%,var(--color-surface));--bm-err:#b3261e;--bm-ok:#14733a;--bm-ok-2:#0f5a2d}
  html[data-theme="dark"] .bm-root{--bm-err:#f2857f;--bm-ok:#1f8f4c;--bm-ok-2:#17703b}
  .bm-root button,.bm-root textarea{touch-action:manipulation}
  .bm-root :focus-visible,.bm-tip :focus-visible{outline:3px solid var(--color-primary);outline-offset:2px}

  .bm-app{display:grid;gap:16px;grid-template-columns:minmax(0,1fr) auto;grid-template-areas:"lb lb" "tx fl" "rs rs";align-items:stretch;gap:10px 10px;max-width:1000px;margin:0 auto;text-align:left}
  .bm-in{display:contents}.bm-in label{grid-area:lb}.bm-in textarea{grid-area:tx}.bm-fl{grid-area:fl}.bm-rs{grid-area:rs;min-width:0}
  .bm-in label{display:block;font-weight:600;font-size:.9rem}
  .bm-in textarea{display:block;width:100%;min-width:0;height:52px;min-height:52px;padding:12px 14px;font-size:18px;line-height:1.5;border:1px solid var(--color-border);border-radius:var(--radius-md);background:var(--color-surface-2);color:var(--color-text);resize:vertical}
  .bm-in textarea:hover{border-color:var(--color-text-muted)}
  .bm-in textarea:focus{border-color:var(--color-primary)}

  /* Filter button (phone / tablet) */
  .bm-fl{display:flex}
  .bm-ftoggle{display:flex;flex-direction:row;align-items:center;justify-content:center;gap:6px;min-height:52px;padding:0 14px;white-space:nowrap;text-align:center;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-md);font-size:13px;cursor:pointer;transition:background .12s,border-color .12s,transform .08s}
  .bm-ftoggle b{font-weight:600}
  .bm-ftoggle:active{background:var(--bm-soft);border-color:var(--color-primary);transform:scale(.97)}
  .bm-fsum,.bm-chev{display:none}

  /* Filter bottom sheet (phone / tablet) */
  .bm-scrim{display:none;position:fixed;inset:0;z-index:90;background:rgba(10,12,16,.55)}
  .bm-fl.is-open .bm-scrim{display:block}
  .bm-fbody{display:none;position:fixed;left:0;right:0;bottom:0;z-index:95;max-height:85vh;max-height:85dvh;overflow-y:auto;overscroll-behavior:contain;padding:28px 16px calc(12px + env(safe-area-inset-bottom));background:var(--color-surface);border:1px solid var(--color-border);border-bottom:0;border-radius:16px 16px 0 0;box-shadow:0 -8px 30px rgba(0,0,0,.3)}
  .bm-fbody::before{content:"";position:absolute;top:10px;left:50%;width:40px;height:4px;margin-left:-20px;border-radius:2px;background:var(--color-border)}
  .bm-fl.is-open .bm-fbody{display:block}
  .bm-apply{display:block;position:sticky;bottom:0;width:100%;justify-content:center;min-height:48px;margin-top:14px;box-shadow:0 0 0 10px var(--color-surface)}
  .bm-fh{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}
  .bm-fh h2{font-size:17px;font-weight:600;margin:0}
  .bm-link{background:none;border:0;color:var(--color-primary);font-weight:600;min-height:40px;padding:0 4px;cursor:pointer;transition:color .12s,opacity .12s}
  .bm-link:active{opacity:.7}
  .bm-grp+.bm-grp{margin-top:16px;padding-top:16px;border-top:1px solid var(--color-border)}
  .bm-gl{font-size:13px;font-weight:600;color:var(--color-text-muted);margin-bottom:10px}
  .bm-chips{display:grid;gap:8px}
  #bm-fonts{grid-template-columns:repeat(2,minmax(0,1fr))}
  #bm-moods{grid-template-columns:repeat(3,minmax(0,1fr))}
  .bm-chip{position:relative;min-height:44px;padding:0 12px;font-size:15px;line-height:1.3;color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-md);cursor:pointer;transition:background .12s,border-color .12s,transform .08s}
  .bm-chip.bm-l{text-align:start;padding-inline-end:28px}
  .bm-chip.bm-wide{grid-column:1/-1}
  .bm-chip:active{background:var(--bm-soft);border-color:var(--color-primary);transform:scale(.97)}
  .bm-chip[aria-pressed=true]{background:var(--bm-soft);border-color:var(--color-primary);box-shadow:inset 0 0 0 1px var(--color-primary);color:var(--color-text);font-weight:600}
  .bm-chip.bm-ck[aria-pressed=true]::after{content:"✓";position:absolute;inset-inline-end:10px;top:50%;transform:translateY(-50%);font-size:13px;font-weight:700;color:var(--color-primary)}

  /* Results */
  .bm-rs-head{display:flex;justify-content:space-between;align-items:baseline;margin:4px 0 10px}
  .bm-rs-head h2{font-size:19px;font-weight:600;margin:0;scroll-margin-top:calc(var(--header-h) + 16px)}
  .bm-rs-head span{font-size:13px;color:var(--color-text-muted)}
  .bm-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px}
  .bm-row{display:flex;align-items:center;gap:12px;padding:12px 14px}
  .bm-txt{flex:1;min-width:0}
  .bm-bio{margin:0;font-size:19px;line-height:1.5;overflow-wrap:anywhere;white-space:pre-wrap;direction:ltr;text-align:start}
  .bm-nm{direction:ltr;text-align:start;margin:0 0 2px;font-size:.72rem;font-weight:500;letter-spacing:.04em;text-transform:uppercase;color:var(--color-text-muted)}
  .bm-warn{margin:2px 0 0;font-size:12px;color:var(--bm-err)}
  .bm-copy{flex:0 0 auto;justify-content:center;min-width:84px;min-height:44px;padding:0 16px}
  .bm-copy:active{transform:scale(.97)}
  .bm-copy.bm-done,.bm-copy.bm-done:hover{background:var(--bm-ok)}
  .bm-more{display:flex;justify-content:center;width:100%;min-height:48px;margin-top:12px;background:var(--color-surface);color:var(--color-primary);border:1px solid var(--color-border)}
  .bm-more:hover{background:var(--bm-soft);border-color:var(--color-primary)}
  .bm-more[hidden]{display:none}
  .bm-empty{padding:28px 16px;text-align:center;color:var(--color-text-muted);background:var(--color-surface);border:1px dashed var(--color-border);border-radius:var(--radius-md);margin:0}
  .bm-empty[hidden],.bm-rs-head[hidden]{display:none}
  .bm-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}

  /* Selection toolbar (style selected words inside a bio) */
  /* Toolbar motion: only transform + opacity (GPU friendly), short ease-out, no overshoot. */
  .bm-tip{position:fixed;left:0;top:0;z-index:100;display:flex;flex-wrap:wrap;gap:4px;width:max-content;max-width:min(380px,calc(100vw - 16px));max-height:calc(100vh - 16px);max-height:calc(100dvh - 16px);overflow-y:auto;overscroll-behavior:contain;padding:6px;background:var(--color-surface);color:var(--color-text);border:1px solid var(--color-border);border-radius:14px;box-shadow:0 14px 34px -10px rgba(0,0,0,.4),0 2px 8px rgba(0,0,0,.12);-webkit-user-select:none;user-select:none;opacity:0;visibility:hidden;pointer-events:none;transform:translateY(8px) scale(.95);transform-origin:var(--ox,50%) 100%;transition:opacity .12s ease-in,transform .12s ease-in,visibility 0s linear .12s}
  .bm-tip[data-pos=bottom]{transform:translateY(-8px) scale(.95);transform-origin:var(--ox,50%) 0}
  .bm-tip.show{opacity:1;visibility:visible;pointer-events:auto;transform:none;transition:opacity .18s ease-out,transform .18s cubic-bezier(.2,.8,.2,1),visibility 0s}
  .bm-tip button{flex:1 0 40px;min-width:40px;min-height:40px;padding:0 6px;border:0;border-radius:9px;background:transparent;color:var(--color-text);font-size:17px;line-height:1;cursor:pointer;touch-action:manipulation;transition:transform .12s ease-out,background-color .12s ease-out,color .12s ease-out}
  @media(hover:hover){.bm-tip button:hover{background:color-mix(in srgb,var(--color-text) 10%,transparent);transform:scale(1.06)}}
  .bm-tip button:active{background:color-mix(in srgb,var(--color-primary) 22%,transparent);color:var(--color-primary);transform:scale(.94)}
  .bm-tip button.bm-hit{animation:bm-hit .22s ease-out both}
  .bm-tip button:focus-visible{outline:2px solid var(--color-primary);outline-offset:-2px}
  .bm-tip .bm-sep{flex:0 0 100%;height:1px;margin:2px 0;background:var(--color-border)}
  @media(pointer:coarse){.bm-tip button{min-height:44px;flex-basis:44px}}
  @media(max-width:420px){.bm-tip{max-width:calc(100vw - 16px);padding:5px}.bm-tip button{flex:1 0 38px;min-width:38px}}

  /* Tablet: centered sheet */
  @media(min-width:560px) and (max-width:860px){
    .bm-fbody{left:50%;right:auto;width:min(560px,100%);transform:translateX(-50%)}
    #bm-moods{grid-template-columns:repeat(4,minmax(0,1fr))}
  }
  @media(hover:hover){
    .bm-ftoggle:hover{border-color:var(--color-text-muted);background:var(--color-surface-2)}
    .bm-link:hover{text-decoration:underline}
    .bm-chip[aria-pressed=false]:hover{border-color:var(--color-text-muted);background:var(--color-surface-2)}
    .bm-chip[aria-pressed=true]:hover{background:var(--bm-soft-2)}
  }
  @media(max-width:420px){
    .bm-row{flex-wrap:wrap}.bm-copy{width:100%}
  }
  @media(max-width:360px){
    .bm-app{gap:8px}.bm-ftoggle{padding:0 10px}
    .bm-bio{font-size:18px}
    #bm-moods{grid-template-columns:repeat(2,minmax(0,1fr))}
  }
  /* Desktop: filters become a sticky sidebar card */
  @media(min-width:861px){
    .bm-app{grid-template-columns:300px minmax(0,1fr);grid-template-rows:auto 1fr;grid-template-areas:"fl in" "fl rs";gap:20px 28px;align-items:start}
    .bm-in{display:block;grid-area:in;min-width:0}
    .bm-in label{margin-bottom:8px}
    .bm-in textarea{height:auto;min-height:84px}
    .bm-fl{display:block;align-self:start;position:sticky;top:calc(var(--header-h) + 12px);max-height:calc(100vh - var(--header-h) - 24px);max-height:calc(100dvh - var(--header-h) - 24px);overflow-y:auto;background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-lg);padding:12px 14px;box-shadow:rgba(50,50,93,.25) 0 2px 5px -1px,rgba(0,0,0,.3) 0 1px 3px -1px}
    .bm-chips{gap:6px}
    .bm-chip{min-height:36px;font-size:14px}
    #bm-fonts .bm-chip.bm-wide{grid-column:auto}
    .bm-grp+.bm-grp{margin-top:12px;padding-top:12px}
    .bm-gl{margin-bottom:8px}
    .bm-ftoggle,.bm-apply,.bm-scrim{display:none!important}
    .bm-fbody{display:block;position:static;max-height:none;overflow:visible;margin:0;padding:0;background:none;border:0;border-radius:0;box-shadow:none}
    .bm-fbody::before{display:none}
    .bm-fh{margin-bottom:10px}
    .bm-rs{min-height:60vh}
  }
  @media(prefers-reduced-motion:no-preference){
    .bm-fl.is-open .bm-fbody{animation:bm-sheet .22s ease-out}
    .bm-fl.is-open .bm-scrim{animation:bm-fade .22s ease-out}
    @media(min-width:560px) and (max-width:860px){.bm-fl.is-open .bm-fbody{animation-name:bm-sheet-c}}
  }
  /* Reduced motion = less movement, not zero feedback: keep a quick fade, drop the scale/slide. */
  @media(prefers-reduced-motion:reduce){
    .bm-tip,.bm-tip[data-pos=bottom]{transform:none;transition:opacity .1s linear,visibility 0s linear .1s}
    .bm-tip.show{transition:opacity .1s linear,visibility 0s}
    .bm-tip button,.bm-tip button:hover,.bm-tip button:active{transform:none}
    .bm-tip button.bm-hit{animation:none}
    .bm-ftoggle:active,.bm-chip:active,.bm-copy:active{transform:none}
  }
  @keyframes bm-sheet{from{transform:translateY(100%)}to{transform:none}}
  @keyframes bm-sheet-c{from{transform:translate(-50%,100%)}to{transform:translateX(-50%)}}
  @keyframes bm-fade{from{opacity:0}to{opacity:1}}
  @keyframes bm-hit{0%{transform:scale(.88)}100%{transform:scale(1)}}
</style>

