---
// Shared body of the Aesthetic Bio Maker page, used by /bio-maker/ and /{lang}/bio-maker/.
import BaseLayout from '../layouts/BaseLayout.astro';
import BioMaker from './BioMaker.astro';
import FaqSection from './FaqSection.astro';
import Breadcrumb from './Breadcrumb.astro';
import BreadcrumbSchema from './schema/BreadcrumbSchema.astro';
import { getPath, t } from '../i18n';
import { bioText } from '../lib/bioMakerText';

interface Props { lang: string; }
const { lang } = Astro.props;
const T = bioText(lang);
const strings = t(lang);

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const pagePath = '/bio-maker/';
const pageUrl = siteUrl + getPath(lang, pagePath);

const crumbs = [
  { name: strings.nav.home, url: siteUrl + getPath(lang, '/') },
  { name: T.nav, url: pageUrl },
];

const faqs = T.faqs.map((f) => ({ question: f.q, answer: f.a }));

const webApp = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: T.nav,
  url: pageUrl,
  inLanguage: lang,
  description: T.description,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any (runs in a web browser)',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: { '@type': 'Organization', name: 'AestheticFonts', url: siteUrl },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
};
---

<BaseLayout lang={lang} title={T.title} description={T.description} path={pagePath}>
  <div class="wrap pt-4"><Breadcrumb items={crumbs} /></div>
  <BioMaker lang={lang} />

  <article class="prose wrap max-w-[820px] mx-auto py-10">
    <h2>{T.howH}</h2>
    <p>{T.howP}</p>
    <h2>{T.boxH}</h2>
    <p>{T.boxP} {T.guideLead} <a href={getPath('en', '/blog/unicode-empty-boxes/')}>{T.guideLink}</a>{T.dot}</p>
    <p>{T.genLead} <a href={getPath(lang, '/')}>{T.genLink}</a>{T.dot}</p>
  </article>

  <FaqSection lang={lang} heading={T.faqH} items={faqs} />

  <script type="application/ld+json" set:html={JSON.stringify(webApp)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <BreadcrumbSchema items={crumbs} />
</BaseLayout>
