---
import { t } from '../i18n';
interface Props { lang: string; }
const { lang } = Astro.props;
const strings = t(lang);
---

<section class="container py-10">
  <h2 class="text-2xl mb-5 text-center">{strings.faq.heading}</h2>
  <div class="max-w-[720px] mx-auto flex flex-col gap-3">
    {strings.faq.items.map((item) => (
      <details class="card px-5 py-4 group">
        <summary class="cursor-pointer list-none flex items-center justify-between gap-4 font-medium text-[.95rem]">
          {item.question}
          <span class="shrink-0 text-text-muted transition-transform duration-200 group-open:rotate-45">+</span>
        </summary>
        <p class="mt-3 text-[.9rem] text-text-muted">{item.answer}</p>
      </details>
    ))}
  </div>
</section>
