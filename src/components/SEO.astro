---
// Emits canonical + hreflang + basic meta. One source of truth for every page.
interface Props {
  title: string;
  description: string;
  lang: 'en' | 'fr' | 'es';
  path: string; // path WITHOUT lang prefix, e.g. "/fancy-text/" or "/blog/my-post/"
}
const { title, description, lang, path } = Astro.props;
const site = 'https://fontaesthetic.in';

const prefixFor = (l: string) => (l === 'en' ? '' : `/${l}`);
const canonical = `${site}${prefixFor(lang)}${path}`;
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="en" href={`${site}${path}`} />
<link rel="alternate" hreflang="fr" href={`${site}/fr${path}`} />
<link rel="alternate" hreflang="es" href={`${site}/es${path}`} />
<link rel="alternate" hreflang="x-default" href={`${site}${path}`} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
