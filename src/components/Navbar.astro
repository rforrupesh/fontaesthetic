---
import { t, getPath } from '../i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props { lang: string; alternates?: Record<string, string>; availableLangs?: string[]; }
const { lang, alternates, availableLangs } = Astro.props;
const strings = t(lang);

const navItems = [
  { href: getPath(lang, '/'), label: strings.nav.home },
  { href: getPath(lang, '/blog/'), label: strings.nav.blog },
  { href: getPath(lang, '/about/'), label: strings.nav.about },
  { href: getPath(lang, '/contact/'), label: strings.nav.contact },
];
---

<header class="site-header sticky top-0 z-50 h-[var(--header-h)] flex items-center bg-surface/90 backdrop-blur-sm border-b border-border">
  <div class="wrap grid grid-cols-[1fr_auto_1fr] md:flex items-center md:justify-between gap-3 md:gap-4">
    <!-- Mobile: hamburger (left) -->
    <button
      id="menu-toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="menu-toggle md:hidden justify-self-start inline-flex flex-col justify-center items-center gap-[5px] w-9 h-9 shrink-0 rounded-md bg-surface-2 border border-border"
    >
      <span class="menu-bar block w-[18px] h-0.5 rounded-full bg-text"></span>
      <span class="menu-bar block w-[18px] h-0.5 rounded-full bg-text"></span>
      <span class="menu-bar block w-[18px] h-0.5 rounded-full bg-text"></span>
    </button>

    <div class="flex items-center gap-6 justify-self-center min-w-0">
      <a href={getPath(lang, '/')} class="logo-link flex items-center h-8 md:h-10 shrink-0" aria-label={strings.site.name}>
        <img
          src={`${import.meta.env.BASE_URL}logo.svg`}
          alt={strings.site.name}
          width="320"
          height="60"
          decoding="async"
          class="h-full w-auto max-w-[130px] md:max-w-[160px] object-contain"
        />
      </a>

      <!-- Desktop: single-row menu -->
      <nav class="hidden md:flex gap-1 lg:gap-2 relative" id="desktop-nav">
        {navItems.map((item) => (
          <a href={item.href} class="nav-link relative z-10 px-3 text-base lg:text-lg font-medium text-text-muted py-1.5">
            {item.label}
          </a>
        ))}
        <span id="nav-underline" aria-hidden="true"></span>
      </nav>
    </div>

    <div class="justify-self-end shrink-0">
      <!-- Mobile: language + theme (right) -->
      <div class="md:hidden flex items-center gap-2">
        <LanguageSwitcher lang={lang} alternates={alternates} availableLangs={availableLangs} compact />
        <ThemeToggle lang={lang} />
      </div>
      <!-- Desktop -->
      <div class="hidden md:flex items-center gap-2.5">
        <ThemeToggle lang={lang} />
        <LanguageSwitcher lang={lang} alternates={alternates} availableLangs={availableLangs} />
      </div>
    </div>
  </div>

  <!-- Mobile menu panel (animated open/close) -->
  <div id="mobile-menu" class="mobile-panel md:hidden absolute top-[var(--header-h)] left-0 w-full bg-surface">
    <div class="mobile-panel-inner">
      <nav class="wrap flex flex-col py-2" aria-label="Mobile">
        {navItems.map((item, i) => (
          <a href={item.href} style={`--i:${i}`} class="mobile-link py-3.5 text-base font-medium text-text-muted border-b border-border last:border-b-0">
            <span class="mobile-label">{item.label}</span>
          </a>
        ))}
      </nav>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  // Header: soft shadow once the page is scrolled
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Mobile menu
  const setMenu = (open: boolean) => {
    menu?.classList.toggle('is-open', open);
    toggle?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    if (open) menu?.removeAttribute('inert'); else menu?.setAttribute('inert', '');
  };
  menu?.setAttribute('inert', '');
  toggle?.addEventListener('click', () => setMenu(!menu?.classList.contains('is-open')));
  // Touch screens have no real hover: play the jelly underline on press, then navigate
  menu?.querySelectorAll<HTMLAnchorElement>('a.mobile-link').forEach((link) => {
    link.addEventListener('pointerdown', () => link.classList.add('is-pressed'));
    ['pointerup', 'pointercancel', 'pointerleave'].forEach((ev) =>
      link.addEventListener(ev, () => setTimeout(() => link.classList.remove('is-pressed'), 700)));
    link.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      e.preventDefault();
      link.classList.add('is-pressed');
      setTimeout(() => { location.href = link.href; }, 380);
    });
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });
  document.addEventListener('click', (e) => {
    if (menu?.classList.contains('is-open') && !header?.contains(e.target as Node)) setMenu(false);
  });
  window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => { if (e.matches) setMenu(false); });

  // Desktop nav: jelly underline — appears only while hovering / keyboard-focusing a link
  const nav = document.getElementById('desktop-nav');
  const line = document.getElementById('nav-underline');
  const links = nav ? [...nav.querySelectorAll<HTMLAnchorElement>('.nav-link')] : [];
  const norm = (p: string) => p.replace(/\/$/, '') || '/';
  const path = norm(location.pathname);
  const active =
    links.find((a) => norm(new URL(a.href).pathname) === path) ??
    links.find((a) => { const lp = norm(new URL(a.href).pathname); return lp !== '/' && path.startsWith(lp); });
  document.querySelectorAll<HTMLAnchorElement>('#mobile-menu a.mobile-link').forEach((a) => {
    const lp = norm(new URL(a.href).pathname);
    if (lp === path || (lp !== '/' && path.startsWith(lp))) { a.classList.add('is-active'); a.setAttribute('aria-current', 'page'); }
  });
  active?.classList.add('is-active');
  active?.setAttribute('aria-current', 'page');

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const SPRING = 'cubic-bezier(0.34, 1.75, 0.5, 1)'; // overshoots, then settles = jelly
  let visible = false;
  let curL = 0;
  let curR = 0;

  // squash & stretch: the bar thins while travelling, then wobbles back
  const wobble = () => {
    if (reduce.matches || !line) return;
    line.animate(
      [
        { transform: 'scaleY(1)' },
        { transform: 'scaleY(0.45)', offset: 0.3 },
        { transform: 'scaleY(1.45)', offset: 0.6 },
        { transform: 'scaleY(0.9)', offset: 0.8 },
        { transform: 'scaleY(1)' },
      ],
      { duration: 560, easing: 'ease-out' },
    );
  };

  const show = (el: HTMLElement) => {
    if (!line || !nav) return;
    const pad = parseFloat(getComputedStyle(el).paddingLeft) || 0;
    const L = el.offsetLeft + pad;
    const R = nav.offsetWidth - el.offsetLeft - el.offsetWidth + pad;

    if (reduce.matches) {
      line.style.transition = 'none';
      line.style.left = L + 'px';
      line.style.right = R + 'px';
      line.style.opacity = '1';
    } else if (!visible) {
      // pops out of the centre of the link and springs to full width
      const mid = (L + (nav.offsetWidth - R)) / 2;
      line.style.transition = 'none';
      line.style.left = mid + 'px';
      line.style.right = nav.offsetWidth - mid + 'px';
      line.style.opacity = '1';
      void line.offsetWidth;
      line.style.transition = `left 0.55s ${SPRING}, right 0.55s ${SPRING}, opacity 0.15s`;
      line.style.left = L + 'px';
      line.style.right = R + 'px';
      wobble();
    } else {
      // leading edge shoots ahead, trailing edge lags behind (stretch), both overshoot
      const goingRight = L > curL;
      const lead = `0.32s ${SPRING}`;
      const trail = `0.6s ${SPRING} 0.06s`;
      line.style.transition = (goingRight ? `right ${lead}, left ${trail}` : `left ${lead}, right ${trail}`) + ', opacity 0.15s';
      line.style.left = L + 'px';
      line.style.right = R + 'px';
      line.style.opacity = '1';
      wobble();
    }
    visible = true;
    curL = L;
    curR = R;
  };

  const hide = () => {
    if (!line || !nav || !visible) return;
    visible = false;
    if (reduce.matches) { line.style.transition = 'none'; line.style.opacity = '0'; return; }
    // squeezes back into the centre and fades
    const mid = (curL + (nav.offsetWidth - curR)) / 2;
    line.style.transition = 'left 0.3s ease-in, right 0.3s ease-in, opacity 0.3s ease-in';
    line.style.left = mid + 'px';
    line.style.right = nav.offsetWidth - mid + 'px';
    line.style.opacity = '0';
  };

  links.forEach((a) => {
    a.addEventListener('mouseenter', () => show(a));
    a.addEventListener('focus', () => { if (a.matches(':focus-visible')) show(a); });
  });
  nav?.addEventListener('mouseleave', hide);
  nav?.addEventListener('focusout', (e) => { if (!nav.contains((e as FocusEvent).relatedTarget as Node)) hide(); });
  window.addEventListener('resize', hide);
</script>
