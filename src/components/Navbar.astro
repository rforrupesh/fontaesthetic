---
import en from '../i18n/en.json';
import fr from '../i18n/fr.json';
import hi from '../i18n/hi.json';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: 'en' | 'fr' | 'hi';
  translations?: Partial<Record<'en' | 'fr' | 'hi', string>>;
}
const { lang, translations } = Astro.props;
const dict = { en, fr, hi }[lang];
const base = import.meta.env.BASE_URL;
const prefix = lang === 'en' ? '' : `${lang}/`;
---
<nav class="navbar">
  <a href={`${base}${prefix}`} class="brand">
    Font<em>Aesthetic</em>
  </a>
  <div class="nav-links">
    <a href={`${base}${prefix}`}>{dict.nav.home}</a>
    <a href={`${base}${prefix}blog/`}>{dict.nav.blog}</a>
    <a href={`${base}${prefix}about/`}>{dict.nav.about}</a>
    <a href={`${base}${prefix}contact/`}>{dict.nav.contact}</a>
    <LanguageSwitcher currentLang={lang} translations={translations} />
  </div>
</nav>
