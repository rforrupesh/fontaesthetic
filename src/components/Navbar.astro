---
import en from '../i18n/en.json';
import fr from '../i18n/fr.json';
import hi from '../i18n/hi.json';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: 'en' | 'fr' | 'hi';
}
const { lang } = Astro.props;
const dict = { en, fr, hi }[lang];
const base = import.meta.env.BASE_URL;
const prefix = lang === 'en' ? '' : `${lang}/`;
---
<nav style="display:flex; align-items:center; justify-content:space-between; padding:16px 24px; border-bottom:1px solid #2a2a35;">
  <a href={`${base}${prefix}`} style="font-weight:700; font-size:20px; text-decoration:none;">
    Font<span style="color:#8b5cf6;">Aesthetic</span>
  </a>
  <div style="display:flex; align-items:center; gap:20px;">
    <a href={`${base}${prefix}`} style="text-decoration:none;">{dict.nav.home}</a>
    <a href={`${base}${prefix}blog/`} style="text-decoration:none;">{dict.nav.blog}</a>
    <a href={`${base}${prefix}about/`} style="text-decoration:none;">{dict.nav.about}</a>
    <a href={`${base}${prefix}contact/`} style="text-decoration:none;">{dict.nav.contact}</a>
    <LanguageSwitcher currentLang={lang} />
  </div>
</nav>
