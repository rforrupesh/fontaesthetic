---
import { t, getPath } from '../i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
// Inlined as a data URI at build time: the header logo is the LCP element,
// so shipping it inside the HTML removes a network round-trip entirely and
// makes LCP land on the same frame as FCP.
import logo from '../assets/logo.webp?inline';

interface Props { lang: string; alternates?: Record<string, string>; availableLangs?: string[]; }
const { lang, alternates, availableLangs } = Astro.props;
const strings = t(lang);

const navItems = [
  { href: getPath(lang, '/'), label: strings.nav.home },
  { href: getPath(lang, '/blog/'), label: strings.nav.blog },
  { href: getPath(lang, '/about/'), label: strings.nav.about },
  { href: getPath(lang, '/contact/'), label: strings.nav.contact },
];
---

<header class="sticky top-0 z-50 h-[var(--header-h)] flex items-center bg-surface border-b border-border">
  <div class="wrap flex items-center justify-between gap-4">
    <div class="flex items-center gap-8">
      <a href={getPath(lang, '/')} class="flex items-center h-9 md:h-10 shrink-0" aria-label={strings.site.name}>
        <img
          src={logo}
          alt={strings.site.name}
          width="320"
          height="60"
          fetchpriority="high"
          decoding="sync"
          class="h-full w-auto max-w-[160px] object-contain"
        />
      </a>

      <!-- Desktop: single-row menu -->
      <nav class="hidden md:flex gap-4">
        {navItems.map((item) => (
          <a href={item.href} class="text-sm text-text-muted hover:text-text transition-colors duration-150">
            {item.label}
          </a>
        ))}
      </nav>
    </div>

    <div class="hidden md:flex items-center gap-2.5 shrink-0">
      <ThemeToggle />
      <LanguageSwitcher lang={lang} alternates={alternates} availableLangs={availableLangs} />
    </div>

    <!-- Mobile: theme toggle + hamburger -->
    <div class="md:hidden flex items-center gap-2 shrink-0">
      <ThemeToggle />
      <button
        id="menu-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="inline-flex flex-col justify-center items-center gap-1.5 w-9 h-9 shrink-0"
      >
        <span class="menu-bar block w-6 h-0.5 bg-text transition-transform duration-200"></span>
        <span class="menu-bar block w-6 h-0.5 bg-text transition-opacity duration-200"></span>
        <span class="menu-bar block w-6 h-0.5 bg-text transition-transform duration-200"></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu panel -->
  <div
    id="mobile-menu"
    class="hidden md:hidden absolute top-[var(--header-h)] left-0 w-full bg-surface border-b border-border shadow-lg"
  >
    <nav class="wrap flex flex-col py-4 gap-1">
      {navItems.map((item) => (
        <a href={item.href} class="py-2.5 text-sm text-text-muted hover:text-text transition-colors duration-150">
          {item.label}
        </a>
      ))}
      <div class="pt-3 mt-2 border-t border-border">
        <LanguageSwitcher lang={lang} alternates={alternates} availableLangs={availableLangs} />
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const bars = toggle?.querySelectorAll('.menu-bar');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    if (bars && bars.length === 3) {
      bars[0].classList.toggle('rotate-45');
      bars[0].classList.toggle('translate-y-2');
      bars[1].classList.toggle('opacity-0');
      bars[2].classList.toggle('-rotate-45');
      bars[2].classList.toggle('-translate-y-2');
    }
  });

  // Close the menu when a link inside it is clicked (mobile navigation).
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
