---
import { t, getPath } from '../i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props { lang: string; alternates?: Record<string, string>; availableLangs?: string[]; }
const { lang, alternates, availableLangs } = Astro.props;
const strings = t(lang);

const navItems = [
  { href: getPath(lang, '/'), label: strings.nav.home },
  { href: getPath(lang, '/blog/'), label: strings.nav.blog },
  { href: getPath(lang, '/about/'), label: strings.nav.about },
  { href: getPath(lang, '/contact/'), label: strings.nav.contact },
];
---

<header class="site-header sticky top-0 z-50 h-[var(--header-h)] flex items-center bg-surface/90 backdrop-blur-sm border-b border-border">
  <div class="wrap flex items-center justify-between gap-4">
    <div class="flex items-center gap-6">
      <a href={getPath(lang, '/')} class="logo-link flex items-center h-9 md:h-10 shrink-0" aria-label={strings.site.name}>
        <img
          src={`${import.meta.env.BASE_URL}logo.svg`}
          alt={strings.site.name}
          width="320"
          height="60"
          decoding="async"
          class="h-full w-auto max-w-[160px] object-contain"
        />
      </a>

      <!-- Desktop: single-row menu -->
      <nav class="hidden md:flex gap-1 lg:gap-2 relative" id="desktop-nav">
        <span id="nav-pill" aria-hidden="true"></span>
        {navItems.map((item) => (
          <a href={item.href} class="nav-link relative z-10 px-3 text-base lg:text-lg font-medium text-text-muted py-1.5">
            {item.label}
          </a>
        ))}
        <span id="nav-underline" aria-hidden="true"></span>
      </nav>
    </div>

    <div class="hidden md:flex items-center gap-2.5 shrink-0">
      <ThemeToggle lang={lang} />
      <LanguageSwitcher lang={lang} alternates={alternates} availableLangs={availableLangs} />
    </div>

    <!-- Mobile: theme toggle + hamburger -->
    <div class="md:hidden flex items-center gap-2 shrink-0">
      <ThemeToggle lang={lang} />
      <button
        id="menu-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="menu-toggle inline-flex flex-col justify-center items-center gap-1.5 w-9 h-9 shrink-0 rounded-md"
      >
        <span class="menu-bar block w-6 h-0.5 bg-text"></span>
        <span class="menu-bar block w-6 h-0.5 bg-text"></span>
        <span class="menu-bar block w-6 h-0.5 bg-text"></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu panel (animated open/close) -->
  <div id="mobile-menu" class="mobile-panel md:hidden absolute top-[var(--header-h)] left-0 w-full bg-surface">
    <div class="mobile-panel-inner">
      <nav class="wrap flex flex-col py-4 gap-1">
        {navItems.map((item, i) => (
          <a href={item.href} style={`--i:${i}`} class="mobile-link py-2.5 text-sm text-text-muted">
            {item.label}
          </a>
        ))}
        <div class="mobile-link pt-3 mt-2 border-t border-border" style={`--i:${navItems.length}`}>
          <LanguageSwitcher lang={lang} alternates={alternates} availableLangs={availableLangs} />
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  // Header: soft shadow once the page is scrolled
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Mobile menu
  const setMenu = (open: boolean) => {
    menu?.classList.toggle('is-open', open);
    toggle?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    if (open) menu?.removeAttribute('inert'); else menu?.setAttribute('inert', '');
  };
  menu?.setAttribute('inert', '');
  toggle?.addEventListener('click', () => setMenu(!menu?.classList.contains('is-open')));
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });
  document.addEventListener('click', (e) => {
    if (menu?.classList.contains('is-open') && !header?.contains(e.target as Node)) setMenu(false);
  });
  window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => { if (e.matches) setMenu(false); });

  // Desktop nav: gliding hover pill + sliding underline (rests on the active page)
  const nav = document.getElementById('desktop-nav');
  const line = document.getElementById('nav-underline');
  const pill = document.getElementById('nav-pill');
  const links = nav ? [...nav.querySelectorAll<HTMLAnchorElement>('.nav-link')] : [];
  const norm = (p: string) => p.replace(/\/$/, '') || '/';
  const path = norm(location.pathname);
  const active =
    links.find((a) => norm(new URL(a.href).pathname) === path) ??
    links.find((a) => { const lp = norm(new URL(a.href).pathname); return lp !== '/' && path.startsWith(lp); });

  active?.classList.add('is-active');
  active?.setAttribute('aria-current', 'page');

  const ease = 'cubic-bezier(0.65, 0, 0.35, 1)';
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  // --- Pill ---
  let pillVisible = false;
  const movePill = (el?: HTMLElement | null) => {
    if (!pill) return;
    if (!el) { pillVisible = false; pill.style.opacity = '0'; pill.style.transform = pill.style.transform.replace(/ scale\([^)]*\)/, '') + ' scale(0.96)'; return; }
    const place = `translate(${el.offsetLeft}px, ${el.offsetTop}px)`;
    pill.style.width = el.offsetWidth + 'px';
    pill.style.height = el.offsetHeight + 'px';
    if (!pillVisible) {
      pill.style.transition = 'none';
      pill.style.transform = place + ' scale(0.96)';
      void pill.offsetWidth;
      pill.style.transition = '';
      pill.style.transform = place + ' scale(1)';
      pill.style.opacity = '1';
      pillVisible = true;
    } else {
      pill.style.transform = place + ' scale(1)';
    }
  };

  // --- Underline ---
  let lineVisible = false;
  let curL = 0;
  const moveLine = (el?: HTMLElement | null) => {
    if (!line || !nav) return;
    if (!el) { lineVisible = false; line.style.transition = 'opacity 0.2s'; line.style.opacity = '0'; return; }
    const pad = parseFloat(getComputedStyle(el).paddingLeft) || 0;
    const L = el.offsetLeft + pad;
    const R = nav.offsetWidth - el.offsetLeft - el.offsetWidth + pad;
    const animate = !reduce.matches;

    if (!lineVisible) {
      line.style.transition = 'none';
      line.style.left = L + 'px';
      line.style.right = (animate ? R + (el.offsetWidth - 2 * pad) : R) + 'px';
      line.style.opacity = '1';
      void line.offsetWidth;
      line.style.transition = animate ? `right 0.45s ${ease}, opacity 0.2s` : 'none';
      line.style.right = R + 'px';
      lineVisible = true;
    } else {
      const goingRight = L > curL;
      const fast = `0.25s ${ease}`;
      const slow = `0.4s ${ease} 0.07s`;
      line.style.transition = !animate ? 'none' : goingRight ? `right ${fast}, left ${slow}` : `left ${fast}, right ${slow}`;
      line.style.left = L + 'px';
      line.style.right = R + 'px';
    }
    curL = L;
  };

  const rest = () => { movePill(null); moveLine(active); };

  links.forEach((a) => {
    const enter = () => { movePill(a); moveLine(a); };
    a.addEventListener('mouseenter', enter);
    a.addEventListener('focus', () => { if (a.matches(':focus-visible')) enter(); });
  });
  nav?.addEventListener('mouseleave', rest);
  nav?.addEventListener('focusout', (e) => { if (!nav.contains((e as FocusEvent).relatedTarget as Node)) rest(); });
  window.addEventListener('resize', () => { lineVisible = false; pillVisible = false; rest(); });

  // Initial state: underline grows in under the current page once fonts settle
  const init = () => { lineVisible = false; moveLine(active); };
  (document.fonts?.ready ?? Promise.resolve()).then(init);
</script>
