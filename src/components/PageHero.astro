---
interface Props {
  title: string;
  subtitle?: string;
}
const { title, subtitle } = Astro.props;
---

<div class="page-hero text-center py-10 pb-8 border-b border-border">
  <div class="container">
    <h1 class="text-[clamp(1.8rem,4vw,2.6rem)] mb-2">{title}</h1>
    {subtitle && <p class="text-text-muted max-w-[560px] mx-auto">{subtitle}</p>}
  </div>
</div>
