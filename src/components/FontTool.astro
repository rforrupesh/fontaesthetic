---
import { t } from '../i18n';
import { FONT_STYLES, convert } from '../lib/fontStyles';

interface Props { lang: string; }
const { lang } = Astro.props;
const strings = t(lang);

// Pre-render every style with a real sample so the markup (and view-source)
// already contains all the converted text -- crawlers see full content
// with zero JS, instead of one empty div filled in by the browser.
const sampleText = strings.tool.heading;
const rows = FONT_STYLES.map((style) => ({
  slug: style.slug,
  name: style.name,
  sample: convert(sampleText, style),
}));
---

<section class="py-12 pb-8 text-center">
  <div class="container">
    <h1 class="text-[clamp(1.8rem,4vw,2.6rem)] mb-2">{strings.tool.heading}</h1>
    <p class="text-text-muted mb-8">{strings.tool.subheading}</p>

    <div class="card p-4 max-w-[700px] mx-auto">
      <textarea
        id="font-input"
        rows="2"
        placeholder={strings.tool.placeholder}
        class="w-full bg-surface-2 border border-border rounded-md text-text text-[1.1rem] p-3 resize-y font-sans"
      ></textarea>
    </div>

    <div
      id="font-results"
      class="max-w-[700px] mx-auto mt-8 flex flex-col gap-3 text-left"
      data-copied-label={strings.tool.copied}
    >
      {rows.map((row) => (
        <div class="card flex items-center justify-between gap-4 px-4 py-3.5" data-style-slug={row.slug}>
          <div class="break-words text-[1.05rem]" data-role="output">{row.sample}</div>
          <button class="btn shrink-0" type="button" data-role="copy">{strings.tool.copy}</button>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { FONT_STYLES, convert } from '../lib/fontStyles';

  const input = document.getElementById('font-input');
  const results = document.getElementById('font-results');
  const copiedLabel = results.dataset.copiedLabel;
  const rowsEls = Array.from(results.querySelectorAll('[data-style-slug]'));

  // Wire each pre-rendered row's copy button once. It always copies
  // whatever the output div currently shows, so it stays correct as the
  // user types.
  rowsEls.forEach((row) => {
    const output = row.querySelector('[data-role="output"]');
    const btn = row.querySelector('[data-role="copy"]');
    const copyLabel = btn.textContent;
    btn.addEventListener('click', () => {
      navigator.clipboard.writeText(output.textContent).then(() => {
        btn.textContent = copiedLabel;
        setTimeout(() => (btn.textContent = copyLabel), 1500);
      });
    });
  });

  function render() {
    const text = input.value.trim();
    if (!text) return; // keep the SSR sample text showing when the box is empty
    FONT_STYLES.forEach((style, i) => {
      const output = rowsEls[i].querySelector('[data-role="output"]');
      output.textContent = convert(text, style);
    });
  }

  input.addEventListener('input', render);
</script>
