---
import { t } from '../i18n';
import { FONT_STYLES, convert } from '../lib/fontStyles';
import FontRow from './FontRow.astro';

// How many styles are visible at first, and how many each "Load more" click adds.
const INITIAL_COUNT = 51;
const BATCH_SIZE = 7;

interface Props { lang: string; }
const { lang } = Astro.props;
const strings = t(lang);

// Only the first INITIAL_COUNT styles are pre-rendered (crawlers + no-JS see real
// converted text). The rest are created by the script on "Load more".
const sampleText = strings.tool.placeholder;
const rows = FONT_STYLES.slice(0, INITIAL_COUNT).map((style) => ({
  slug: style.slug,
  name: style.name,
  sample: convert(sampleText, style),
}));
---

<section class="py-8 pb-6 text-center">
  <div class="wrap">
    <h1 class="text-[clamp(1.6rem,3.4vw,2.2rem)] mb-2">{strings.tool.heading}</h1>
    <p class="text-text-muted mb-6 text-sm">{strings.tool.subheading}</p>

    <div class="card p-3 max-w-[640px] mx-auto">
      <textarea
        id="font-input"
        rows="2"
        placeholder={strings.tool.placeholder}
        class="w-full bg-surface-2 border border-border rounded-md text-text text-[1rem] p-2.5 resize-y font-sans"
      ></textarea>
    </div>

    <div
      id="font-results"
      class="max-w-[640px] mx-auto mt-6 flex flex-col gap-2.5 text-left"
      data-copied-label={strings.tool.copied}
      data-fav-label={strings.tool.favorite}
      data-unfav-label={strings.tool.unfavorite}
      data-sample={sampleText}
      data-initial={INITIAL_COUNT}
      data-batch={BATCH_SIZE}
    >
      <div id="fav-group" class="fav-group" hidden>
        <div class="fav-group-title">★ {strings.tool.favorites}</div>
        <div id="fav-list" class="flex flex-col gap-2.5"></div>
      </div>
      {rows.map((row) => (
        <FontRow slug={row.slug} name={row.name} sample={row.sample} copy={strings.tool.copy} favorite={strings.tool.favorite} />
      ))}
    </div>

    <div class="max-w-[640px] mx-auto mt-5 flex flex-col items-center gap-2">
      <button id="load-more" class="btn inline-flex items-center justify-center gap-2" type="button">
        <svg class="load-spin" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" opacity=".25"/><path d="M21 12a9 9 0 0 0-9-9"/></svg>
        <span>{strings.tool.loadMore}</span>
      </button>
    </div>

    <template id="row-tpl">
      <FontRow slug="" name="" sample="" copy={strings.tool.copy} favorite={strings.tool.favorite} />
    </template>
  </div>
</section>

<style is:global>
  .fav-btn { position:relative; display:inline-flex; align-items:center; justify-content:center; width:2.1rem; height:2.1rem; border-radius:.5rem; background:transparent; border:1px solid var(--color-border, rgba(128,128,128,.35)); color:var(--color-text-muted, #888); cursor:pointer; transition:color .15s, border-color .15s, transform .15s; }
  .fav-btn svg { fill:none; }
  .fav-btn::after { content:attr(data-tip); position:absolute; bottom:calc(100% + 8px); right:0; white-space:nowrap; background:#000; color:#fff; font-size:.72rem; line-height:1; padding:.4rem .55rem; border-radius:.4rem; box-shadow:0 2px 8px rgba(0,0,0,.35); opacity:0; transform:translateY(3px); pointer-events:none; transition:opacity .15s, transform .15s; z-index:20; }
  .fav-btn:hover::after, .fav-btn:focus-visible::after { opacity:1; transform:none; }
  .fav-btn:hover { color:#f5a623; border-color:#f5a623; }
  .fav-btn:active { transform:scale(.9); }
  .fav-btn[aria-pressed="true"] { color:#f5a623; border-color:#f5a623; }
  .fav-btn[aria-pressed="true"] svg { fill:#f5a623; }
  /* Favorites live in ONE light-yellow group box; the rows inside stay normal cards */
  .fav-group { background-color: rgba(245,166,35,.16); border: 1px solid rgba(245,166,35,.45); border-radius: .9rem; padding: .6rem; }
  @keyframes load-spin { to { transform: rotate(360deg); } }
  .load-spin { animation: load-spin .45s linear infinite; }
  .load-spin { display: none; }
  #load-more.is-loading .load-spin { display: inline-block; }
  #load-more:disabled { opacity: .7; cursor: wait; }
  @keyframes row-in { from { opacity: 0; transform: translateY(10px); } }
  .row-in { animation: row-in .35s ease-out; }
  .fav-group[hidden] { display: none; }
  .fav-group-title { font-size: .72rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: #b9770e; margin: 0 .25rem .5rem; }
  /* After a move/auto-scroll: bright yellow border for ~3s, then fades back */
  @keyframes fav-flash {
    0%, 75% { border-color: #f5a623; box-shadow: 0 0 0 2px rgba(245,166,35,.9), 0 0 20px rgba(245,166,35,.55); }
  }
  .fav-flash { animation: fav-flash 3s ease-out .1s; }
</style>

<script>
  // Kept as a static import on purpose: a chunk with zero imports (static or
  // dynamic) is the only kind Astro will inline into the HTML, which is what
  // removes this file from the page's request chain.
  import { FONT_STYLES, convert } from '../lib/fontStyles';

  const input = document.getElementById('font-input');
  const results = document.getElementById('font-results');
  const loadMoreBtn = document.getElementById('load-more');
  const rowTpl = document.getElementById('row-tpl').content.firstElementChild;
  const copiedLabel = results.dataset.copiedLabel;
  const favLabel = results.dataset.favLabel;
  const unfavLabel = results.dataset.unfavLabel;
  const sampleText = results.dataset.sample;
  const BATCH = Number(results.dataset.batch) || 7;
  const KEY = 'fontaesthetic:favorites';

  const styleBySlug = new Map(FONT_STYLES.map((st) => [st.slug, st]));
  const rowsBySlug = new Map(); // every row element created so far
  results.querySelectorAll('[data-style-slug]').forEach((r) => rowsBySlug.set(r.dataset.styleSlug, r));

  let currentText = sampleText;           // what the rows currently show
  let shown = Number(results.dataset.initial) || 14; // how many NON-favorite styles are visible

  // Favorites are stored by style slug (language independent) in localStorage.
  let favs = [];
  try { favs = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) {}
  favs = favs.filter((slug) => styleBySlug.has(slug));
  const saveFavs = () => { try { localStorage.setItem(KEY, JSON.stringify(favs)); } catch (e) {} };

  const favGroup = document.getElementById('fav-group');
  const favList = document.getElementById('fav-list');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Rows beyond the server-rendered ones are created on demand from the <template>.
  function getRow(style) {
    let row = rowsBySlug.get(style.slug);
    if (!row) {
      row = rowTpl.cloneNode(true);
      row.dataset.styleSlug = style.slug;
      row.querySelector('[data-role="name"]').textContent = style.name;
      row.querySelector('[data-role="output"]').textContent = convert(currentText, style);
      row.dataset.isNew = '1';
      rowsBySlug.set(style.slug, row);
    }
    return row;
  }

  // moved = the row the user just (un)favorited. We animate (FLIP): measure
  // old positions, reorder, then slide every row from old -> new position so
  // the user SEES the style travel to the top instead of vanishing.
  function render(moved) {
    // Clear any previous highlight FIRST. Moving a node in the DOM restarts its CSS
    // animation, so an old highlighted row would flash again on the next click.
    rowsBySlug.forEach((r) => r.classList.remove('fav-flash'));
    const before = new Map();
    rowsBySlug.forEach((r) => { if (r.isConnected) before.set(r, r.getBoundingClientRect().top); });

    const favRows = favs.map((slug) => getRow(styleBySlug.get(slug)));
    const favSet = new Set(favs);
    // The visible list = the first `shown` styles that are NOT favorites.
    const rest = [];
    for (let i = 0; i < FONT_STYLES.length && rest.length < shown; i++) {
      if (!favSet.has(FONT_STYLES[i].slug)) rest.push(getRow(FONT_STYLES[i]));
    }
    const keep = new Set([...favRows, ...rest]);
    rowsBySlug.forEach((r) => { if (!keep.has(r) && r.isConnected) r.remove(); });

    keep.forEach((r) => {
      const on = favSet.has(r.dataset.styleSlug);
      const b = r.querySelector('[data-role="fav"]');
      b.setAttribute('aria-pressed', String(on));
      b.setAttribute('aria-label', on ? unfavLabel : favLabel);
      b.dataset.tip = on ? unfavLabel : favLabel;
    });
    // Favorites go inside the yellow group box, everything else stays in the main list.
    favRows.forEach((r) => favList.appendChild(r));
    rest.forEach((r) => results.appendChild(r));
    favGroup.hidden = favRows.length === 0;

    // Rows that were just created fade in.
    keep.forEach((r) => {
      if (r.dataset.isNew) { delete r.dataset.isNew; if (!reduceMotion) r.classList.add('row-in'); }
    });

    const total = FONT_STYLES.length;
    loadMoreBtn.hidden = shown >= total - favRows.length;

    if (!moved || reduceMotion || !keep.has(moved)) return;

    // Keep the moved row in view: smooth-scroll to it if it landed off-screen.
    const isFav = favSet.has(moved.dataset.styleSlug);
    const rect = moved.getBoundingClientRect();
    if (rect.top < 90 || rect.bottom > window.innerHeight) {
      moved.style.scrollMarginTop = '100px';
      moved.scrollIntoView({ behavior: 'smooth', block: isFav ? 'start' : 'center' });
    }

    keep.forEach((r) => {
      if (!before.has(r)) return;
      const delta = before.get(r) - r.getBoundingClientRect().top;
      if (!delta) return;
      r.style.transition = 'none';
      r.style.transform = `translateY(${delta}px)`;
      r.style.zIndex = r === moved ? '5' : '';
      r.getBoundingClientRect(); // force reflow
      r.style.transition = 'transform .6s cubic-bezier(.2,.8,.2,1)';
      r.style.transform = '';
    });

    moved.classList.remove('fav-flash');
    void moved.offsetWidth;
    moved.classList.add('fav-flash');
  }

  results.addEventListener('animationend', (e) => {
    e.target.classList.remove('fav-flash', 'row-in');
  });

  // One delegated listener for fav + copy buttons (works for rows created later too).
  results.addEventListener('click', (e) => {
    const fav = e.target.closest('[data-role="fav"]');
    if (fav) {
      const slug = fav.closest('[data-style-slug]').dataset.styleSlug;
      favs = favs.includes(slug) ? favs.filter((s) => s !== slug) : [slug, ...favs];
      saveFavs();
      render(fav.closest('[data-style-slug]'));
      return;
    }
    const btn = e.target.closest('[data-role="copy"]');
    if (!btn) return;
    const row = btn.closest('[data-style-slug]');
    const copyLabel = btn.textContent;
    navigator.clipboard
      .writeText(row.querySelector('[data-role="output"]').textContent)
      .then(() => {
        btn.textContent = copiedLabel;
        setTimeout(() => (btn.textContent = copyLabel), 1500);
      });
  });

  let loading = false;
  loadMoreBtn.addEventListener('click', () => {
    if (loading) return;
    loading = true;
    loadMoreBtn.disabled = true;
    loadMoreBtn.classList.add('is-loading');
    setTimeout(() => {
      shown += BATCH;
      render();
      loadMoreBtn.classList.remove('is-loading');
      loadMoreBtn.disabled = false;
      loading = false;
    }, 250);
  });

  input.addEventListener('input', () => {
    currentText = input.value.trim() || sampleText; // empty box -> back to the sample text
    rowsBySlug.forEach((row, slug) => {
      row.querySelector('[data-role="output"]').textContent = convert(currentText, styleBySlug.get(slug));
    });
  });

  render();
</script>
