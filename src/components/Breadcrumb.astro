---
import { useTranslations } from '../i18n/ui';
interface Props {
  lang: 'en' | 'fr' | 'es';
  postTitle: string;
}
const { lang, postTitle } = Astro.props;
const t = useTranslations(lang);
const prefixFor = (l: string) => (l === 'en' ? '' : `/${l}`);
const p = prefixFor(lang);

const items = [
  { name: t('breadcrumb.home'), url: p || '/' },
  { name: t('breadcrumb.blog'), url: `${p}/blog/` },
  { name: postTitle, url: null },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.name,
    ...(item.url ? { item: `https://fontaesthetic.in${item.url}` } : {}),
  })),
};
---
<nav class="breadcrumb" aria-label="Breadcrumb">
  <ol>
    {items.map((item, i) => (
      <li>
        {item.url ? <a href={item.url}>{item.name}</a> : <span aria-current="page">{item.name}</span>}
        {i < items.length - 1 && <span class="sep">/</span>}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  .breadcrumb ol{list-style:none;display:flex;flex-wrap:wrap;gap:4px;margin:0 0 20px;padding:0;font-size:13.5px;color:var(--mono);}
  .breadcrumb li{display:flex;align-items:center;gap:4px;}
  .breadcrumb a{color:var(--mono);text-decoration:none;}
  .breadcrumb a:hover{color:var(--accent);}
  .breadcrumb .sep{opacity:0.5;}
  .breadcrumb [aria-current="page"]{color:var(--ink);}
</style>
