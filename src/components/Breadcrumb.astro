---
interface Crumb { name: string; url: string; }
interface Props { items: Crumb[]; }
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-[.82rem] text-text-muted mb-3">
  <ol class="flex flex-wrap items-center gap-1.5">
    {items.map((item, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && <span class="text-text-muted/60">/</span>}
        {i === items.length - 1 ? (
          <span class="text-text truncate max-w-[220px] sm:max-w-none">{item.name}</span>
        ) : (
          <a href={item.url} class="hover:text-text transition-colors duration-150">{item.name}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
