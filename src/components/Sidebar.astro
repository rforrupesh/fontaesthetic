---
import { t } from '../i18n';

interface Heading { depth: number; slug: string; text: string; }

interface Props {
  lang: string;
  headings?: Heading[];
}

const { lang, headings = [] } = Astro.props;
const strings = t(lang);
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<aside class="sidebar">
  {tocHeadings.length > 0 && (
    <div class="sidebar-block card">
      <h2 class="sidebar-title">{strings.sidebar.toc}</h2>
      <nav class="toc">
        {tocHeadings.map((h) => (
          <a href={`#${h.slug}`} class={`toc-link depth-${h.depth}`}>{h.text}</a>
        ))}
      </nav>
    </div>
  )}
</aside>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .sidebar-block { padding: 1.1rem 1.2rem; }
  .sidebar-title {
    font-size: .85rem;
    text-transform: uppercase;
    letter-spacing: .04em;
    color: var(--color-text-muted);
    margin: 0 0 .8rem;
  }
  .toc { display: flex; flex-direction: column; gap: .5rem; }
  .toc-link {
    font-size: .88rem;
    color: var(--color-text-muted);
    line-height: 1.3;
  }
  .toc-link.depth-3 { padding-left: .9rem; font-size: .82rem; }
  .toc-link:hover { color: var(--color-primary); }

  @media (max-width: 900px) {
    .sidebar { flex-direction: row; overflow-x: auto; }
    .sidebar-block { min-width: 240px; }
  }
</style>
