---
import en from '../i18n/en.json';
import fr from '../i18n/fr.json';
import hi from '../i18n/hi.json';

interface Props {
  lang: 'en' | 'fr' | 'hi';
  posts: Array<{ title: string; href: string }>;
}
const { lang, posts } = Astro.props;
const dict = { en, fr, hi }[lang];
---
<aside class="card" style="min-width:220px;">
  <h3 style="margin-top:0; font-size:15px; color:#8b5cf6;">{dict.sidebar.recent}</h3>
  <ul style="list-style:none; padding:0; margin:0;">
    {posts.map((p) => (
      <li style="margin-bottom:10px;">
        <a href={p.href} style="text-decoration:none; color:#eaeaf0; font-size:14px;">{p.title}</a>
      </li>
    ))}
  </ul>
</aside>
