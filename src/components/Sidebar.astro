---
import { t } from '../i18n';

interface Heading { depth: number; slug: string; text: string; }

interface Props {
  lang: string;
  headings?: Heading[];
}

const { lang, headings = [] } = Astro.props;
const strings = t(lang);
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<aside class="flex flex-col gap-5">
  {tocHeadings.length > 0 && (
    <div class="card p-5">
      <h2 class="text-[.85rem] uppercase tracking-wide text-text-muted mb-3">{strings.sidebar.toc}</h2>
      <nav class="flex flex-col gap-2">
        {tocHeadings.map((h) => (
          <a
            href={`#${h.slug}`}
            class:list={[
              'text-text-muted hover:text-primary transition-colors duration-150 leading-tight',
              h.depth === 3 ? 'pl-3.5 text-[.82rem]' : 'text-[.88rem]',
            ]}
          >
            {h.text}
          </a>
        ))}
      </nav>
    </div>
  )}
</aside>
