---
import BaseLayout from '../layouts/BaseLayout.astro';
import FontTool from '../components/FontTool.astro';
import { t } from '../i18n';
const strings = t('en');
---

<BaseLayout
  lang="en"
  title={`${strings.site.name} — ${strings.site.tagline}`}
  description={strings.tool.subheading}
  path="/"
>
  <FontTool lang="en" />
</BaseLayout>
