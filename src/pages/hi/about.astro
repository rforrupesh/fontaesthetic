---
import BaseLayout from '../../layouts/BaseLayout.astro';
import hi from '../../i18n/hi.json';
---
<BaseLayout lang="hi" title={hi.pages.about_title} description={hi.meta.home_description} path="/about/">
  <div class="card page-card">
    <h1>{hi.pages.about_title}</h1>
    <p>FontAesthetic एक मुफ्त ऑनलाइन टूल है जिससे आप तुरंत स्टाइलिश, बोल्ड, इटैलिक, कर्सिव और यूनिकोड फॉन्ट जनरेट कर सकते हैं — बिना साइनअप, बिना वॉटरमार्क, बिना किसी झंझट के।</p>
    <p>हमने यह टूल क्रिएटर्स, सोशल मीडिया यूज़र्स और उन सभी के लिए बनाया है जो चाहते हैं कि उनका टेक्स्ट Instagram, Discord, WhatsApp जैसी जगहों पर अलग दिखे।</p>
  </div>
</BaseLayout>
