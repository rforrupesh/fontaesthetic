---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { t } from '../../i18n';
const strings = t('hi');

const features = [
  { title: 'साइन-अप ज़रूरी नहीं', text: 'बस पेज खोलें और टाइप करना शुरू करें। कोई अकाउंट नहीं, कोई डाउनलोड नहीं।' },
  { title: 'हर जगह काम करता है', text: 'Instagram, WhatsApp, Discord, Twitter/X और अन्य जगहों पर पेस्ट करें।' },
  { title: '100% मुफ्त', text: 'कोई छुपा शुल्क नहीं, कोई प्रीमियम प्लान नहीं।' },
];
---
<BaseLayout lang="hi" title={`हमारे बारे में — ${strings.site.name}`} description="FontAesthetic के बारे में और जानें, मुफ्त ऑनलाइन फॉन्ट जनरेटर।" path="/about/">
  <PageHero
    title="हमारे बारे में"
    subtitle="एक मुफ्त ऑनलाइन फॉन्ट जनरेटर जो आपके सादे टेक्स्ट को स्टाइलिश यूनिकोड फॉन्ट में बदल देता है, जिसे आप कहीं भी कॉपी-पेस्ट कर सकते हैं।"
  />

  <section class="container py-10 max-w-[820px] mx-auto">
    <div class="grid sm:grid-cols-3 gap-5 mb-8">
      {features.map((f) => (
        <div class="card p-5">
          <div class="w-8 h-8 rounded-md bg-primary/15 text-primary flex items-center justify-center mb-3">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
          </div>
          <h3 class="text-[1.02rem] mb-1.5">{f.title}</h3>
          <p class="text-text-muted text-[.9rem] m-0">{f.text}</p>
        </div>
      ))}
    </div>

    <p class="text-text-muted text-center max-w-[560px] mx-auto">
      क्रिएटर्स, मार्केटर्स और हर उस व्यक्ति के लिए बनाया गया जो चाहता है कि उसका टेक्स्ट अलग दिखे।
    </p>
  </section>
</BaseLayout>
