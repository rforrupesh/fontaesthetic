---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sidebar from '../../../components/Sidebar.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const hiPosts = allPosts.filter((p) => p.id.startsWith('hi/'));

  return hiPosts.map((post) => {
    const slug = post.data.slug ?? post.id.replace('hi/', '').replace(/\.md$/, '');
    return { params: { slug }, props: { post, allPosts } };
  });
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;

const otherPosts = allPosts.filter((p) => p.id.startsWith('hi/'));
const sidebarPosts = otherPosts.map((p) => ({
  title: p.data.title,
  href: `${base}hi/blog/${p.data.slug ?? p.id.replace('hi/', '').replace(/\.md$/, '')}/`
}));

function slugFor(p) {
  const lang = p.id.split('/')[0];
  const filename = p.id.split('/')[1].replace(/\.md$/, '');
  const slug = p.data.slug ?? filename;
  const prefix = lang === 'en' ? '' : `${lang}/`;
  return [lang, `/${prefix}blog/${slug}/`];
}

const relatedTranslations = allPosts.filter((p) => p.data.translationId === post.data.translationId);
const translations = Object.fromEntries(relatedTranslations.map(slugFor));
---
<BaseLayout
  lang="hi"
  title={`${post.data.title} - FontAesthetic`}
  description={post.data.description}
  path={`/blog/${post.data.slug ?? post.id.replace('hi/', '').replace(/\.md$/, '')}/`}
  translations={translations}
>
  <div class="blog-layout">
    <article class="card blog-main">
      <h1>{post.data.title}</h1>
      <p class="blog-date">{post.data.date.toDateString()}</p>
      <Content />
    </article>
    <Sidebar lang="hi" posts={sidebarPosts} />
  </div>
</BaseLayout>
