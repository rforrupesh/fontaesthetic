---
import BaseLayout from '../../layouts/BaseLayout.astro';
import hi from '../../i18n/hi.json';
---
<BaseLayout lang="hi" title={hi.pages.contact_title} description={hi.meta.home_description} path="/contact/">
  <div class="card page-card">
    <h1>{hi.pages.contact_title}</h1>
    <p>कोई सवाल, सुझाव या बग मिला? हमसे <a href="mailto:hello@fontaesthetic.com" class="inline-link">hello@fontaesthetic.com</a> पर संपर्क करें।</p>
  </div>
</BaseLayout>
