---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n';
const strings = t('hi');
---
<BaseLayout lang="hi" title={`संपर्क करें — ${strings.site.name}`} description="FontAesthetic टीम से संपर्क करें।" path="/contact/">
  <section class="container prose page-content">
    <h1>संपर्क करें</h1>
    <p>कोई सवाल, सुझाव, या कोई बग मिला? हमें आपसे सुनना अच्छा लगेगा।</p>
    <p>हमें ईमेल करें: <a href="mailto:hello@fontaesthetic.example">hello@fontaesthetic.example</a></p>
  </section>
</BaseLayout>
