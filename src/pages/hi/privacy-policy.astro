---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { t } from '../../i18n';
const strings = t('hi');

const sections = [
  {
    title: 'हम क्या इकट्ठा करते हैं',
    text: 'FontAesthetic फॉन्ट जनरेटर में आपके द्वारा टाइप किए गए टेक्स्ट को स्टोर नहीं करता। पूरा कन्वर्शन सीधे आपके ब्राउज़र में होता है।',
  },
  {
    title: 'एनालिटिक्स',
    text: 'हम साइट के उपयोग को समझने के लिए बुनियादी, प्राइवेसी-फ्रेंडली एनालिटिक्स का उपयोग कर सकते हैं। हम किसी तीसरे पक्ष को व्यक्तिगत डेटा नहीं बेचते।',
  },
];
---
<BaseLayout lang="hi" title={`गोपनीयता नीति — ${strings.site.name}`} description="FontAesthetic की गोपनीयता नीति।" path="/privacy-policy/">
  <PageHero title="गोपनीयता नीति" subtitle="आखिरी अपडेट: जनवरी 2026" />

  <section class="wrap py-10 max-w-[680px] mx-auto flex flex-col gap-5">
    {sections.map((s) => (
      <div class="card p-5">
        <h2 class="text-[1.05rem] mb-2">{s.title}</h2>
        <p class="text-text-muted m-0">{s.text}</p>
      </div>
    ))}
  </section>
</BaseLayout>
