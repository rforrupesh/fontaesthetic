---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FontTool from '../../components/FontTool.astro';
import { t } from '../../i18n';
const strings = t('fr');
---

<BaseLayout
  lang="fr"
  title={`${strings.site.name} — ${strings.site.tagline}`}
  description={strings.tool.subheading}
  path="/"
>
  <FontTool lang="fr" />
</BaseLayout>
