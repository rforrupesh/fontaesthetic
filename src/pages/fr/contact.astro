---
import BaseLayout from '../../layouts/BaseLayout.astro';
import fr from '../../i18n/fr.json';
---
<BaseLayout lang="fr" title={fr.pages.contact_title} description={fr.meta.home_description} path="/contact/">
  <div class="card page-card">
    <h1>{fr.pages.contact_title}</h1>
    <p>Une question, une suggestion ou un bug à signaler ? Contactez-nous à <a href="mailto:hello@fontaesthetic.com" class="inline-link">hello@fontaesthetic.com</a>.</p>
  </div>
</BaseLayout>
