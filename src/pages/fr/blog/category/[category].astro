---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../../../components/schema/BreadcrumbSchema.astro';
import CollectionPageSchema from '../../../../components/schema/CollectionPageSchema.astro';
import OrganizationSchema from '../../../../components/schema/OrganizationSchema.astro';
import { getCollection } from 'astro:content';
import { t, getPath } from '../../../../i18n';
import { slugify } from '../../../../lib/slugify';

const lang = 'fr';
const strings = t(lang);

export async function getStaticPaths() {
  const posts = await getCollection('blog', (e) => e.id.startsWith('fr/'));
  // Group original category text by its lowercase URL slug, so "Guides"
  // and "guides" collapse to one /blog/category/guides/ page.
  const slugToCategory = new Map<string, string>();
  posts.forEach((p) => {
    if (!p.data.category) return;
    const slug = slugify(p.data.category);
    if (!slugToCategory.has(slug)) slugToCategory.set(slug, p.data.category);
  });

  return Array.from(slugToCategory.entries()).map(([slug, category]) => ({
    params: { category: slug },
    props: { category },
  }));
}

const { category } = Astro.props;

const posts = (await getCollection('blog', (e) => e.id.startsWith('fr/')))
  .filter((p) => p.data.category && slugify(p.data.category) === slugify(category))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// For each language, link to the same category page only if that language
// actually has a post with this exact category -- otherwise fall back to
// that language's blog listing (always exists) instead of a 404.
const allLangs = ['en', 'fr', 'hi'];
const alternates: Record<string, string> = {};
for (const l of allLangs) {
  const postsInLang = l === lang ? posts : await getCollection('blog', (e) => e.id.startsWith(`${l}/`));
  const hasCategory = l === lang ? posts.length > 0 : postsInLang.some((p) => p.data.category && slugify(p.data.category) === slugify(category));
  alternates[l] = hasCategory ? `/blog/category/${slugify(category)}/` : '/blog/';
}

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const base = import.meta.env.BASE_URL;
const pageUrl = siteUrl + getPath(lang, `/blog/category/${slugify(category)}/`);
const logoUrl = `${siteUrl}${base}logo.svg`;
const title = category;
---

<BaseLayout
  lang={lang}
  title={`${title} — ${strings.blog.listingTitle} — ${strings.site.name}`}
  description={strings.blog.listingDescription}
  path={`/blog/category/${slugify(category)}/`}
  alternates={alternates}
>
  <section class="container py-12 pb-6 text-center">
    <h1 class="text-[clamp(1.7rem,4vw,2.2rem)]">{title}</h1>
    <p class="text-text-muted">{strings.blog.listingDescription}</p>
  </section>

  <section class="container grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-7 pb-12">
    {posts.map((post) => {
      const slug = post.data.slug ?? post.id.split('/').slice(1).join('/');
      return (
        <a class="card overflow-hidden flex flex-col" href={getPath(lang, `/blog/${slug}/`)}>
          {post.data.image && <img src={post.data.image} alt={post.data.title} loading="lazy" class="w-full aspect-video object-cover" />}
          <div class="p-5 pb-6">
            <h2 class="text-[1.05rem] mb-2">{post.data.title}</h2>
            <p class="text-[.88rem] text-text-muted mb-3">{post.data.description}</p>
            <span class="text-xs text-text-muted">
              {strings.blog.publishedOn} {post.data.date.toLocaleDateString(lang)}
            </span>
          </div>
        </a>
      );
    })}
  </section>

  <BreadcrumbSchema
    items={[
      { name: strings.nav.home, url: siteUrl + getPath(lang, '/') },
      { name: strings.blog.listingTitle, url: siteUrl + getPath(lang, '/blog/') },
      { name: title, url: pageUrl },
    ]}
  />
  <CollectionPageSchema
    name={`${title} — ${strings.blog.listingTitle}`}
    description={strings.blog.listingDescription}
    url={pageUrl}
    lang={lang}
  />
  <OrganizationSchema name={strings.site.name} siteUrl={siteUrl + base} logoUrl={logoUrl} />
</BaseLayout>
