---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sidebar from '../../../components/Sidebar.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const frPosts = allPosts.filter((p) => p.id.startsWith('fr/'));

  return frPosts.map((post) => {
    const slug = post.data.slug ?? post.id.replace('fr/', '').replace(/\.md$/, '');
    return { params: { slug }, props: { post, allPosts } };
  });
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;

const otherPosts = allPosts.filter((p) => p.id.startsWith('fr/'));
const sidebarPosts = otherPosts.map((p) => ({
  title: p.data.title,
  href: `${base}fr/blog/${p.data.slug ?? p.id.replace('fr/', '').replace(/\.md$/, '')}/`
}));

function slugFor(p) {
  const lang = p.id.split('/')[0];
  const filename = p.id.split('/')[1].replace(/\.md$/, '');
  const slug = p.data.slug ?? filename;
  const prefix = lang === 'en' ? '' : `${lang}/`;
  return [lang, `/${prefix}blog/${slug}/`];
}

const relatedTranslations = allPosts.filter((p) => p.data.translationId === post.data.translationId);
const translations = Object.fromEntries(relatedTranslations.map(slugFor));
---
<BaseLayout
  lang="fr"
  title={`${post.data.title} - FontAesthetic`}
  description={post.data.description}
  path={`/blog/${post.data.slug ?? post.id.replace('fr/', '').replace(/\.md$/, '')}/`}
  translations={translations}
>
  <div style="display:flex; gap:24px; align-items:flex-start; flex-wrap:wrap;">
    <article class="card" style="flex:1; min-width:280px;">
      <h1 style="margin-top:0;">{post.data.title}</h1>
      <p style="color:#888; font-size:14px;">{post.data.date.toDateString()}</p>
      <Content />
    </article>
    <Sidebar lang="fr" posts={sidebarPosts} />
  </div>
</BaseLayout>
