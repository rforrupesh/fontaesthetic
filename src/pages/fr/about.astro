---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { t } from '../../i18n';
const strings = t('fr');

const features = [
  { title: 'Sans inscription', text: 'Ouvrez la page et commencez à taper. Aucun compte, aucun téléchargement.' },
  { title: 'Fonctionne partout', text: 'Collez sur Instagram, WhatsApp, Discord, Twitter/X et plus encore.' },
  { title: '100% gratuit', text: 'Aucun frais caché, aucune offre premium.' },
];
---
<BaseLayout lang="fr" title={`À Propos — ${strings.site.name}`} description="En savoir plus sur FontAesthetic, le générateur de polices gratuit." path="/about/">
  <PageHero
    title="À Propos de Nous"
    subtitle="Un générateur de polices en ligne gratuit qui transforme votre texte en polices Unicode stylées à copier-coller n'importe où."
  />

  <section class="container py-10 max-w-[820px] mx-auto">
    <div class="grid sm:grid-cols-3 gap-5 mb-8">
      {features.map((f) => (
        <div class="card p-5">
          <div class="w-8 h-8 rounded-md bg-primary/15 text-primary flex items-center justify-center mb-3">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
          </div>
          <h3 class="text-[1.02rem] mb-1.5">{f.title}</h3>
          <p class="text-text-muted text-[.9rem] m-0">{f.text}</p>
        </div>
      ))}
    </div>

    <p class="text-text-muted text-center max-w-[560px] mx-auto">
      Conçu pour les créateurs, les marketeurs et tous ceux qui veulent que leur texte se démarque.
    </p>
  </section>
</BaseLayout>
