---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FancyTextTool from '../../components/FancyTextTool.astro';
---
<BaseLayout
  title="Générateur de Texte Stylé — Polices Unicode esthétiques, gras, italique, bulle, gothique"
  description="Générez du texte unicode esthétique : gras, italique, script, gothique, bulle, encerclé, inversé et plus de 30 autres styles. Chaque style est du vrai texte sur la page — copiez en un clic."
  lang="fr"
  path="/fancy-text/"
>
  <FancyTextTool
    title="Générateur de Texte Stylé"
    intro="Tapez votre texte une fois — chaque style ci-dessous se met à jour instantanément. Chaque style est un vrai texte lisible, pas une image, donc il se copie, se colle et se lit parfaitement partout, y compris dans les résultats de recherche."
  />
</BaseLayout>
