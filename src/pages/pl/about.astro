---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { t, getPath } from '../../i18n';
const strings = t('pl');

const features = [
  { title: "Bez rejestracji", text: "Po prostu otwórz stronę i zacznij pisać. Bez kont, bez pobierania." },
  { title: "Działa wszędzie", text: "Wklejaj na Instagramie, WhatsAppie, Discordzie, Twitterze/X i w wielu innych miejscach." },
  { title: "W 100% za darmo", text: "Żadnych ukrytych opłat ani planów premium. Nigdy." },
];
---
<BaseLayout lang="pl" title={`O nas — ${strings.site.name}`} description="Dowiedz się więcej o AestheticFonts, darmowym generatorze czcionek online." path="/about/">
  <PageHero
    title="O nas"
    subtitle="Darmowy generator czcionek online, który zamienia zwykły tekst w stylowe czcionki Unicode, które możesz skopiować i wkleić gdziekolwiek."
  />

  <section class="wrap py-10 max-w-[820px] mx-auto">
    <div class="grid sm:grid-cols-3 gap-5 mb-8">
      {features.map((f) => (
        <div class="card p-5">
          <div class="w-8 h-8 rounded-md bg-primary/15 text-primary flex items-center justify-center mb-3">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
          </div>
          <h3 class="text-[1.02rem] mb-1.5">{f.title}</h3>
          <p class="text-text-muted text-[.9rem] m-0">{f.text}</p>
        </div>
      ))}
    </div>

    <p class="text-text-muted text-center max-w-[560px] mx-auto">
      Stworzony dla twórców, marketerów i każdego, kto chce, aby jego tekst się wyróżniał.
    </p>

    <p class="text-text-muted text-center mt-2">
      Masz pytanie lub sugestię?
      <a href={getPath('pl', '/contact/')} class="text-primary underline underline-offset-2 hover:text-primary-hover transition-colors duration-150">{strings.footer.contact}</a>
    </p>
  </section>
</BaseLayout>
