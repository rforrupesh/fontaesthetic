---
import { imgUrl } from '../../../../../lib/imageUrl';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../../../../components/schema/BreadcrumbSchema.astro';
import CollectionPageSchema from '../../../../../components/schema/CollectionPageSchema.astro';
import OrganizationSchema from '../../../../../components/schema/OrganizationSchema.astro';
import WebSiteSchema from '../../../../../components/schema/WebSiteSchema.astro';
import { getCollection } from 'astro:content';
import { t, getPath } from '../../../../../i18n';
import { slugify } from '../../../../../lib/slugify';
import Pagination from '../../../../../components/Pagination.astro';
import { PAGE_SIZE } from '../../../../../lib/pagination';

const lang = 'pl';
const strings = t(lang);

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const posts = (await getCollection('blog', (e) => e.id.startsWith('pl/')))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
    // Group original text by its lowercase URL slug, so "Fonts" and "fonts"
  // collapse into one page. A post can belong to several tags.
  const slugTo = new Map<string, string>();
  posts.forEach((p) => p.data.tags.forEach((x) => {
    const slug = slugify(x);
    if (!slugTo.has(slug)) slugTo.set(slug, x);
  }));

  // One paginated set of pages per tag: /tag/<slug>/, /tag/<slug>/2/ ...
  return Array.from(slugTo.entries()).flatMap(([slug, tag]) =>
    paginate(
      posts.filter((p) => p.data.tags.some((x) => slugify(x) === slug)),
      { params: { tag: slug }, props: { tag }, pageSize: PAGE_SIZE },
    ),
  );
}

const { page, tag } = Astro.props;
const posts = page.data;
const total = page.total;


const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const base = import.meta.env.BASE_URL;
const basePath = `/blog/tag/${slugify(tag)}/`;
const pagePath = page.currentPage > 1 ? `${basePath}${page.currentPage}/` : basePath;
const pageUrl = siteUrl + getPath(lang, pagePath);
const pageSuffix = page.currentPage > 1 ? ` – ${strings.blog.page} ${page.currentPage}` : '';
const logoUrl = `${siteUrl}${base}logo.svg`;
const absImg = (img?: string) => { const u = imgUrl(img); return u ? (/^https?:/.test(u) ? u : siteUrl + u) : undefined; };
const collectionImage = absImg(posts.find((p) => p.data.image)?.data.image) ?? logoUrl;
const collectionItems = posts.map((p) => ({
  name: p.data.title,
  url: siteUrl + getPath(lang, `/blog/${p.data.slug ?? p.id.split('/').slice(1).join('/')}/`),
}));
const pageDescription = strings.blog.tagDescription.replace('{name}', tag).replace('{count}', String(total));
const title = tag;
---

<BaseLayout
  lang={lang}
  title={`${title} ${strings.blog.archives}${pageSuffix} - ${strings.site.name}`}
  description={pageDescription}
  path={pagePath}
  alternates={page.currentPage > 1 ? { [lang]: pagePath } : undefined}
  switcherPath={page.currentPage > 1 ? pagePath : undefined}
  availableLangs={[lang]}
  noindex={true}
>
  <section class="wrap py-12 pb-6 text-center">
    <h1 class="text-[clamp(1.7rem,4vw,2.2rem)]">{title}{page.currentPage > 1 && <span class="text-text-muted font-normal"> · {strings.blog.page} {page.currentPage}</span>}</h1>
    <p class="text-[.85rem] text-text-muted">{total} {strings.blog.articles}</p>
  </section>

  <section class="wrap max-w-[860px] flex flex-col gap-6 pb-12">
    {posts.length === 0 && <p class="text-center text-text-muted">{strings.blog.noPosts}</p>}
    {posts.map((post) => {
      const slug = post.data.slug ?? post.id.split('/').slice(1).join('/');
      const postHref = getPath(lang, `/blog/${slug}/`);
      const cat = post.data.categories[0];
      return (
        <article class="card overflow-hidden flex flex-col sm:flex-row">
          {post.data.image && (
            <a href={postHref} aria-label={post.data.title} class="sm:w-[280px] shrink-0">
              <img src={imgUrl(post.data.image)} alt={post.data.title} loading="lazy" class="w-full h-full aspect-video object-contain bg-surface-2" />
            </a>
          )}
          <div class="p-5 flex flex-col gap-2">
            <div class="flex flex-wrap items-center gap-2 text-[.75rem] text-text-muted">
              {cat && (
                <a href={getPath(lang, `/blog/category/${slugify(cat)}/`)} class="font-medium px-2.5 py-1 rounded-full bg-primary/10 text-primary hover:bg-primary/20">{cat}</a>
              )}
            </div>
            <h2 class="text-[1.15rem] mb-0"><a href={postHref} class="hover:text-primary">{post.data.title}</a></h2>
            <p class="text-[.9rem] text-text-muted mb-0">{post.data.description}</p>
            <a href={postHref} class="text-[.85rem] font-medium text-primary mt-1">{strings.blog.readMore} →</a>
          </div>
        </article>
      );
    })}
  </section>

  <Pagination lang={lang} basePath={basePath} current={page.currentPage} last={page.lastPage} />

  <BreadcrumbSchema
    items={[
      { name: strings.nav.home, url: siteUrl + getPath(lang, '/') },
      { name: strings.blog.listingTitle, url: siteUrl + getPath(lang, '/blog/') },
      { name: title, url: siteUrl + getPath(lang, basePath) },
      ...(page.currentPage > 1 ? [{ name: `${strings.blog.page} ${page.currentPage}`, url: pageUrl }] : []),
    ]}
  />
  <CollectionPageSchema
    name={`${title} ${strings.blog.archives}`}
    description={pageDescription}
    url={pageUrl}
    lang={lang}
    siteUrl={siteUrl + base}
    image={collectionImage}
    items={collectionItems}
  />
  <OrganizationSchema name={strings.site.name} siteUrl={siteUrl + base} logoUrl={logoUrl} />
  <WebSiteSchema name={strings.site.name} siteUrl={siteUrl + base} lang={lang} />
</BaseLayout>
