---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
const strings = t('en');
---
<BaseLayout lang="en" title={`Privacy Policy — ${strings.site.name}`} description="Privacy policy for FontAesthetic." path="/privacy-policy/">
  <section class="container prose page-content">
    <h1>Privacy Policy</h1>
    <p>FontAesthetic does not store the text you type into the font generator. All conversion happens directly in your browser.</p>
    <p>We may use basic, privacy-friendly analytics to understand site usage. We do not sell personal data to third parties.</p>
  </section>
</BaseLayout>
