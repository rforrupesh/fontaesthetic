---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { t } from '../i18n';

const strings = t('en');

// Change these to true only if these services are enabled on your website.
const usesGoogleAnalytics = false;
const usesGoogleAdsense = false;

---

<BaseLayout
  lang="en"
  title={`Privacy Policy — ${strings.site.name}`}
  description="Read the AestheticFonts Privacy Policy to learn how we handle visitor information, cookies, analytics, advertising and data privacy."
  path="/privacy-policy/"
>
  <PageHero
    title="Privacy Policy"
    subtitle="Last updated: November 9, 2026"
  />

  <section class="wrap py-10 max-w-[820px] mx-auto">

    <div class="mb-8">
      <p class="text-text-muted">
        Welcome to AestheticFonts (https://aestheticfonts.in/). Protecting the privacy of our visitors is important to us. This Privacy Policy explains what information may be collected when you visit our website, how that information is used and the choices available to you.
      </p>

      <p class="text-text-muted">
        AestheticFonts is a free online Unicode font generator and text styling tool. You can use our website to create fancy letters, stylish text and decorative characters without creating an account or signing in.
      </p>

      <p class="text-text-muted">
        By using our website, you agree to the practices described in this Privacy Policy. If you have any questions about how we handle information, you can contact us through our website.
      </p>
    </div>

    <div class="mb-8">
      <h2>Information We Collect</h2>

      <p class="text-text-muted">
        AestheticFonts does not require visitors to provide personal information such as their name, email address or phone number to use the font generator.
      </p>

      <p class="text-text-muted">
        The text you enter into our generator is processed in your browser to create different Unicode text styles. We do not intentionally collect or store the text you generate or copy through our tool.
      </p>

      <p class="text-text-muted">
        Like most websites, certain technical information may be collected automatically by our hosting provider and other services used to operate and protect the website. This information may include:
      </p>

      <ul class="text-text-muted list-disc pl-6 space-y-2">
        <li>IP address and general location information.</li>
        <li>Browser type and version.</li>
        <li>Device type and operating system.</li>
        <li>Pages visited and time spent on the website.</li>
        <li>Referring website or traffic source.</li>
        <li>Technical information related to website requests and security.</li>
      </ul>

      <p class="text-text-muted">
        This information is generally used for website operation, performance monitoring, troubleshooting and security purposes.
      </p>
    </div>

    <div class="mb-8">
      <h2>How We Use Information</h2>

      <p class="text-text-muted">
        Any information collected through our website or its service providers may be used for the following purposes:
      </p>

      <ul class="text-text-muted list-disc pl-6 space-y-2">
        <li>To operate and maintain AestheticFonts.</li>
        <li>To understand how visitors use our website.</li>
        <li>To improve website performance and user experience.</li>
        <li>To identify technical issues and fix errors.</li>
        <li>To protect the website against spam, abuse and security threats.</li>
        <li>To display advertisements, where applicable.</li>
      </ul>

      <p class="text-text-muted">
        We do not sell or rent personal information to third parties. We only use information for legitimate website operations and the purposes described in this policy.
      </p>
    </div>

    <div class="mb-8">
      <h2>Cookies and Similar Technologies</h2>

      <p class="text-text-muted">
        Cookies are small text files that websites may store on your device when you visit them. They help websites remember certain information and improve the browsing experience.
      </p>

      <p class="text-text-muted">
        AestheticFonts and its third-party service providers may use cookies or similar technologies for purposes such as:
      </p>

      <ul class="text-text-muted list-disc pl-6 space-y-2">
        <li>Understanding website traffic and visitor behaviour.</li>
        <li>Remembering certain website preferences.</li>
        <li>Measuring website performance.</li>
        <li>Displaying and measuring advertisements, where applicable.</li>
        <li>Maintaining website security and preventing abuse.</li>
      </ul>

      <p class="text-text-muted">
        You can manage or disable cookies through your browser settings. Please note that blocking certain cookies may affect how some third-party services work.
      </p>
    </div>

    {usesGoogleAnalytics && (
      <div class="mb-8">
        <h2>Google Analytics</h2>

        <p class="text-text-muted">
          We use Google Analytics to understand how visitors interact with AestheticFonts. This service may collect information such as pages visited, approximate location, browser type, device information and time spent on the website.
        </p>

        <p class="text-text-muted">
          We use these insights to understand visitor activity and improve our website and its features.
        </p>

        <p class="text-text-muted">
          Learn more about how Google uses information from websites that use its services:
          {' '}
          <a href="https://policies.google.com/technologies/partner-sites" target="_blank" rel="noopener noreferrer">Google's Partner Sites Policy</a>.
        </p>

        <p class="text-text-muted">
          You can also opt out of Google Analytics using the
          {' '}
          <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer">Google Analytics Opt-out Browser Add-on</a>.
        </p>
      </div>
    )}

    {usesGoogleAdsense && (
      <div class="mb-8">
        <h2>Advertising and Google AdSense</h2>

        <p class="text-text-muted">
          We may display advertisements through Google AdSense to help support the operation and maintenance of AestheticFonts and keep our tool free to use.
        </p>

        <p class="text-text-muted">
          Google and its advertising partners may use cookies or similar technologies to display, personalise and measure advertisements based on your visits to this and other websites, subject to your settings and applicable consent requirements.
        </p>

        <p class="text-text-muted">
          You can manage your Google advertising preferences through
          {' '}
          <a href="https://adssettings.google.com/" target="_blank" rel="noopener noreferrer">Google Ads Settings</a>.
        </p>

        <p class="text-text-muted">
          You can also learn about advertising choices through
          {' '}
          <a href="https://www.aboutads.info/choices/" target="_blank" rel="noopener noreferrer">AboutAds.info</a>.
        </p>
      </div>
    )}

    <div class="mb-8">
      <h2>Third-Party Services</h2>

      <p class="text-text-muted">
        We may rely on third-party providers for website hosting, security, analytics and other technical services. These providers may process certain technical information as needed to perform their services.
      </p>

      <p class="text-text-muted">
        Third-party websites and services operate under their own privacy policies. We recommend reviewing their policies to understand how they handle information. AestheticFonts does not control the privacy practices of external websites.
      </p>
    </div>

    <div class="mb-8">
      <h2>Data Security</h2>

      <p class="text-text-muted">
        We take reasonable steps to protect our website and any information processed through the services we use. These measures may include website security features, technical monitoring and protection against unauthorised access or misuse.
      </p>

      <p class="text-text-muted">
        However, no method of transmitting or storing information over the Internet is completely secure. While we work to protect information, we cannot guarantee absolute security.
      </p>
    </div>

    <div class="mb-8">
      <h2>Children's Privacy</h2>

      <p class="text-text-muted">
        AestheticFonts is a general-purpose text styling tool and is not specifically directed at children under the age of 13. We do not knowingly request or collect personal information from children under 13.
      </p>

      <p class="text-text-muted">
        If you believe that a child has provided personal information through our website, please contact us so that we can review the matter and take appropriate action.
      </p>
    </div>

    <div class="mb-8">
      <h2>Your Privacy Rights</h2>

      <p class="text-text-muted">
        Depending on your location and applicable privacy laws, you may have certain rights regarding your personal information. These rights may include:
      </p>

      <ul class="text-text-muted list-disc pl-6 space-y-2">
        <li>The right to know what personal information is collected.</li>
        <li>The right to request access to your personal information.</li>
        <li>The right to request correction or deletion of eligible personal information.</li>
        <li>The right to object to or restrict certain data processing.</li>
        <li>The right to opt out of certain targeted advertising or data-sharing activities, where applicable.</li>
      </ul>

      <p class="text-text-muted">
        AestheticFonts does not sell personal information. You can also manage cookies and certain tracking preferences through your browser and available third-party privacy controls.
      </p>
    </div>

    <div class="mb-8">
      <h2>External Links</h2>

      <p class="text-text-muted">
        Our website may contain links to external websites or services for additional information. Once you leave AestheticFonts, the privacy policy of the external website will apply. We are not responsible for the content, security or privacy practices of third-party websites.
      </p>
    </div>

    <div class="mb-8">
      <h2>Changes to This Privacy Policy</h2>

      <p class="text-text-muted">
        We may update this Privacy Policy from time to time to reflect changes in our website, services or applicable privacy requirements.
      </p>

      <p class="text-text-muted">
        Whenever we make changes, we will publish the updated policy on this page and revise the last updated date. We encourage visitors to review this page periodically to stay informed about our privacy practices.
      </p>
    </div>

    <div class="mb-8">
      <h2>Contact Us</h2>

      <p class="text-text-muted">
        If you have any questions, concerns or requests regarding this Privacy Policy or the way AestheticFonts handles information, please contact us through our Contact page.
      </p>

      <p class="text-text-muted">
        Website: https://aestheticfonts.in/
      </p>
    </div>

    <p class="text-text-muted text-center">
      Thank you for using AestheticFonts. Your privacy matters to us.
    </p>

  </section>
</BaseLayout>
