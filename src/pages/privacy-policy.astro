---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { t, getPath } from '../i18n';

const strings = t('en');

const usesGoogleAnalytics = false;
const usesGoogleAdsense = false;
const usesCloudflare = true;

---

<BaseLayout
  lang="en"
  title={`Privacy Policy — ${strings.site.name}`}
  description="Read the AestheticFonts Privacy Policy to understand how we handle visitor information, cookies, analytics, advertising and data privacy."
  path="/privacy-policy/"
>
  <PageHero
    title="Privacy Policy"
    subtitle="Last updated: November 9, 2026"
  />

  <section class="wrap py-10 max-w-[820px] mx-auto">

    <div class="mb-8">
      <p class="text-text-muted">
        Welcome to AestheticFonts (https://aestheticfonts.in/). Protecting the privacy of our visitors is important to us. This Privacy Policy explains what information may be collected when you visit our website, how that information is used, and the choices available to you regarding your data.
      </p>

      <p class="text-text-muted">
        AestheticFonts is a free online Unicode Font Generator and Text Styling Tool. It allows visitors to transform ordinary text into stylish letters, fancy fonts and decorative Unicode characters that can be copied and pasted into different applications and websites.
      </p>

      <p class="text-text-muted">
        You can use our font generator without creating an account, signing in or providing personal information directly to us. By accessing or using our website, you acknowledge the practices described in this Privacy Policy.
      </p>
    </div>

    <div class="mb-8">
      <h2>Information We Collect</h2>

      <p class="text-text-muted">
        AestheticFonts does not require visitors to register or provide personal details such as their name, email address or phone number to use the font generator.
      </p>

      <p class="text-text-muted">
        The text you enter into our font generator is processed directly in your browser to create different Unicode text styles. We do not intentionally collect or store the text you type, generate or copy through the tool.
      </p>

      <p class="text-text-muted">
        Like most websites, certain technical information may be collected automatically by our hosting provider and other third-party services. Depending on the services enabled, this information may include:
      </p>

      <ul class="text-text-muted list-disc pl-6 space-y-2">
        <li>IP address and approximate geographic location.</li>
        <li>Browser type, version and language.</li>
        <li>Device type and operating system.</li>
        <li>Pages visited and time spent on the website.</li>
        <li>Referring website and traffic source.</li>
        <li>Technical information about website requests.</li>
        <li>Information related to website performance and security.</li>
      </ul>

      <p class="text-text-muted">
        This information helps us understand website activity, maintain the service and identify potential technical or security issues.
      </p>
    </div>

    <div class="mb-8">
      <h2>How We Use Your Information</h2>

      <p class="text-text-muted">
        Information collected through AestheticFonts or its service providers may be used for the following purposes:
      </p>

      <ul class="text-text-muted list-disc pl-6 space-y-2">
        <li>To operate and maintain our website and font generator.</li>
        <li>To understand how visitors interact with different pages and features.</li>
        <li>To improve website speed, usability and performance.</li>
        <li>To identify technical problems and fix website errors.</li>
        <li>To protect the website against spam, abuse and security threats.</li>
        <li>To display and measure advertisements, where applicable.</li>
        <li>To maintain the reliability and availability of our services.</li>
      </ul>

      <p class="text-text-muted">
        We do not sell or rent personal information to third parties. Information is used for legitimate website operations and the purposes explained in this policy.
      </p>
    </div>

    <div class="mb-8">
      <h2>Cookies and Similar Technologies</h2>

      <p class="text-text-muted">
        Cookies are small text files that websites may store on your device when you visit them. They can help websites remember preferences, understand visitor activity and provide certain features.
      </p>

      <p class="text-text-muted">
        AestheticFonts and its third-party service providers may use cookies, local storage or similar technologies for purposes such as:
      </p>

      <ul class="text-text-muted list-disc pl-6 space-y-2">
        <li>Understanding website traffic and visitor behaviour.</li>
        <li>Remembering certain website preferences.</li>
        <li>Measuring website performance.</li>
        <li>Displaying and measuring advertisements, where applicable.</li>
        <li>Maintaining website security and preventing fraudulent activity.</li>
      </ul>

      <p class="text-text-muted">
        You can manage or disable cookies through your browser settings. However, blocking certain cookies may affect the operation of some website features or third-party services.
      </p>

      <p class="text-text-muted">
        For more information about cookies and Google's use of them, visit
        <a href="https://policies.google.com/technologies/cookies" target="_blank" rel="noopener noreferrer">Google's Cookie Policy</a>.
      </p>
    </div>

    {usesGoogleAnalytics && (
      <div class="mb-8">
        <h2>Google Analytics</h2>

        <p class="text-text-muted">
          We use Google Analytics to understand how visitors interact with AestheticFonts. This service may collect information such as pages visited, approximate location, browser type, device information, referral sources and time spent on the website.
        </p>

        <p class="text-text-muted">
          We use these insights to understand visitor activity, identify popular content and improve the website experience.
        </p>

        <p class="text-text-muted">
          Learn more about how Google uses information from websites and applications that use its services:
          {' '}
          <a href="https://policies.google.com/technologies/partner-sites" target="_blank" rel="noopener noreferrer">How Google Uses Information</a>.
        </p>

        <p class="text-text-muted">
          You can opt out of Google Analytics using the
          {' '}
          <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer">Google Analytics Opt-out Browser Add-on</a>.
        </p>
      </div>
    )}

    {usesGoogleAdsense && (
      <div class="mb-8">
        <h2>Advertising and Google AdSense</h2>

        <p class="text-text-muted">
          We may display advertisements through Google AdSense to help support the operation and maintenance of AestheticFonts and keep our font generator free to use.
        </p>

        <p class="text-text-muted">
          Google and its advertising partners may use cookies or similar technologies to display, personalise and measure advertisements based on your visits to this and other websites, subject to your settings and applicable consent requirements.
        </p>

        <p class="text-text-muted">
          You can manage your Google advertising preferences through
          {' '}
          <a href="https://adssettings.google.com/" target="_blank" rel="noopener noreferrer">Google Ads Settings</a>.
        </p>

        <p class="text-text-muted">
          You can also learn about advertising choices through
          {' '}
          <a href="https://www.aboutads.info/choices/" target="_blank" rel="noopener noreferrer">About Ads Choices</a>.
        </p>

        <p class="text-text-muted">
          For more details about how Google handles advertising information, visit
          {' '}
          <a href="https://policies.google.com/technologies/ads" target="_blank" rel="noopener noreferrer">Google Advertising Policies</a>.
        </p>
      </div>
    )}

    {usesCloudflare && (
      <div class="mb-8">
        <h2>Cloudflare and Website Security</h2>

        <p class="text-text-muted">
          We may use Cloudflare services to help deliver website content, improve performance and protect AestheticFonts against malicious traffic and security threats.
        </p>

        <p class="text-text-muted">
          Cloudflare may process certain technical information, including IP addresses and browser-related data, when visitors access our website. This processing helps provide network security, traffic management and performance services.
        </p>

        <p class="text-text-muted">
          For more information, read the
          {' '}
          <a href="https://www.cloudflare.com/privacypolicy/" target="_blank" rel="noopener noreferrer">Cloudflare Privacy Policy</a>.
        </p>
      </div>
    )}

    <div class="mb-8">
      <h2>Third-Party Services and External Links</h2>

      <p class="text-text-muted">
        We may rely on third-party providers for website hosting, security, analytics, advertising and other technical services. These providers may process certain information as necessary to provide their services.
      </p>

      <p class="text-text-muted">
        Our website may also contain links to external websites and resources. Once you visit another website, its own privacy policy and terms apply. We do not control the privacy practices, content or security of external websites.
      </p>

      <p class="text-text-muted">
        We recommend reviewing the privacy policies of third-party services before using them.
      </p>
    </div>

    <div class="mb-8">
      <h2>Data Security</h2>

      <p class="text-text-muted">
        We take reasonable technical and organisational measures to protect our website and the information processed through the services we use. These measures may include security features, technical monitoring and protection against unauthorised access or misuse.
      </p>

      <p class="text-text-muted">
        However, no method of transmitting or storing information over the Internet is completely secure. While we work to protect information, we cannot guarantee absolute security.
      </p>
    </div>

    <div class="mb-8">
      <h2>Children's Privacy</h2>

      <p class="text-text-muted">
        AestheticFonts is a general-purpose text styling tool and is not specifically directed at children under the age of 13. We do not knowingly request or collect personal information from children under 13.
      </p>

      <p class="text-text-muted">
        If you believe that a child has provided personal information through our website, please contact us so that we can review the matter and take appropriate action.
      </p>
    </div>

    <div class="mb-8">
      <h2>Your Privacy Rights</h2>

      <p class="text-text-muted">
        Depending on your location and applicable privacy laws, you may have certain rights regarding your personal information. These rights may include:
      </p>

      <ul class="text-text-muted list-disc pl-6 space-y-2">
        <li>The right to know what personal information is collected about you.</li>
        <li>The right to request access to your personal information.</li>
        <li>The right to request correction of inaccurate information.</li>
        <li>The right to request deletion of eligible personal information.</li>
        <li>The right to object to or restrict certain data processing activities.</li>
        <li>The right to opt out of certain targeted advertising or data-sharing activities, where applicable.</li>
      </ul>

      <p class="text-text-muted">
        AestheticFonts does not sell personal information. You can also manage cookies and certain advertising preferences through your browser and available third-party privacy controls.
      </p>
    </div>

    <div class="mb-8">
      <h2>International Visitors</h2>

      <p class="text-text-muted">
        AestheticFonts may be accessed by visitors from different countries. Depending on the location of our hosting provider and third-party service providers, certain technical information may be processed in countries other than your own.
      </p>

      <p class="text-text-muted">
        Where applicable, such processing is subject to relevant data protection requirements and the policies of the service providers involved.
      </p>
    </div>

    <div class="mb-8">
      <h2>Changes to This Privacy Policy</h2>

      <p class="text-text-muted">
        We may update this Privacy Policy from time to time to reflect changes in our website, services, technologies or applicable privacy requirements.
      </p>

      <p class="text-text-muted">
        Any updates will be published on this page along with a revised last updated date. We encourage visitors to review this page periodically to stay informed about our privacy practices.
      </p>
    </div>

    <div class="mb-8">
      <h2>Useful Privacy Resources</h2>

      <p class="text-text-muted">
        The following official resources provide additional information about privacy, cookies, advertising and data protection:
      </p>

      <ul class="text-text-muted list-disc pl-6 space-y-2">
        <li>
          <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Google Privacy Policy</a>
        </li>
        <li>
          <a href="https://policies.google.com/technologies/partner-sites" target="_blank" rel="noopener noreferrer">How Google Uses Information</a>
        </li>
        <li>
          <a href="https://policies.google.com/technologies/cookies" target="_blank" rel="noopener noreferrer">Google Cookie Policy</a>
        </li>
        <li>
          <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer">Google Analytics Opt-out</a>
        </li>
        <li>
          <a href="https://adssettings.google.com/" target="_blank" rel="noopener noreferrer">Google Ads Settings</a>
        </li>
        <li>
          <a href="https://www.aboutads.info/choices/" target="_blank" rel="noopener noreferrer">About Ads Choices</a>
        </li>
        <li>
          <a href="https://www.cloudflare.com/privacypolicy/" target="_blank" rel="noopener noreferrer">Cloudflare Privacy Policy</a>
        </li>
        <li>
          <a href="https://www.unicode.org/standard/standard.html" target="_blank" rel="noopener noreferrer">Unicode Standard</a>
        </li>
      </ul>
    </div>

    <div class="mb-8">
      <h2>Contact Us</h2>

      <p class="text-text-muted">
        If you have any questions, concerns or requests regarding this Privacy Policy or the way AestheticFonts handles information, you can contact us through our website's
        <a href={getPath('en', '/contact/')} class="text-primary underline underline-offset-2 hover:text-primary-hover transition-colors duration-150">Contact page</a>.
      </p>

      <p class="text-text-muted">
        Website:
        <a href="https://aestheticfonts.in/" target="_blank" rel="noopener noreferrer">https://aestheticfonts.in/</a>
      </p>
    </div>

    <p class="text-text-muted text-center">
      Thank you for visiting AestheticFonts. Your privacy matters to us.
    </p>

  </section>
</BaseLayout>
