---
import BaseLayout from '../layouts/BaseLayout.astro';
import en from '../i18n/en.json';
---
<BaseLayout lang="en" title={en.pages.privacy_title} description={en.meta.home_description} path="/privacy-policy/">
  <div class="card page-card">
    <h1>{en.pages.privacy_title}</h1>
    <p>We do not store the text you type into the font generator tool. All conversion happens locally in your browser.</p>
    <p>We may use basic analytics to understand site usage. We do not sell personal data to third parties.</p>
  </div>
</BaseLayout>
