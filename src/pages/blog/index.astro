---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import en from '../../i18n/en.json';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((p) => p.id.startsWith('en/'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const sidebarPosts = posts.map((p) => ({
  title: p.data.title,
  href: `${base}blog/${p.data.slug ?? p.id.replace('en/', '').replace(/\.md$/, '')}/`
}));
---
<BaseLayout lang="en" title={en.meta.blog_title} description={en.meta.blog_description} path="/blog/">
  <div class="blog-layout">
    <div class="blog-main">
      <h1>{en.nav.blog}</h1>
      {posts.map((post) => {
        const slug = post.data.slug ?? post.id.replace('en/', '').replace(/\.md$/, '');
        return (
          <a href={`${base}blog/${slug}/`} class="card blog-card">
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
          </a>
        );
      })}
    </div>
    <Sidebar lang="en" posts={sidebarPosts} />
  </div>
</BaseLayout>
