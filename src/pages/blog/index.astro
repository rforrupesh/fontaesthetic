---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import en from '../../i18n/en.json';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((p) => p.id.startsWith('en/'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const sidebarPosts = posts.map((p) => ({
  title: p.data.title,
  href: `${base}blog/${p.data.slug ?? p.id.replace('en/', '').replace(/\.md$/, '')}/`
}));
---
<BaseLayout lang="en" title={en.meta.blog_title} description={en.meta.blog_description} path="/blog/">
  <div style="display:flex; gap:24px; align-items:flex-start; flex-wrap:wrap;">
    <div style="flex:1; min-width:280px; display:flex; flex-direction:column; gap:16px;">
      <h1 style="margin-top:0;">{en.nav.blog}</h1>
      {posts.map((post) => {
        const slug = post.data.slug ?? post.id.replace('en/', '').replace(/\.md$/, '');
        return (
          <a href={`${base}blog/${slug}/`} class="card" style="text-decoration:none; color:inherit; display:block;">
            <h2 style="margin:0 0 8px;">{post.data.title}</h2>
            <p style="margin:0; color:#aaa;">{post.data.description}</p>
          </a>
        );
      })}
    </div>
    <Sidebar lang="en" posts={sidebarPosts} />
  </div>
</BaseLayout>
