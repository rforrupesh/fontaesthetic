---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import { getCollection, render } from 'astro:content';
import { t } from '../../i18n';

const lang = 'en';
const strings = t(lang);

export async function getStaticPaths() {
  const posts = await getCollection('blog', (e) => e.id.startsWith('en/'));
  return posts.map((post) => {
    const slug = post.data.slug ?? post.id.split('/').slice(1).join('/');
    return { params: { slug }, props: { post } };
  });
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const allPosts = await getCollection('blog', (e) => e.id.startsWith('en/'));
const related = allPosts
  .filter((p) => p.id !== post.id)
  .filter((p) => p.data.tags.some((tag) => post.data.tags.includes(tag)))
  .slice(0, 3)
  .map((p) => ({
    title: p.data.title,
    description: p.data.description,
    image: p.data.image,
    slug: p.data.slug ?? p.id.split('/').slice(1).join('/'),
  }));

// Find the equivalent article in every other language via translationId,
// so canonical/hreflang tags and the language switcher point to the
// correct (possibly differently-slugged) translated URL.
const allLangs = ['en', 'fr', 'hi'];
const alternates: Record<string, string> = {};
for (const l of allLangs) {
  const postsInLang = l === lang ? allPosts : await getCollection('blog', (e) => e.id.startsWith(`${l}/`));
  const match = postsInLang.find((p) => p.data.translationId === post.data.translationId);
  if (match) {
    const slugL = match.data.slug ?? match.id.split('/').slice(1).join('/');
    alternates[l] = `/blog/${slugL}/`;
  }
}
---

<BaseLayout
  lang={lang}
  title={`${post.data.title} — ${strings.site.name}`}
  description={post.data.description}
  path={`/blog/${post.data.slug ?? post.id.split('/').slice(1).join('/')}/`}
  alternates={alternates}
  image={post.data.image}
>
  <article class="container post-layout">
    <div class="post-main">
      <header class="post-header">
        <h1>{post.data.title}</h1>
        <p class="post-meta">
          {strings.blog.publishedOn} {post.data.date.toLocaleDateString(lang)}
        </p>
        {post.data.image && <img class="post-cover" src={post.data.image} alt={post.data.title} />}
      </header>
      <div class="prose">
        <Content />
      </div>

      <RelatedPosts lang={lang} posts={related} />
    </div>

    <Sidebar lang={lang} headings={headings} />
  </article>
</BaseLayout>

<style>
  .post-layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 3rem;
    padding: 2.5rem 1.25rem 4rem;
    align-items: start;
  }
  .post-main { min-width: 0; }
  .post-header { margin-bottom: 1.5rem; }
  .post-header h1 { font-size: clamp(1.6rem, 4vw, 2.2rem); margin-bottom: .5rem; }
  .post-meta { color: var(--color-text-muted); font-size: .88rem; }
  .post-cover { border-radius: var(--radius); margin-top: 1rem; width: 100%; aspect-ratio: 16/9; object-fit: cover; }

  aside.sidebar { position: sticky; top: calc(var(--header-h) + 20px); }

  @media (max-width: 900px) {
    .post-layout { grid-template-columns: 1fr; }
    aside.sidebar { position: static; }
  }
</style>
