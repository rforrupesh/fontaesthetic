---
import BaseLayout from '../layouts/BaseLayout.astro';
import FancyTextTool from '../components/FancyTextTool.astro';
---
<BaseLayout
  title="Fancy Text Generator — Unicode Font Styles for aesthetic, bold, italic, bubble, gothic text"
  description="Generate aesthetic unicode text: bold, italic, script, gothic, bubble, circled, upside down and 30+ more font styles. Every style is real text on the page — copy with one click."
  lang="en"
  path="/fancy-text/"
>
  <FancyTextTool
    title="Fancy Text Generator"
    intro="Type your text once — every style below updates in place. Each style is its own real, readable div, not something drawn after the fact, so it copies, pastes, and reads cleanly everywhere including search results."
  />
</BaseLayout>
