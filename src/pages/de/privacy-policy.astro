---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { t, getPath } from '../../i18n';
const strings = t('de');

const sections = [
  {
    title: "Was wir erfassen",
    text: "AestheticFonts speichert den Text, den du in den Schriftgenerator eingibst, nicht. Die gesamte Umwandlung erfolgt direkt in deinem Browser.",
  },
  {
    title: "Analyse",
    text: "Wir können einfache, datenschutzfreundliche Analysetools verwenden, um die Nutzung der Website zu verstehen. Wir verkaufen keine personenbezogenen Daten an Dritte.",
  },
];
---
<BaseLayout lang="de" title={`Datenschutzerklärung — ${strings.site.name}`} description="Datenschutzerklärung von AestheticFonts." path="/privacy-policy/">
  <PageHero title="Datenschutzerklärung" subtitle="Zuletzt aktualisiert: Januar 2026" />

  <section class="wrap py-10 max-w-[680px] mx-auto flex flex-col gap-5">
    {sections.map((s) => (
      <div class="card p-5">
        <h2 class="text-[1.05rem] mb-2">{s.title}</h2>
        <p class="text-text-muted m-0">{s.text}</p>
      </div>
    ))}

    <p class="text-text-muted text-center mt-2">
      Hast du eine Frage oder einen Vorschlag?
      <a href={getPath('de', '/contact/')} class="text-primary underline underline-offset-2 hover:text-primary-hover transition-colors duration-150">{strings.footer.contact}</a>
    </p>
  </section>
</BaseLayout>
