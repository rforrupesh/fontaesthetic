---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import { t } from '../../i18n';
const strings = t('de');
---
<BaseLayout lang="de" title={`Kontakt — ${strings.site.name}`} description="Nimm Kontakt mit dem AestheticFonts-Team auf." path="/contact/">
  <PageHero
    title="Kontaktiere uns"
    subtitle="Hast du eine Frage, einen Vorschlag oder einen Fehler gefunden? Wir freuen uns auf deine Nachricht."
  />

  <section class="wrap py-10 max-w-[520px] mx-auto text-center">
    <div class="card p-6">
      <div class="w-10 h-10 rounded-md bg-primary/15 text-primary flex items-center justify-center mx-auto mb-4">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m3 7 9 6 9-6" />
        </svg>
      </div>
      <p class="text-text-muted mb-1.5 text-[.85rem]">Schreib uns an</p>
      <button
        id="showEmailBtn"
        type="button"
        class="text-primary text-[1.05rem] font-semibold hover:text-primary-hover transition-colors duration-150"
      >
        E-Mail-Adresse anzeigen
      </button>

      <p id="emailDisplay" class="mt-2" hidden></p>
    </div>

    <p class="text-text-muted text-[.85rem] mt-8 mb-3">Oder finde uns hier</p>
    <div class="flex justify-center">
      <SocialLinks size="md" />
    </div>
  </section>

  <script>
    const emailCodes = [
      114, 117, 112, 101, 115, 104, 107, 117, 109, 97, 114,
      52, 55, 55, 53,
      64, 103, 109, 97, 105, 108, 46, 99, 111, 109
    ];

    const button = document.getElementById('showEmailBtn');
    const display = document.getElementById('emailDisplay');

    button?.addEventListener('click', () => {
      const email = String.fromCharCode(...emailCodes);

      const link = document.createElement('a');
      link.href = `mailto:${email}`;
      link.textContent = email;
      link.className =
        'text-primary font-semibold hover:text-primary-hover transition-colors duration-150';

      display?.replaceChildren(link);

      if (display) {
        display.hidden = false;
      }

      button.textContent = 'E-Mail-Adresse';
      button.setAttribute('aria-expanded', 'true');
    });
  </script>
</BaseLayout>
