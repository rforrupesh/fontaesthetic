---
import UnderlinePage from '../components/UnderlinePage.astro';

const styles = [
  { title: 'Single Underline', body: 'Single underline places one horizontal line beneath individual characters. It is the standard underline appearance used in many text editors and word-processing applications.' },
  { title: 'Double Underline', body: 'Double underline displays two lines beneath the characters. It is an alternative to the single-line style and is used for distinctive text presentation.' },
  { title: 'Wavy Underline', body: 'Wavy underline produces a curved line pattern beneath letters. It differs from straight underline styles and is commonly used for decorative text.' },
  { title: 'Additional Underline Styles', body: 'Other underline variations use different Unicode combining marks to create alternative line patterns. These designs can be applied to words, names, and short phrases.' },
];
const extra = [
  { title: 'User-Friendly Language Support', body: 'The generator supports text written in English, Spanish, French, Indonesian, Portuguese, German, and other languages using Latin-based alphabets. Unicode combining marks can be applied to compatible letters without translating the original text. Display results may vary for accented characters and other special letters.' },
  { title: 'Multiple Methods of Underlining', body: 'Underlining can be produced through text-formatting options or Unicode combining characters. Applications such as Microsoft Word use formatting properties to place a line beneath selected text. Unicode-based methods instead combine special characters with ordinary letters, producing text that can be copied into compatible platforms.' },
];
const where = [
  { label: 'Social Media Bios:', body: 'Underline names, profile descriptions, and selected words.' },
  { label: 'Captions and Comments:', body: 'Apply underline effects to words and phrases in social media posts.' },
  { label: 'Online Chats:', body: 'Use underlined characters in messages and conversations.' },
  { label: 'Gaming Profiles:', body: 'Style display names and profile descriptions where Unicode characters are permitted.' },
  { label: 'Status Messages:', body: 'Create underlined text for personal updates and short messages.' },
];
const faqs = [
  { question: 'How to make text underlined?', answer: 'Enter your text in the generator, select an underline style, and copy the converted result. You can then paste it into a compatible application or website.' },
  { question: 'Can I use underline text without formatting?', answer: 'Yes. Unicode combining characters create an underline-like appearance without requiring the conventional formatting options of a text editor. The result can be copied and pasted as Unicode text.' },
  { question: 'Is the Underline Text Generator free to use?', answer: 'Yes. The tool is free to use and does not require payment or account registration to generate and copy underlined text.' },
  { question: 'Can I use underlined text in my social media username?', answer: 'This depends on the platform\'s username requirements. Some platforms accept Unicode combining characters, while others restrict special characters or specific combinations.' },
];
---

<UnderlinePage lang="en">
  <article class="wrap max-w-[900px] mx-auto py-10 text-text">
    <!-- Intro -->
    <header class="text-center mb-12">
      <h2 class="text-[clamp(1.6rem,3.4vw,2.2rem)] font-bold mb-4">Underlined Text Copy and Paste</h2>
      <p class="text-text-muted text-[1.05rem] leading-[1.8]">Underlined text is a form of text styling in which a horizontal line appears beneath letters, words, or sentences. It can be created using Unicode combining characters, which allow styled text to be copied and pasted into compatible applications. An underline is commonly used to distinguish text, mark headings, or emphasize particular words.</p>
    </header>

    <!-- What is -->
    <section class="mb-12 rounded-2xl border border-border bg-surface p-6 md:p-8">
      <h2 class="text-2xl font-bold mb-3">What Is Underline Text?</h2>
      <p class="text-text-muted leading-[1.8] mb-4">Underline text refers to characters displayed with a line beneath them. In traditional typography, underlining is applied through formatting options in word processors and text editors. Unicode-based underlining uses combining marks, such as the Combining Low Line (U+0332), to produce a similar appearance.</p>
      <p class="text-text-muted leading-[1.8]">These marks are placed alongside regular characters to create different line patterns. Depending on the Unicode characters used, the result may include single, double, or wavy underlines. Unlike conventional formatting, the resulting appearance is represented through text characters rather than a separate formatting property.</p>
    </section>

    <!-- Why use -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-2">Why Use Our Underline Generator Tool?</h2>
      <p class="text-text-muted leading-[1.8] mb-6">The Underline Text Generator converts ordinary text into Unicode-based underline variations. It provides different designs, allowing users to select and copy a suitable version without manually inserting combining characters.</p>
      <div class="grid gap-4 sm:grid-cols-2">
        {styles.map((f, i) => (
          <div class="card p-5 transition-colors duration-150 hover:border-primary">
            <h3 class="text-lg font-semibold mb-2"><span class="text-primary">{i + 1}.</span> {f.title}</h3>
            <p class="text-sm text-text-muted leading-[1.7]">{f.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Extra features -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-6">Extra Features of Underlined Text</h2>
      <div class="grid gap-4 md:grid-cols-2">
        {extra.map((f) => (
          <div class="card p-5 border-t-4 border-t-primary">
            <h3 class="text-lg font-semibold mb-2">{f.title}</h3>
            <p class="text-sm text-text-muted leading-[1.7]">{f.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Where to use -->
    <section class="mb-4">
      <h2 class="text-2xl font-bold mb-3">Where to Use Underline Text</h2>
      <p class="text-text-muted leading-[1.8] mb-5">Unicode underlined text can be used in applications and websites that support the relevant combining characters. Common uses include:</p>
      <ul class="list-none p-0 m-0 flex flex-col gap-3 mb-6">
        {where.map((w) => (
          <li class="card px-5 py-3.5 text-sm leading-[1.7]"><strong class="font-semibold">{w.label}</strong> <span class="text-text-muted">{w.body}</span></li>
        ))}
      </ul>
      <p class="text-text-muted leading-[1.8]">Unicode rendering depends on the application, operating system, and available fonts. Some platforms may display combining marks differently or restrict their use in usernames. Therefore, compatibility should be checked in the destination application.</p>
    </section>
  </article>

  <section class="wrap max-w-[900px] mx-auto pb-12">
    <h2 class="text-2xl font-bold mb-5 text-center">FAQ</h2>
    <div class="max-w-[720px] mx-auto flex flex-col gap-3">
      {faqs.map((item) => (
        <details class="card px-5 py-4 group">
          <summary class="cursor-pointer list-none flex items-center justify-between gap-4 font-medium text-[.95rem]">
            {item.question}
            <span class="shrink-0 text-text-muted transition-transform duration-200 group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 text-[.9rem] text-text-muted leading-[1.7]">{item.answer}</p>
        </details>
      ))}
    </div>
  </section>
</UnderlinePage>
