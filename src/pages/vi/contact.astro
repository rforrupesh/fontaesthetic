---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import { t } from '../../i18n';
const strings = t('vi');
---
<BaseLayout lang="vi" title={`Liên hệ — ${strings.site.name}`} description="Liên hệ với đội ngũ AestheticFonts." path="/contact/">
  <PageHero
    title="Liên hệ với chúng tôi"
    subtitle="Bạn có câu hỏi, đề xuất hoặc phát hiện lỗi? Chúng tôi rất muốn nghe từ bạn."
  />

  <section class="wrap py-10 max-w-[520px] mx-auto text-center">
    <div class="card p-6">
      <div class="w-10 h-10 rounded-md bg-primary/15 text-primary flex items-center justify-center mx-auto mb-4">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m3 7 9 6 9-6" />
        </svg>
      </div>
      <p class="text-text-muted mb-1.5 text-[.85rem]">Gửi email cho chúng tôi tại</p>
      <a href="mailto:hello@aestheticfonts.example" class="text-primary text-[1.05rem] font-semibold hover:text-primary-hover transition-colors duration-150">
        hello@aestheticfonts.example
      </a>
    </div>

    <p class="text-text-muted text-[.85rem] mt-8 mb-3">Hoặc tìm chúng tôi tại đây</p>
    <div class="flex justify-center">
      <SocialLinks size="md" />
    </div>
  </section>
</BaseLayout>
