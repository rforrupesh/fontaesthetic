---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { t } from '../../i18n';
const strings = t('vi');

const features = [
  { title: "Không cần đăng ký", text: "Chỉ cần mở trang và bắt đầu gõ. Không cần tài khoản, không cần tải về." },
  { title: "Dùng được ở mọi nơi", text: "Dán vào Instagram, WhatsApp, Discord, Twitter/X và nhiều nơi khác." },
  { title: "Miễn phí 100%", text: "Không phí ẩn, không có gói trả phí, không bao giờ." },
];
---
<BaseLayout lang="vi" title={`Giới thiệu — ${strings.site.name}`} description="Tìm hiểu thêm về AestheticFonts, trình tạo phông chữ trực tuyến miễn phí." path="/about/">
  <PageHero
    title="Giới thiệu"
    subtitle="Trình tạo phông chữ trực tuyến miễn phí, biến văn bản thường thành các phông chữ Unicode phong cách để bạn sao chép và dán ở bất cứ đâu."
  />

  <section class="wrap py-10 max-w-[820px] mx-auto">
    <div class="grid sm:grid-cols-3 gap-5 mb-8">
      {features.map((f) => (
        <div class="card p-5">
          <div class="w-8 h-8 rounded-md bg-primary/15 text-primary flex items-center justify-center mb-3">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
          </div>
          <h3 class="text-[1.02rem] mb-1.5">{f.title}</h3>
          <p class="text-text-muted text-[.9rem] m-0">{f.text}</p>
        </div>
      ))}
    </div>

    <p class="text-text-muted text-center max-w-[560px] mx-auto">
      Dành cho người sáng tạo, nhà tiếp thị và bất kỳ ai muốn văn bản của mình nổi bật.
    </p>
  </section>
</BaseLayout>
