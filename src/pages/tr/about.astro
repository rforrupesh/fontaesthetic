---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { t } from '../../i18n';
const strings = t('tr');

const features = [
  { title: 'TODO_TR_FEATURE_1_TITLE', text: 'TODO_TR_FEATURE_1_TEXT' },
  { title: 'TODO_TR_FEATURE_2_TITLE', text: 'TODO_TR_FEATURE_2_TEXT' },
  { title: 'TODO_TR_FEATURE_3_TITLE', text: 'TODO_TR_FEATURE_3_TEXT' },
];
---
<BaseLayout lang="tr" title={`TODO_TR_ABOUT_TITLE — ${strings.site.name}`} description="TODO_TR_ABOUT_DESCRIPTION" path="/about/">
  <PageHero
    title="TODO_TR_ABOUT_HERO_TITLE"
    subtitle="TODO_TR_ABOUT_HERO_SUBTITLE"
  />

  <section class="wrap py-10 max-w-[820px] mx-auto">
    <div class="grid sm:grid-cols-3 gap-5 mb-8">
      {features.map((f) => (
        <div class="card p-5">
          <div class="w-8 h-8 rounded-md bg-primary/15 text-primary flex items-center justify-center mb-3">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
          </div>
          <h3 class="text-[1.02rem] mb-1.5">{f.title}</h3>
          <p class="text-text-muted text-[.9rem] m-0">{f.text}</p>
        </div>
      ))}
    </div>

    <p class="text-text-muted text-center max-w-[560px] mx-auto">
      TODO_TR_ABOUT_CLOSING_LINE
    </p>
  </section>
</BaseLayout>
