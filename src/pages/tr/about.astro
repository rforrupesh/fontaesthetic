---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { t } from '../../i18n';
const strings = t('tr');

const features = [
  { title: 'Kayıt gerektirmez', text: 'Sayfayı açın ve yazmaya başlayın. Hesap ya da indirme gerekmez.' },
  { title: 'Her yerde çalışır', text: 'Instagram, WhatsApp, Discord, Twitter/X ve daha fazlasına yapıştırın.' },
  { title: '%100 ücretsiz', text: 'Gizli ücret yok, premium teklif yok.' },
];
---
<BaseLayout lang="tr" title={`Hakkımızda — ${strings.site.name}`} description="AestheticFonts, ücretsiz font oluşturucu hakkında daha fazla bilgi edinin." path="/about/">
  <PageHero
    title="Hakkımızda"
    subtitle="Metninizi her yere kopyalayıp yapıştırabileceğiniz şık Unicode fontlara dönüştüren ücretsiz, çevrimiçi bir font oluşturucu."
  />

  <section class="wrap py-10 max-w-[820px] mx-auto">
    <div class="grid sm:grid-cols-3 gap-5 mb-8">
      {features.map((f) => (
        <div class="card p-5">
          <div class="w-8 h-8 rounded-md bg-primary/15 text-primary flex items-center justify-center mb-3">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
          </div>
          <h3 class="text-[1.02rem] mb-1.5">{f.title}</h3>
          <p class="text-text-muted text-[.9rem] m-0">{f.text}</p>
        </div>
      ))}
    </div>

    <p class="text-text-muted text-center max-w-[560px] mx-auto">
      İçerik üreticileri, pazarlamacılar ve metinlerinin öne çıkmasını isteyen herkes için tasarlandı.
    </p>
  </section>
</BaseLayout>
