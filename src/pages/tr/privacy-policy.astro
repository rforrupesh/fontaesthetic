---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { t } from '../../i18n';
const strings = t('tr');

const sections = [
  {
    title: 'TODO_TR_SECTION_1_TITLE',
    text: "TODO_TR_SECTION_1_TEXT",
  },
  {
    title: 'TODO_TR_SECTION_2_TITLE',
    text: "TODO_TR_SECTION_2_TEXT",
  },
];
---
<BaseLayout lang="tr" title={`TODO_TR_PRIVACY_TITLE — ${strings.site.name}`} description="TODO_TR_PRIVACY_DESCRIPTION" path="/privacy-policy/">
  <PageHero title="TODO_TR_PRIVACY_HERO_TITLE" subtitle="TODO_TR_PRIVACY_HERO_SUBTITLE" />

  <section class="wrap py-10 max-w-[680px] mx-auto flex flex-col gap-5">
    {sections.map((s) => (
      <div class="card p-5">
        <h2 class="text-[1.05rem] mb-2">{s.title}</h2>
        <p class="text-text-muted m-0">{s.text}</p>
      </div>
    ))}
  </section>
</BaseLayout>
