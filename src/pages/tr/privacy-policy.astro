---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { t } from '../../i18n';
const strings = t('tr');

const sections = [
  {
    title: 'Ne topluyoruz',
    text: "AestheticFonts, font oluşturucuya girdiğiniz metni saklamaz. Tüm dönüştürme işlemi doğrudan tarayıcınızda gerçekleşir.",
  },
  {
    title: 'Analitik',
    text: "Site kullanımını anlamak için gizliliğe saygılı, temel analiz araçları kullanabiliriz. Kişisel verileri üçüncü taraflara satmıyoruz.",
  },
];
---
<BaseLayout lang="tr" title={`Gizlilik Politikası — ${strings.site.name}`} description="AestheticFonts gizlilik politikası." path="/privacy-policy/">
  <PageHero title="Gizlilik Politikası" subtitle="Son güncelleme: Ocak 2026" />

  <section class="wrap py-10 max-w-[680px] mx-auto flex flex-col gap-5">
    {sections.map((s) => (
      <div class="card p-5">
        <h2 class="text-[1.05rem] mb-2">{s.title}</h2>
        <p class="text-text-muted m-0">{s.text}</p>
      </div>
    ))}
  </section>
</BaseLayout>
