---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FontTool from '../../components/FontTool.astro';
import FaqSection from '../../components/FaqSection.astro';
import SchemaOrg from '../../components/SchemaOrg.astro';
import { t, getPath } from '../../i18n';

const lang = 'tr';
const strings = t(lang);

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const base = import.meta.env.BASE_URL;
const pageUrl = siteUrl + getPath(lang, '/');
const logoUrl = `${siteUrl}${base}logo.svg`;
---

<BaseLayout
  lang={lang}
  title="TODO_TR_HOMEPAGE_TITLE"
  description="TODO_TR_HOMEPAGE_DESCRIPTION"
  path="/"
>
  <FontTool lang={lang} />

<article class="prose wrap max-w-[820px] mx-auto py-10">

  <!--
    TODO (Bobnk): Yaha apna Turkish homepage content manually daalo.
    fr/index.astro ki tarah <h2>, <p>, aur table structure use karna,
    bas Turkish text daalna. Design/classes touch mat karna.
  -->
  <p>TODO_TR_HOMEPAGE_CONTENT</p>

</article>

  <FaqSection lang={lang} />
  <SchemaOrg lang={lang} pageUrl={pageUrl} siteUrl={siteUrl + base} logoUrl={logoUrl} />
</BaseLayout>
