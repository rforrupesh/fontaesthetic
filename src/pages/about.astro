---
import BaseLayout from '../layouts/BaseLayout.astro';
import en from '../i18n/en.json';
---
<BaseLayout lang="en" title={en.pages.about_title} description={en.meta.home_description} path="/about/">
  <div class="card">
    <h1>{en.pages.about_title}</h1>
    <p>FontAesthetic is a free online tool that lets you generate stylish, bold, italic, cursive and unicode fonts instantly — no signup, no watermark, no hassle.</p>
    <p>We built this tool for creators, social media users and anyone who wants their text to stand out on Instagram, Discord, WhatsApp and more.</p>
  </div>
</BaseLayout>
