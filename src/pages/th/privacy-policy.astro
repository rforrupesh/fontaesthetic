---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { t } from '../../i18n';
const strings = t('th');

const sections = [
  {
    title: 'ข้อมูลที่เราเก็บ',
    text: 'เครื่องมือสร้างฟอนต์ AestheticFonts ไม่จัดเก็บข้อความที่คุณพิมพ์ การแปลงทั้งหมดเกิดขึ้นในเบราว์เซอร์ของคุณโดยตรง',
  },
  {
    title: 'การวิเคราะห์ข้อมูล',
    text: 'เราอาจใช้เครื่องมือวิเคราะห์พื้นฐานที่คำนึงถึงความเป็นส่วนตัวเพื่อทำความเข้าใจการใช้งานเว็บไซต์ เราไม่ขายข้อมูลส่วนบุคคลให้บุคคลที่สาม',
  },
];
---
<BaseLayout lang="th" title={`นโยบายความเป็นส่วนตัว — ${strings.site.name}`} description="นโยบายความเป็นส่วนตัวของ AestheticFonts" path="/privacy-policy/">
  <PageHero title="นโยบายความเป็นส่วนตัว" subtitle="อัปเดตล่าสุด: มกราคม 2026" />

  <section class="wrap py-10 max-w-[680px] mx-auto flex flex-col gap-5">
    {sections.map((s) => (
      <div class="card p-5">
        <h2 class="text-[1.05rem] mb-2">{s.title}</h2>
        <p class="text-text-muted m-0">{s.text}</p>
      </div>
    ))}
  </section>
</BaseLayout>
