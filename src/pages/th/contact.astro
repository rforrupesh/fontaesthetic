---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import { t } from '../../i18n';
const strings = t('th');
---
<BaseLayout lang="th" title={`ติดต่อเรา — ${strings.site.name}`} description="ติดต่อทีมงาน AestheticFonts" path="/contact/">
  <PageHero
    title="ติดต่อเรา"
    subtitle="มีคำถาม ข้อเสนอแนะ หรือเจอบั๊ก? เรายินดีรับฟังจากคุณ"
  />

  <section class="wrap py-10 max-w-[520px] mx-auto text-center">
    <div class="card p-6">
      <div class="w-10 h-10 rounded-md bg-primary/15 text-primary flex items-center justify-center mx-auto mb-4">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m3 7 9 6 9-6" />
        </svg>
      </div>
      <p class="text-text-muted mb-1.5 text-[.85rem]">อีเมลหาเรา</p>
      <button
        id="showEmailBtn"
        type="button"
        class="btn email-reveal-btn text-[.95rem] px-5 py-3 mt-1"
        aria-controls="emailDisplay"
        aria-expanded="false"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" />
          <circle cx="12" cy="12" r="3" />
        </svg>
        <span>แสดงที่อยู่อีเมล</span>
      </button>

      <p id="emailDisplay" class="mt-3" aria-live="polite" hidden></p>
    </div>

    <p class="text-text-muted text-[.85rem] mt-8 mb-3">ติดตามเราได้ที่นี่เช่นกัน</p>
    <div class="flex justify-center">
      <SocialLinks size="md" />
    </div>
  </section>

  <script>
    const emailCodes = [
      114, 117, 112, 101, 115, 104, 107, 117, 109, 97, 114,
      52, 55, 55, 53,
      64, 103, 109, 97, 105, 108, 46, 99, 111, 109
    ];

    const button = document.getElementById('showEmailBtn');
    const display = document.getElementById('emailDisplay');

    button?.addEventListener('click', () => {
      const email = String.fromCharCode(...emailCodes);

      const link = document.createElement('a');
      link.href = `mailto:${email}`;
      link.className =
        'email-revealed inline-flex items-center gap-2 px-4 py-2.5 rounded-md bg-primary/10 text-primary text-[1.02rem] font-semibold break-all hover:bg-primary/20 transition-colors duration-150';
      link.innerHTML =
        '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>';
      const text = document.createElement('span');
      text.textContent = email;
      link.append(text);

      display?.replaceChildren(link);
      if (display) display.hidden = false;

      button.setAttribute('aria-expanded', 'true');
      button.style.display = 'none';
      link.focus();
    });
  </script>
</BaseLayout>
