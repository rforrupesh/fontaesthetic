const platforms = [
  {
    "title": "Instagram",
    "body": "ผู้ใช้ Instagram ลองใช้ตัวอักษร Unicode ต่างๆ ในคำอธิบายไบโอ คำบรรยาย คอมเมนต์ และช่องข้อความอื่นๆ ได้ ช่วยแยกชื่อ คำอธิบายสั้นๆ และวลีที่เลือกออกจากข้อความอื่น"
  },
  {
    "title": "LinkedIn",
    "body": "ใช้สไตล์ข้อความต่างๆ เมื่อเขียนโพสต์บน LinkedIn ทั้งหัวข้อ คำอธิบายโปรไฟล์ คอมเมนต์ และข้อความเด่น การเน้นคำหรือวลีสำคัญด้วยตัวหนาอาจมีประโยชน์ โดยเฉพาะเมื่อใช้ตัวเลือกข้อความธรรมดา"
  },
  {
    "title": "Facebook",
    "body": "พื้นที่หลักที่ใช้อักขระข้อความทางเลือกได้คือโพสต์ Facebook คำอธิบายโปรไฟล์ คอมเมนต์ กลุ่ม และอื่นๆ อักขระทางเลือกมีประโยชน์ในที่ที่ไม่มีการจัดรูปแบบฟอนต์ปกติ"
  },
  {
    "title": "WhatsApp",
    "body": "ใช้อักขระข้อความทางเลือกได้ในข้อความ สถานะ โปรไฟล์ของ WhatsApp และพื้นที่อื่นที่รองรับรูปแบบข้อความนี้ เป็นทางเลือกแทนการจัดรูปแบบเริ่มต้นของ WhatsApp เช่น ตัวหนาและตัวเอียง"
  },
  {
    "title": "Discord",
    "body": "Discord รองรับไวยากรณ์ Markdown ในข้อความ แต่ยังมีอักขระ Unicode หลายตัวที่ช่วยให้ผู้ใช้ปรับแต่งชื่อผู้ใช้ คำอธิบายโปรไฟล์ และข้อความอื่นๆ ได้ด้วย อักขระที่ใช้ได้อาจต่างกันไปตามอุปกรณ์"
  },
  {
    "title": "TikTok",
    "body": "ผู้ใช้ TikTok ใช้ฟอนต์ทางเลือกในคำอธิบายโปรไฟล์หรือข้อความประเภทอื่นบน TikTok ได้ อักขระ Unicode ช่วยตกแต่งวลีสั้นๆ หรือชื่อ"
  },
