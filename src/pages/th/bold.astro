const steps = [
  "พิมพ์หรือวางข้อความลงในตัวสร้าง",
  "ข้อความจะถูกแปลงเป็นข้อความ Unicode สไตล์ต่างๆ เลือกเวอร์ชันที่ต้องการ",
  "คลิก ‘คัดลอก’",
  "วางข้อความตัวหนาลงในที่ใดก็ได้ที่รองรับฟีเจอร์นี้ เช่น แอป เว็บไซต์ โปรไฟล์ หรือกล่องข้อความ"
