---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { t } from '../i18n';

const strings = t('en');
---

<BaseLayout
  lang="en"
  title={`Contact — ${strings.site.name}`}
  description="Contact AestheticFonts for questions, suggestions, feedback, technical issues or business inquiries."
  path="/contact/"
>
  <PageHero
    title="Contact Us"
    subtitle="Have a question, suggestion, feedback or found a bug? We'd love to hear from you."
  />

  <section class="wrap py-10 max-w-[600px] mx-auto text-center">

    <div class="card p-6">
      <div class="w-10 h-10 rounded-md bg-primary/15 text-primary flex items-center justify-center mx-auto mb-4">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m3 7 9 6 9-6" />
        </svg>
      </div>

      <h2 class="text-[1.15rem] mb-2">Get in Touch</h2>

      <p class="text-text-muted text-[.9rem] mb-4">
        For general questions, suggestions, bug reports or other inquiries, feel free to contact us by email.
      </p>

      <p class="text-text-muted mb-2 text-[.85rem]">
        Official Email Address
      </p>

      <a
        id="contactEmail"
        href="#"
        class="text-primary text-[1.05rem] font-semibold hover:text-primary-hover transition-colors duration-150"
        aria-label="Contact AestheticFonts by email"
      >
        Show email address
      </a>

      <noscript>
        <p class="text-text-muted text-[.8rem] mt-3">
          Please enable JavaScript to view our email address.
        </p>
      </noscript>
    </div>

    <div class="mt-8 text-left">
      <h2 class="text-center text-[1.1rem] mb-4">What Can You Contact Us About?</h2>

      <div class="card p-5">
        <ul class="text-text-muted list-disc pl-6 space-y-2">
          <li>Questions about our Unicode font generator.</li>
          <li>Suggestions for new text styles or features.</li>
          <li>Reporting technical problems or bugs.</li>
          <li>Feedback about your experience using our website.</li>
          <li>Business, partnership or other general inquiries.</li>
        </ul>
      </div>
    </div>

    <p class="text-text-muted text-[.85rem] mt-8 mb-3">
      You can also find us here
    </p>

    <div class="flex justify-center">
      <SocialLinks size="md" />
    </div>

    <p class="text-text-muted text-[.85rem] mt-8">
      Thank you for visiting AestheticFonts. We appreciate your feedback and support.
    </p>

  </section>

  <script>
    const email = String.fromCharCode(
      114,117,112,101,115,104,107,117,109,97,114,52,55,55,53,
      64,103,109,97,105,108,46,99,111,109
    );

    const emailLink = document.getElementById('contactEmail');

    if (emailLink) {
      emailLink.textContent = email;
      emailLink.href = `mailto:${email}`;
    }
  </script>

</BaseLayout>
