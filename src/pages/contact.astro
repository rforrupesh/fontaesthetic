---
import BaseLayout from '../layouts/BaseLayout.astro';
import en from '../i18n/en.json';
---
<BaseLayout lang="en" title={en.pages.contact_title} description={en.meta.home_description} path="/contact/">
  <div class="card page-card">
    <h1>{en.pages.contact_title}</h1>
    <p>Have a question, suggestion or found a bug? Reach out to us at <a href="mailto:hello@fontaesthetic.com" class="inline-link">hello@fontaesthetic.com</a>.</p>
  </div>
</BaseLayout>
