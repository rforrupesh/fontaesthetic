---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
const strings = t('en');
---
<BaseLayout lang="en" title={`Contact — ${strings.site.name}`} description="Get in touch with the FontAesthetic team." path="/contact/">
  <section class="container prose page-content">
    <h1>Contact Us</h1>
    <p>Have a question, suggestion, or found a bug? We'd love to hear from you.</p>
    <p>Email us at: <a href="mailto:hello@fontaesthetic.example">hello@fontaesthetic.example</a></p>
  </section>
</BaseLayout>
