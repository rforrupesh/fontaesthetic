---
import StrikethroughPage from '../../components/StrikethroughPage.astro';

const why = [
  { title: 'خيار نسخ ولصق النص المشطوب', body: 'يتيح لك خيار النسخ واللصق إنشاء نص مشطوب واستخدامه فورًا في التطبيق الذي تفضله. اكتب نصك، ثم انسخ النتيجة والصقها في أي مكان تريده.' },
  { title: 'أنواع متعددة من النص المشطوب', body: 'يمكنك إنشاء أنواع متعددة من النص المشطوب. اختر النوع الذي يناسب محادثتك أو ملفك الشخصي أو منشورك. نص بخط واحد، نص بخط مزدوج، حروف مشطوبة، نص مشطوب أنيق، أنواع يونيكود مختلفة' },
  { title: 'أداة مجانية 100%', body: 'أداة مولّد النص المشطوب مجانية بالكامل. يمكنك استخدامها بقدر ما تشاء دون دفع أو تسجيل. بدون تسجيل، بدون اشتراك، بدون أي تكاليف إضافية، تحويلات غير محدودة، مجانية تمامًا' },
  { title: 'متوافقة مع جميع الأجهزة', body: 'يمكنك استخدام هذه الأداة على جميع الأجهزة التي تحتوي على متصفح. وهي تعمل بشكل ممتاز على الهواتف المحمولة والأجهزة اللوحية وشاشات الكمبيوتر. هواتف أندرويد، آيفون وآيباد، كمبيوتر ويندوز، كمبيوتر ماك، لا حاجة لتثبيت أي تطبيق' },
];
const extra = [
  { title: 'سهلة الاستخدام', body: 'صُممت الأداة لتكون سهلة للجميع. تتيح لك الأزرار الواضحة والواجهة سهلة الاستخدام تحويل نصك إلى نص مشطوب بسهولة. واجهة واضحة، وصول سريع لخيار النسخ، تعليمات سهلة المتابعة، مثالية للمبتدئين' },
  { title: 'معاينة مباشرة', body: 'يمكنك رؤية شكل نصك قبل نسخه. تتيح لك ميزة المعاينة المباشرة رؤية شكل النص بعد التحويل. معاينة فورية، غيّر نصك وقتما تشاء، شاهد النسخة النهائية، انسخه فقط عندما تكون راضيًا عن النتيجة' },
  { title: 'لغات متعددة', body: 'سواء كنت تكتب بالإنجليزية أو الألمانية أو الإندونيسية أو الإسبانية أو البرتغالية، يمكنك كتابة نصك وزخرفته وتحويله ونسخه.' },
];
const where = [
  { title: 'المحادثات والرسائل', body: 'استخدم النص المشطوب في المحادثات لتصحيح كلمة أو لمزحة أو للإشارة إلى أن الرسالة لم تعد صالحة. رسائل واتساب، محادثات تيليجرام، ردود ماسنجر، رسائل إنستغرام الخاصة، رسائل سناب شات' },
  { title: 'ملفات الألعاب الشخصية', body: 'تسمح بعض الألعاب ومنصات الألعاب بالأحرف المشطوبة في أسماء المستخدمين وأسماء العشائر ونصوص الملف الشخصي. اسم ديسكورد، اسم Free Fire، اسم BGMI، اسم PUBG، اسم مستخدم Roblox' },
  { title: 'الملاحظات والقوائم', body: 'استخدم النص المشطوب لوضع علامة على المهام المنجزة أو التذكيرات القديمة أو الخطط الملغاة في ملاحظاتك. قوائم المهام، ملاحظات الدراسة، قوائم التسوق، تذكيرات قديمة، خطط ملغاة' },
];
const tools = ['مولّد النص المسطّر', 'مولّد النص المائل', 'مولّد النص المقلوب'];
const faqs = [
  { question: 'هل النص المشطوب آمن للاستخدام؟', answer: 'نعم. عادةً ما يكون نسخ ولصق النص المشطوب بنظام يونيكود آمنًا. فهو يتكون من أحرف نصية وليس من شيفرة قابلة للتنفيذ أو برنامج. ومع ذلك، قد يختلف مظهره بين التطبيقات والأجهزة.' },
  { question: 'كيف أكتب حرفًا عليه خط؟', answer: 'يمكنك إنشاء حرف عليه خط بإضافة حرف يونيكود مركّب، مثل U+0336، بعد الحرف. فمثلًا، الحرف a متبوعًا بالعلامة المركّبة يصبح a̶. ويمكن لمولّد النص المشطوب أتمتة هذه العملية لكلمات وجمل كاملة.' },
  { question: 'لماذا لا يعمل النص المشطوب لدي؟', answer: 'لا تعرض بعض التطبيقات أحرف يونيكود المركّبة بشكل متسق. قد يظهر الخط غير محاذٍ أو منفصلًا أو مفقودًا بسبب اختلاف عرض الخطوط ودعم يونيكود. جرّب تطبيقًا آخر أو نمط شطب مختلفًا.' },
  { question: 'هل يمكنني استخدام الحروف المشطوبة على الجوال؟', answer: 'نعم. يمكنك نسخ الحروف المشطوبة من المولّد ولصقها في تطبيقات الجوال المدعومة. وتعتمد النتيجة على التطبيق ولوحة المفاتيح ودعم عرض الخطوط.' },
];
---

<StrikethroughPage lang="ar">
  <article class="wrap max-w-[900px] mx-auto py-10 text-text">
    <!-- Intro -->
    <header class="text-center mb-12">
      <h2 class="text-[clamp(1.6rem,3.4vw,2.2rem)] font-bold mb-4">زخرفة النص المشطوب: نسخ ولصق</h2>
      <p class="text-text-muted text-[1.05rem] leading-[1.8]">النص المشطوب، المعروف أيضًا بالنص الذي عليه خط، يعرض خطًا أفقيًا يمر عبر الحروف والكلمات. ويُستخدم عادةً لإظهار التعديلات أو التصحيحات أو المحتوى المحذوف. يقوم مولّد زخرفة النص المشطوب لدينا بتحويل النص العادي إلى نص مشطوب بنظام يونيكود يمكنك نسخه ولصقه عند كتابة الرسائل ومنشورات وسائل التواصل الاجتماعي والنبذات الشخصية وغيرها من المنصات.</p>
    </header>

    <!-- What is -->
    <section class="mb-12 rounded-2xl border border-border bg-surface p-6 md:p-8">
      <h2 class="text-2xl font-bold mb-3">ما هو النص المشطوب؟</h2>
      <p class="text-text-muted leading-[1.8]">الشطب تأثير طباعي وزخرفي يضع خطًا في منتصف كل حرف. ويُستخدم عادةً في المستندات لوضع علامة على الكلمات المحذوفة أو إظهار التغييرات دون حذف المحتوى الأصلي. ويمكن لأحرف يونيكود المركّبة، المستخدمة في زخرفة الكتابة وتحويل النصوص،، مثل التراكب الطويل للخط (U+0336)، أن تنشئ هذا المظهر بإضافة خط إلى الحروف الموجودة.</p>
    </section>

    <!-- Why use -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-2">لماذا تستخدم أداة مولّد النص المشطوب لدينا؟</h2>
      <p class="text-text-muted leading-[1.8] mb-6">تصبح كتابة النص المشطوب وزخرفته وتحويله سهلة باستخدام مولّدنا دون الحاجة إلى إدخال أحرف خاصة يدويًا لكل حرف.</p>
      <div class="grid gap-4 sm:grid-cols-2">
        {why.map((f) => (
          <div class="card p-5 transition-colors duration-150 hover:border-primary">
            <h3 class="text-lg font-semibold mb-2">{f.title}</h3>
            <p class="text-sm text-text-muted leading-[1.7]">{f.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Extra features -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-2">ميزات إضافية للنص المشطوب</h2>
      <p class="text-text-muted leading-[1.8] mb-6">يتضمن المولّد ميزات عملية تجعل تحويل النص أسهل:</p>
      <div class="grid gap-4 md:grid-cols-3">
        {extra.map((f) => (
          <div class="card p-5 border-t-4 border-t-primary">
            <h3 class="text-lg font-semibold mb-2">{f.title}</h3>
            <p class="text-sm text-text-muted leading-[1.7]">{f.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Where to use -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-6">أين تستخدم زخرفة الشطب وكتابة النص المشطوب؟</h2>
      <div class="grid gap-4 md:grid-cols-3">
        {where.map((f) => (
          <div class="card p-5">
            <h3 class="text-lg font-semibold mb-2">{f.title}</h3>
            <p class="text-sm text-text-muted leading-[1.7]">{f.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Other tools -->
    <section>
      <h2 class="text-2xl font-bold mb-4">أدوات أخرى</h2>
      <ul class="flex flex-wrap gap-2.5 list-none p-0 m-0">
        {tools.map((name) => (
          <li class="rounded-full border border-border bg-surface px-4 py-2 text-sm font-medium">{name}</li>
        ))}
      </ul>
    </section>
  </article>

  <section class="wrap max-w-[900px] mx-auto pb-12">
    <h2 class="text-2xl font-bold mb-5 text-center">الأسئلة الشائعة</h2>
    <div class="max-w-[720px] mx-auto flex flex-col gap-3">
      {faqs.map((item) => (
        <details class="card px-5 py-4 group">
          <summary class="cursor-pointer list-none flex items-center justify-between gap-4 font-medium text-[.95rem]">
            {item.question}
            <span class="shrink-0 text-text-muted transition-transform duration-200 group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 text-[.9rem] text-text-muted leading-[1.7]">{item.answer}</p>
        </details>
      ))}
    </div>
  </section>
</StrikethroughPage>
