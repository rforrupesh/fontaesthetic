---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { t } from '../../i18n';
const strings = t('ar');

const features = [
  { title: 'بدون تسجيل', text: 'فقط افتح الصفحة وابدأ بالكتابة. لا حساب، لا تنزيل.' },
  { title: 'يعمل في كل مكان', text: 'الصقه على إنستغرام وواتساب وديسكورد وتويتر/إكس وغيرها.' },
  { title: 'مجاني 100%', text: 'لا رسوم خفية، ولا خطط مدفوعة.' },
];
---
<BaseLayout lang="ar" title={`من نحن — ${strings.site.name}`} description="تعرّف على AestheticFonts، مولد الخطوط المجاني عبر الإنترنت." path="/about/">
  <PageHero
    title="من نحن"
    subtitle="مولد خطوط مجاني عبر الإنترنت يحوّل نصك العادي إلى خطوط يونيكود أنيقة يمكنك نسخها ولصقها في أي مكان."
  />

  <section class="wrap py-10 max-w-[820px] mx-auto">
    <div class="grid sm:grid-cols-3 gap-5 mb-8">
      {features.map((f) => (
        <div class="card p-5">
          <div class="w-8 h-8 rounded-md bg-primary/15 text-primary flex items-center justify-center mb-3">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
          </div>
          <h3 class="text-[1.02rem] mb-1.5">{f.title}</h3>
          <p class="text-text-muted text-[.9rem] m-0">{f.text}</p>
        </div>
      ))}
    </div>

    <p class="text-text-muted text-center max-w-[560px] mx-auto">
      صُنع للمبدعين والمسوّقين ولكل من يريد أن يبرز نصه بشكل مختلف.
    </p>
  </section>
</BaseLayout>
