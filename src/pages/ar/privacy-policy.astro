---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { t } from '../../i18n';
const strings = t('ar');

const sections = [
  {
    title: 'ما الذي نجمعه',
    text: 'لا يقوم مولد الخطوط AestheticFonts بتخزين النص الذي تكتبه. تتم كل عملية التحويل مباشرة في متصفحك.',
  },
  {
    title: 'التحليلات',
    text: 'قد نستخدم تحليلات أساسية تحترم الخصوصية لفهم استخدام الموقع. نحن لا نبيع أي بيانات شخصية لأطراف ثالثة.',
  },
];
---
<BaseLayout lang="ar" title={`سياسة الخصوصية — ${strings.site.name}`} description="سياسة الخصوصية الخاصة بـ AestheticFonts." path="/privacy-policy/">
  <PageHero title="سياسة الخصوصية" subtitle="آخر تحديث: يناير 2026" />

  <section class="wrap py-10 max-w-[680px] mx-auto flex flex-col gap-5">
    {sections.map((s) => (
      <div class="card p-5">
        <h2 class="text-[1.05rem] mb-2">{s.title}</h2>
        <p class="text-text-muted m-0">{s.text}</p>
      </div>
    ))}
  </section>
</BaseLayout>
