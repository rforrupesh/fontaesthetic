---
import { imgUrl } from '../../../../lib/imageUrl';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../../../components/schema/BreadcrumbSchema.astro';
import CollectionPageSchema from '../../../../components/schema/CollectionPageSchema.astro';
import OrganizationSchema from '../../../../components/schema/OrganizationSchema.astro';
import { getCollection } from 'astro:content';
import { t, getPath } from '../../../../i18n';
import { slugify } from '../../../../lib/slugify';

const lang = 'id';
const strings = t(lang);

export async function getStaticPaths() {
  const posts = await getCollection('blog', (e) => e.id.startsWith('id/'));
  // Group original tag text by its lowercase URL slug, so "Fonts" and
  // "fonts" collapse to one /blog/tag/fonts/ page and the URL is always
  // lowercase regardless of how the tag was capitalized in frontmatter.
  const slugToTag = new Map<string, string>();
  posts.forEach((p) => p.data.tags.forEach((tag) => {
    const slug = slugify(tag);
    if (!slugToTag.has(slug)) slugToTag.set(slug, tag);
  }));

  return Array.from(slugToTag.entries()).map(([slug, tag]) => ({
    params: { tag: slug },
    props: { tag },
  }));
}

const { tag } = Astro.props;

const posts = (await getCollection('blog', (e) => e.id.startsWith('id/')))
  .filter((p) => p.data.tags.some((t) => slugify(t) === slugify(tag)))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());


const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const base = import.meta.env.BASE_URL;
const pageUrl = siteUrl + getPath(lang, `/blog/tag/${slugify(tag)}/`);
const logoUrl = `${siteUrl}${base}logo.svg`;
const pageDescription = strings.blog.tagDescription.replace('{name}', tag).replace('{count}', String(posts.length));
const title = `#${tag}`;
---

<BaseLayout
  lang={lang}
  title={`${title} — ${strings.blog.listingTitle} — ${strings.site.name}`}
  description={pageDescription}
  path={`/blog/tag/${slugify(tag)}/`}
  availableLangs={[lang]}
  noindex={true}
>
  <section class="wrap py-12 pb-6 text-center">
    <h1 class="text-[clamp(1.7rem,4vw,2.2rem)]">{title}</h1>
    <p class="text-[.85rem] text-text-muted">{posts.length} {strings.blog.articles}</p>
  </section>

  <section class="wrap max-w-[860px] flex flex-col gap-6 pb-12">
    {posts.length === 0 && <p class="text-center text-text-muted">{strings.blog.noPosts}</p>}
    {posts.map((post) => {
      const slug = post.data.slug ?? post.id.split('/').slice(1).join('/');
      const postHref = getPath(lang, `/blog/${slug}/`);
      const cat = post.data.categories[0];
      const date = post.data.date.toLocaleDateString(lang, { year: 'numeric', month: 'short', day: 'numeric' });
      return (
        <article class="card overflow-hidden flex flex-col sm:flex-row">
          {post.data.image && (
            <a href={postHref} aria-label={post.data.title} class="sm:w-[280px] shrink-0">
              <img src={imgUrl(post.data.image)} alt={post.data.title} loading="lazy" class="w-full h-full aspect-video object-contain bg-surface-2" />
            </a>
          )}
          <div class="p-5 flex flex-col gap-2">
            <div class="flex flex-wrap items-center gap-2 text-[.75rem] text-text-muted">
              {cat && (
                <a href={getPath(lang, `/blog/category/${slugify(cat)}/`)} class="font-medium px-2.5 py-1 rounded-full bg-primary/10 text-primary hover:bg-primary/20">{cat}</a>
              )}
              <time datetime={post.data.date.toISOString()}>{date}</time>
            </div>
            <h2 class="text-[1.15rem] mb-0"><a href={postHref} class="hover:text-primary">{post.data.title}</a></h2>
            <p class="text-[.9rem] text-text-muted mb-0">{post.data.description}</p>
            <a href={postHref} class="text-[.85rem] font-medium text-primary mt-1">{strings.blog.readMore} →</a>
          </div>
        </article>
      );
    })}
  </section>

  <BreadcrumbSchema
    items={[
      { name: strings.nav.home, url: siteUrl + getPath(lang, '/') },
      { name: strings.blog.listingTitle, url: siteUrl + getPath(lang, '/blog/') },
      { name: title, url: pageUrl },
    ]}
  />
  <CollectionPageSchema
    name={`${title} — ${strings.blog.listingTitle}`}
    description={pageDescription}
    url={pageUrl}
    lang={lang}
  />
  <OrganizationSchema name={strings.site.name} siteUrl={siteUrl + base} logoUrl={logoUrl} />
</BaseLayout>
