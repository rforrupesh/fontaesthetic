  },
  {
    "label": "Huruf (huruf kapital) -",
    "text": "𝐀𝐁𝐂𝐃𝐄𝐅𝐆𝐇𝐈𝐉𝐊𝐋𝐌𝐍𝐎𝐏𝐐𝐑𝐒𝐓𝐔𝐕𝐖𝐗𝐘𝐙"
  },
  {
    "label": "Angka -",
    "text": "𝟎𝟏𝟐𝟑𝟒𝟓𝟔𝟕𝟖𝟗"
  }
];
const steps = [
  "Ketik atau tempel teks ke dalam generator.",
  "Teks akan diubah menjadi teks Unicode bergaya. Pilih versi teks yang kamu suka.",
  "Klik ‘Salin’.",
  "Tempel teks tebal ke area mana pun yang mendukung fitur ini, seperti aplikasi, situs web, profil, atau kotak pesan."
];
const fonts = [
  { label: 'Bold Sans Serif:', text: '𝗕𝗼𝗹𝗱 𝗧𝗲𝘅𝘁' },
  { label: 'Bold Serif:', text: '𝐁𝐨𝐥𝐝 𝐓𝐞𝐱𝐭' },
  { label: 'Bold Italic:', text: '𝑩𝒐𝒍𝒅 𝑻𝒆𝒙𝒕' },
  { label: 'Bold Script:', text: '𝓑𝓸𝓵𝓭 𝓣𝓮𝔁𝓽' },
  { label: 'Bold Fraktur:', text: '𝕭𝖔𝖑𝖉 𝕿𝖊𝖝𝖙' },
  { label: 'Bold Monospace:', text: '𝙱𝚘𝚕𝚍 𝚃𝚎𝚡𝚝' },
];
const platforms = [
  {
    "title": "Instagram",
    "body": "Pengguna Instagram bisa mencoba berbagai huruf Unicode di deskripsi bio, keterangan, komentar, dan kolom teks lainnya. Ini membantu membedakan nama, deskripsi singkat, dan frasa pilihan dari teks lain."
  },
  {
