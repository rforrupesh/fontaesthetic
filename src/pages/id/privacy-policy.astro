---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { t } from '../../i18n';
const strings = t('id');

const sections = [
  {
    title: "Apa yang kami kumpulkan",
    text: "AestheticFonts tidak menyimpan teks yang Anda ketik di generator font. Seluruh proses konversi terjadi langsung di browser Anda.",
  },
  {
    title: "Analitik",
    text: "Kami dapat menggunakan analitik dasar yang menjaga privasi untuk memahami penggunaan situs. Kami tidak menjual data pribadi kepada pihak ketiga.",
  },
];
---
<BaseLayout lang="id" title={`Kebijakan Privasi — ${strings.site.name}`} description="Kebijakan privasi AestheticFonts." path="/privacy-policy/">
  <PageHero title="Kebijakan Privasi" subtitle="Terakhir diperbarui: Januari 2026" />

  <section class="wrap py-10 max-w-[680px] mx-auto flex flex-col gap-5">
    {sections.map((s) => (
      <div class="card p-5">
        <h2 class="text-[1.05rem] mb-2">{s.title}</h2>
        <p class="text-text-muted m-0">{s.text}</p>
      </div>
    ))}
  </section>
</BaseLayout>
