---
import ItalicPage from '../../components/ItalicPage.astro';

const features = [
  {
    "label": "Konversi Karakter Unicode:",
    "body": "Mengubah huruf biasa yang didukung menjadi karakter italic matematika."
  },
  {
    "label": "Salin dan Tempel Cepat:",
    "body": "Salin teks yang dihasilkan dan gunakan di aplikasi lain."
  },
  {
    "label": "Tanpa Instal Font:",
    "body": "Buat huruf bergaya italic tanpa mengunduh file font."
  },
  {
    "label": "Input Teks Sederhana:",
    "body": "Masukkan kata, nama, atau kalimat untuk membuat teks miring."
  },
  {
    "label": "Alat Berbasis Browser:",
    "body": "Gunakan generator langsung dari browser web kamu."
  },
  {
    "label": "Gratis Digunakan:",
    "body": "Buat teks italic tanpa pendaftaran atau pembayaran."
  }
];
const where = [
  {
    "label": "Instagram:",
    "body": "Gunakan huruf italic di bio, keterangan, dan komentar."
  },
  {
    "label": "Facebook:",
    "body": "Tambahkan teks miring ke postingan, komentar, dan deskripsi profil."
  },
  {
    "label": "WhatsApp:",
    "body": "Kirim teks Unicode bergaya italic dalam pesan."
  },
  {
    "label": "TikTok:",
    "body": "Buat berbagai gaya teks untuk deskripsi profil."
  },
  {
    "label": "Discord:",
    "body": "Gunakan karakter italic khusus di pesan dan kolom profil yang didukung."
  },
  {
    "label": "YouTube:",
    "body": "Tambahkan huruf dekoratif ke komentar dan deskripsi channel."
  },
  {
    "label": "Profil Game:",
    "body": "Buat nama tampilan yang unik menggunakan karakter Unicode yang didukung."
  }
];
const steps = [
  "Buka alat Generator Italic.",
  "Ketik atau tempel teks biasa kamu ke kotak input.",
  "Lihat teks bergaya italic hasil konversi.",
  "Klik opsi salin untuk menyalin hasilnya.",
  "Tempel ke aplikasi atau situs web pilihanmu."
];
const tools = [
  {
    "name": "Generator Font",
    "url": "https://aestheticfonts.in/id/"
  },
  {
    "name": "Generator Teks Garis Bawah",
    "url": "https://aestheticfonts.in/id/underline/"
  },
  {
    "name": "Generator Teks Coret",
    "url": "https://aestheticfonts.in/id/strikethrough/"
  }
];
const faqs = [
  {
    "question": "Bisakah Saya Menggunakan Huruf Alfabet Italic Tanpa Format?",
    "answer": "Ya. Huruf alfabet italic Unicode dapat disalin dan ditempel tanpa menerapkan format teks tradisional. Huruf-huruf ini adalah karakter Unicode terpisah, sehingga tampilannya tidak bergantung pada pemilihan opsi italic di editor teks."
  },
  {
    "question": "Apakah Pembuat Teks Italic Gratis?",
    "answer": "Ya. Pembuat teks italic ini gratis. Kamu bisa mengubah huruf biasa menjadi teks bergaya italic dan menyalin hasilnya tanpa membayar atau menginstal perangkat lunak tambahan."
  },
  {
    "question": "Bisakah Saya Menggunakan Teks Miring di Username Media Sosial?",
    "answer": "Kamu bisa menggunakan karakter Unicode miring di nama tampilan dan deskripsi profil media sosial jika platform mendukungnya. Namun, beberapa situs membatasi karakter khusus pada username akun. Periksa aturan platform sebelum menggunakan huruf italic di username kamu."
  },
  {
    "question": "Apakah Huruf Italic Berfungsi di Semua Perangkat?",
    "answer": "Huruf italic Unicode berfungsi di perangkat dan aplikasi yang mendukung karakter terkait. Namun, tampilannya dapat berbeda tergantung sistem operasi, browser, dan font. Beberapa karakter mungkin tidak tampil dengan benar di perangkat lama atau aplikasi yang tidak didukung."
  }
];
---

<ItalicPage lang="id">
  <article class="wrap max-w-[900px] mx-auto py-10 text-text">
    <!-- Intro -->
    <header class="text-center mb-12">
      <h2 class="text-[clamp(1.6rem,3.4vw,2.2rem)] font-bold mb-4">Salin dan Tempel Teks Miring</h2>
      <p class="text-text-muted text-[1.05rem] leading-[1.8]">Teks miring menggunakan huruf yang dimiringkan untuk memberi tampilan berbeda pada kata-kata. Teks ini biasa dipakai untuk penekanan, judul, keterangan foto, dan tulisan dekoratif. Generator teks miring mengubah huruf biasa menjadi karakter Unicode khusus yang bisa disalin dan ditempel ke profil media sosial, pesan, dan aplikasi lainnya.</p>
    </header>

    <!-- What is -->
    <section class="mb-12 rounded-2xl border border-border bg-surface p-6 md:p-8">
      <h2 class="text-2xl font-bold mb-3">Apa Itu Teks Miring Unicode?</h2>
      <p class="text-text-muted leading-[1.8]">Teks miring Unicode menggunakan karakter khusus dari blok Simbol Alfanumerik Matematika (U+1D400 hingga U+1D7FF). Blok Unicode ini berisi berbagai gaya huruf, termasuk italic matematika, italic tebal, dan karakter script. Huruf-huruf ini memiliki titik kode Unicode sendiri dan dapat disalin dan ditempel tanpa menerapkan format italic tradisional.</p>
    </section>

    <!-- Why use -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-3">Mengapa Menggunakan Generator Italic Kami?</h2>
      <p class="text-text-muted leading-[1.8]">Generator Italic kami mengubah teks biasa menjadi berbagai gaya teks Unicode. Kamu bisa membuat teks Italic, Cursive, Script, Italic Bold (Serif), dan Italic Bold (Sans) dengan proses konversi yang sederhana. Masukkan teks, lihat hasil konversinya, lalu salin untuk bio, keterangan, komentar, dan pesan di media sosial. Alat ini berjalan langsung di browser tanpa perlu menginstal font atau perangkat lunak tambahan.</p>
    </section>

    <!-- Extra features -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-3">Fitur Tambahan Teks Miring</h2>
      <p class="text-text-muted leading-[1.8] mb-5">Generator teks miring menyediakan cara mudah untuk membuat dan menyalin berbagai gaya teks. Fitur utamanya meliputi:</p>
      <ul class="list-none p-0 m-0 flex flex-col gap-3">
        {features.map((w) => (
          <li class="card px-5 py-3.5 text-sm leading-[1.7]"><strong class="font-semibold">{w.label}</strong> <span class="text-text-muted">{w.body}</span></li>
        ))}
      </ul>
    </section>

    <!-- Where to use -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-3">Di Mana Menggunakan Gaya Font Italic</h2>
      <p class="text-text-muted leading-[1.8] mb-5">Karakter Unicode italic dapat digunakan di berbagai situs web dan aplikasi yang mendukungnya. Karakter ini biasa dipakai untuk mengubah tampilan teks pendek dan informasi profil.</p>
      <ul class="list-none p-0 m-0 flex flex-col gap-3">
        {where.map((w) => (
          <li class="card px-5 py-3.5 text-sm leading-[1.7]"><strong class="font-semibold">{w.label}</strong> <span class="text-text-muted">{w.body}</span></li>
        ))}
      </ul>
    </section>

    <!-- How to -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-3">Bagaimana Cara Membuat Teks Bergaya Italic?</h2>
      <p class="text-text-muted leading-[1.8] mb-4">Kamu bisa membuat teks italic menggunakan editor teks atau generator teks italic online. Di aplikasi seperti Microsoft Word dan Google Docs, pilih teks lalu terapkan opsi format italic.</p>
      <p class="text-text-muted leading-[1.8] mb-5">Untuk membuat teks italic yang bisa disalin dan ditempel, ikuti langkah berikut:</p>
      <ol class="list-none p-0 m-0 flex flex-col gap-3">
        {steps.map((s, i) => (
          <li class="card px-5 py-3.5 text-sm leading-[1.7] flex gap-3"><span class="font-semibold text-primary">{i + 1}.</span> <span class="text-text-muted">{s}</span></li>
        ))}
      </ol>
    </section>

    <!-- Other tools -->
    <section>
      <h2 class="text-2xl font-bold mb-4">Alat Lainnya</h2>
      <ul class="flex flex-wrap gap-2.5 list-none p-0 m-0">
        {tools.map((tool) => (
          <li>
            <a
              href={tool.url}
              class="inline-block rounded-full border border-border bg-surface px-4 py-2 text-sm font-medium hover:border-primary hover:text-primary transition-colors"
            >
              {tool.name}
            </a>
          </li>
        ))}
      </ul>
    </section>
  </article>

  <section class="wrap max-w-[900px] mx-auto pb-12">
    <h2 class="text-2xl font-bold mb-5 text-center">Pertanyaan yang Sering Diajukan</h2>
    <div class="max-w-[720px] mx-auto flex flex-col gap-3">
      {faqs.map((item) => (
        <details class="card px-5 py-4 group">
          <summary class="cursor-pointer list-none flex items-center justify-between gap-4 font-medium text-[.95rem]">
            {item.question}
            <span class="shrink-0 text-text-muted transition-transform duration-200 group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 text-[.9rem] text-text-muted leading-[1.7]">{item.answer}</p>
        </details>
      ))}
    </div>
  </section>
</ItalicPage>
