---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { t } from '../../i18n';
const strings = t('ja');

const features = [
  { title: "登録不要", text: "ページを開いて入力するだけ。アカウントもダウンロードも不要です。" },
  { title: "どこでも使える", text: "Instagram、WhatsApp、Discord、Twitter/Xなどに貼り付けられます。" },
  { title: "100%無料", text: "隠れた料金もプレミアムプランもありません。" },
];
---
<BaseLayout lang="ja" title={`概要 — ${strings.site.name}`} description="無料オンラインフォントジェネレーター、AestheticFontsについて詳しく知る。" path="/about/">
  <PageHero
    title="私たちについて"
    subtitle="普通のテキストを、どこにでもコピー＆ペーストできるおしゃれなUnicodeフォントに変える無料のオンラインフォントジェネレーターです。"
  />

  <section class="wrap py-10 max-w-[820px] mx-auto">
    <div class="grid sm:grid-cols-3 gap-5 mb-8">
      {features.map((f) => (
        <div class="card p-5">
          <div class="w-8 h-8 rounded-md bg-primary/15 text-primary flex items-center justify-center mb-3">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
          </div>
          <h3 class="text-[1.02rem] mb-1.5">{f.title}</h3>
          <p class="text-text-muted text-[.9rem] m-0">{f.text}</p>
        </div>
      ))}
    </div>

    <p class="text-text-muted text-center max-w-[560px] mx-auto">
      クリエイター、マーケター、そしてテキストを目立たせたいすべての人のために。
    </p>
  </section>
</BaseLayout>
