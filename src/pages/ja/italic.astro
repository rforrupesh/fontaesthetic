---
import ItalicPage from '../../components/ItalicPage.astro';

const features = [
  {
    "label": "Unicode文字への変換：",
    "body": "対応している通常の文字を数学用イタリック文字に変換します。"
  },
  {
    "label": "簡単コピー＆ペースト：",
    "body": "生成したテキストをコピーして、他のアプリで使えます。"
  },
  {
    "label": "フォントのインストール不要：",
    "body": "フォントファイルをダウンロードせずに、イタリック風の文字を作れます。"
  },
  {
    "label": "シンプルなテキスト入力：",
    "body": "単語、名前、文章を入力して斜体テキストを作成できます。"
  },
  {
    "label": "ブラウザで動作：",
    "body": "ウェブブラウザから直接ジェネレーターを使えます。"
  },
  {
    "label": "無料で利用可能：",
    "body": "登録や支払いなしでイタリック体テキストを作成できます。"
  }
];
const where = [
  {
    "label": "Instagram:",
    "body": "プロフィール、キャプション、コメントにイタリック体の文字を使えます。"
  },
  {
    "label": "Facebook:",
    "body": "投稿、コメント、プロフィールの説明に斜体テキストを追加できます。"
  },
  {
    "label": "WhatsApp:",
    "body": "メッセージでイタリック風のUnicodeテキストを送れます。"
  },
  {
    "label": "TikTok:",
    "body": "プロフィールの説明にさまざまな書体を使えます。"
  },
  {
    "label": "Discord:",
    "body": "メッセージや対応しているプロフィール欄で特殊なイタリック文字を使えます。"
  },
  {
    "label": "YouTube:",
    "body": "コメントやチャンネルの説明に装飾的な文字を加えられます。"
  },
  {
    "label": "ゲームのプロフィール：",
    "body": "対応するUnicode文字で個性的な表示名を作れます。"
  }
];
const steps = [
  "イタリック体ジェネレーターを開きます。",
  "入力ボックスに通常のテキストを入力または貼り付けます。",
  "変換されたイタリック風のテキストを確認します。",
  "コピーのオプションをクリックして結果をコピーします。",
  "使いたいアプリやウェブサイトに貼り付けます。"
];
const tools = [
  {
    "name": "フォントジェネレーター",
    "url": "https://aestheticfonts.in/ja/"
  },
  {
    "name": "下線テキストジェネレーター",
    "url": "https://aestheticfonts.in/ja/underline/"
  },
  {
    "name": "取り消し線テキストジェネレーター",
    "url": "https://aestheticfonts.in/ja/strikethrough/"
  }
];
const faqs = [
  {
    "question": "書式設定なしでイタリック体のアルファベットを使えますか？",
    "answer": "はい。Unicodeのイタリック体アルファベットは、通常の書式を適用せずにコピー＆ペーストできます。独立したUnicode文字なので、見た目はテキストエディターでイタリックを選択したかどうかに左右されません。"
  },
  {
    "question": "イタリック体テキストメーカーは無料ですか？",
    "answer": "はい。イタリック体テキストメーカーは無料です。通常の文字をイタリック風のテキストに変換し、支払いや追加ソフトのインストールなしで結果をコピーできます。"
  },
  {
    "question": "SNSのユーザー名に斜体テキストを使えますか？",
    "answer": "プラットフォームが対応していれば、SNSの表示名やプロフィールの説明に斜体のUnicode文字を使えます。ただし、アカウントのユーザー名では特殊文字を制限しているサイトもあります。ユーザー名にイタリック体の文字を使う前に、プラットフォームのルールを確認してください。"
  },
  {
    "question": "イタリック体の文字はすべてのデバイスで使えますか？",
    "answer": "Unicodeのイタリック体の文字は、対応する文字をサポートしているデバイスやアプリで使えます。ただし、見た目はOS、ブラウザ、フォントによって異なる場合があります。古いデバイスや非対応のアプリでは、一部の文字が正しく表示されないことがあります。"
  }
];
---

<ItalicPage lang="ja">
  <article class="wrap max-w-[900px] mx-auto py-10 text-text">
    <!-- Intro -->
    <header class="text-center mb-12">
      <h2 class="text-[clamp(1.6rem,3.4vw,2.2rem)] font-bold mb-4">イタリック体テキストのコピー＆ペースト</h2>
      <p class="text-text-muted text-[1.05rem] leading-[1.8]">イタリック体のテキストは、斜めに傾いた文字で言葉の見た目を変えます。強調、タイトル、キャプション、装飾的な文章によく使われます。イタリック体テキストジェネレーターは、通常の文字を特別なUnicode文字に変換し、SNSのプロフィールやメッセージ、その他のアプリにコピー＆ペーストできるようにします。</p>
    </header>

    <!-- What is -->
    <section class="mb-12 rounded-2xl border border-border bg-surface p-6 md:p-8">
      <h2 class="text-2xl font-bold mb-3">Unicodeイタリック体テキストとは？</h2>
      <p class="text-text-muted leading-[1.8]">Unicodeイタリック体テキストは、数学用英数字記号ブロック（U+1D400～U+1D7FF）の特殊な文字を使います。このUnicodeブロックには、数学用イタリック、太字イタリック、スクリプト体など、さまざまな書体の文字が含まれています。これらの文字は独立したUnicodeコードポイントを持つため、通常のイタリック書式を適用せずにコピー＆ペーストできます。</p>
    </section>

    <!-- Why use -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-3">イタリック体ジェネレーターを使う理由</h2>
      <p class="text-text-muted leading-[1.8]">当ジェネレーターは、通常のテキストをさまざまなUnicode書体に変換します。簡単な変換で、Italic、Cursive、Script、Italic Bold (Serif)、Italic Bold (Sans) のテキストを作成できます。テキストを入力し、変換結果を確認して、SNSのプロフィール、キャプション、コメント、メッセージに使うためにコピーしてください。ツールはブラウザ上で直接動作し、フォントのインストールや追加ソフトは不要です。</p>
    </section>

    <!-- Extra features -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-3">斜体テキストの便利な機能</h2>
      <p class="text-text-muted leading-[1.8] mb-5">イタリック体テキストジェネレーターを使えば、さまざまな書体のテキストを簡単に作成してコピーできます。主な機能は次のとおりです。</p>
      <ul class="list-none p-0 m-0 flex flex-col gap-3">
        {features.map((w) => (
          <li class="card px-5 py-3.5 text-sm leading-[1.7]"><strong class="font-semibold">{w.label}</strong> <span class="text-text-muted">{w.body}</span></li>
        ))}
      </ul>
    </section>

    <!-- Where to use -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-3">イタリック体のフォントスタイルの使いどころ</h2>
      <p class="text-text-muted leading-[1.8] mb-5">イタリック体のUnicode文字は、これらの文字に対応するさまざまなウェブサイトやアプリで使えます。短いテキストやプロフィール情報の見た目を変えるためによく使われます。</p>
      <ul class="list-none p-0 m-0 flex flex-col gap-3">
        {where.map((w) => (
          <li class="card px-5 py-3.5 text-sm leading-[1.7]"><strong class="font-semibold">{w.label}</strong> <span class="text-text-muted">{w.body}</span></li>
        ))}
      </ul>
    </section>

    <!-- How to -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-3">テキストをイタリック体にするには？</h2>
      <p class="text-text-muted leading-[1.8] mb-4">テキストをイタリック体にするには、テキストエディターやオンラインのイタリック体テキストジェネレーターを使います。Microsoft WordやGoogle Docsなどでは、テキストを選択してイタリックの書式を適用します。</p>
      <p class="text-text-muted leading-[1.8] mb-5">コピー＆ペーストできるイタリック体テキストを作るには、次の手順に従ってください。</p>
      <ol class="list-none p-0 m-0 flex flex-col gap-3">
        {steps.map((s, i) => (
          <li class="card px-5 py-3.5 text-sm leading-[1.7] flex gap-3"><span class="font-semibold text-primary">{i + 1}.</span> <span class="text-text-muted">{s}</span></li>
        ))}
      </ol>
    </section>

    <!-- Other tools -->
    <section>
      <h2 class="text-2xl font-bold mb-4">その他のツール</h2>
      <ul class="flex flex-wrap gap-2.5 list-none p-0 m-0">
        {tools.map((tool) => (
          <li>
            <a
              href={tool.url}
              class="inline-block rounded-full border border-border bg-surface px-4 py-2 text-sm font-medium hover:border-primary hover:text-primary transition-colors"
            >
              {tool.name}
            </a>
          </li>
        ))}
      </ul>
    </section>
  </article>

  <section class="wrap max-w-[900px] mx-auto pb-12">
    <h2 class="text-2xl font-bold mb-5 text-center">よくある質問</h2>
    <div class="max-w-[720px] mx-auto flex flex-col gap-3">
      {faqs.map((item) => (
        <details class="card px-5 py-4 group">
          <summary class="cursor-pointer list-none flex items-center justify-between gap-4 font-medium text-[.95rem]">
            {item.question}
            <span class="shrink-0 text-text-muted transition-transform duration-200 group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 text-[.9rem] text-text-muted leading-[1.7]">{item.answer}</p>
        </details>
      ))}
    </div>
  </section>
</ItalicPage>
