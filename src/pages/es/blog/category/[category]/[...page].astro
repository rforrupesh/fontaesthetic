---
import { imgUrl } from '../../../../../lib/imageUrl';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../../../../components/schema/BreadcrumbSchema.astro';
import CollectionPageSchema from '../../../../../components/schema/CollectionPageSchema.astro';
import OrganizationSchema from '../../../../../components/schema/OrganizationSchema.astro';
import WebSiteSchema from '../../../../../components/schema/WebSiteSchema.astro';
import { getCollection } from 'astro:content';
import { t, getPath } from '../../../../../i18n';
import { slugify } from '../../../../../lib/slugify';
import Pagination from '../../../../../components/Pagination.astro';
import { PAGE_SIZE } from '../../../../../lib/pagination';

const lang = 'es';
const strings = t(lang);

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const posts = (await getCollection('blog', (e) => e.id.startsWith('es/')))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  // Group original text by its lowercase URL slug, so "Fonts" and "fonts"
  // collapse into one page. A post can belong to several categorys.
  const slugTo = new Map<string, string>();
  posts.forEach((p) => p.data.categories.forEach((x) => {
    const slug = slugify(x);
    if (!slugTo.has(slug)) slugTo.set(slug, x);
  }));

  // One paginated set of pages per category: /category/<slug>/, /category/<slug>/2/ ...
  return Array.from(slugTo.entries()).flatMap(([slug, category]) =>
    paginate(
      posts.filter((p) => p.data.categories.some((x) => slugify(x) === slug)),
      { params: { category: slug }, props: { category }, pageSize: PAGE_SIZE },
    ),
  );
}

const { page, category } = Astro.props;
const posts = page.data;
const total = page.total;

const allPosts = await getCollection('blog', (e) => e.id.startsWith('es/'));

// Unique categories (by slug) across all posts, for the filter bar.
const slugToCategory = new Map<string, string>();
allPosts.forEach((p) => p.data.categories.forEach((c) => {
  const s = slugify(c);
  if (!slugToCategory.has(s)) slugToCategory.set(s, c);
}));
const categories = Array.from(slugToCategory.entries());


const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const base = import.meta.env.BASE_URL;
const basePath = `/blog/category/${slugify(category)}/`;
const pagePath = page.currentPage > 1 ? `${basePath}${page.currentPage}/` : basePath;
const pageUrl = siteUrl + getPath(lang, pagePath);
const pageSuffix = page.currentPage > 1 ? ` – ${strings.blog.page} ${page.currentPage}` : '';
const logoUrl = `${siteUrl}${base}logo.svg`;
const absImg = (img?: string) => { const u = imgUrl(img); return u ? (/^https?:/.test(u) ? u : siteUrl + u) : undefined; };
const collectionImage = absImg(posts.find((p) => p.data.image)?.data.image) ?? logoUrl;
const collectionItems = posts.map((p) => ({
  name: p.data.title,
  url: siteUrl + getPath(lang, `/blog/${p.data.slug ?? p.id.split('/').slice(1).join('/')}/`),
}));
const pageDescription = strings.blog.categoryDescription.replace('{name}', category).replace('{count}', String(total));
const title = category;
---

<BaseLayout
  lang={lang}
  title={`${title} ${strings.blog.archives}${pageSuffix} - ${strings.site.name}`}
  description={pageDescription}
  path={pagePath}
  alternates={page.currentPage > 1 ? { [lang]: pagePath } : undefined}
  switcherPath={page.currentPage > 1 ? pagePath : undefined}
  availableLangs={[lang]}
>
  <section class="wrap py-12 pb-6 text-center">
    <h1 class="text-[clamp(1.7rem,4vw,2.2rem)]">{title}{page.currentPage > 1 && <span class="text-text-muted font-normal"> · {strings.blog.page} {page.currentPage}</span>}</h1>
  </section>

  {categories.length > 0 && (
    <section class="wrap flex flex-wrap gap-2 justify-center pb-8">
      <a
        href={getPath(lang, '/blog/')}
        class="inline-block text-[.8rem] font-medium px-3.5 py-1.5 rounded-full bg-primary/10 text-primary hover:bg-primary/20"
      >
        {strings.blog.allCategories}
      </a>
      {categories.map(([slug, c]) => (
        <a
          href={getPath(lang, `/blog/category/${slug}/`)}
          class={`inline-block text-[.8rem] font-medium px-3.5 py-1.5 rounded-full ${slug === slugify(category) ? 'bg-primary text-white' : 'bg-primary/10 text-primary hover:bg-primary/20'}`}
        >
          {c}
        </a>
      ))}
    </section>
  )}

  <section class="wrap grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-7 pb-12">
    {posts.map((post) => {
      const slug = post.data.slug ?? post.id.split('/').slice(1).join('/');
      const postHref = getPath(lang, `/blog/${slug}/`);
      const cat = post.data.categories[0];
      return (
        <div class="card overflow-hidden flex flex-col">
          <a href={postHref} aria-label={post.data.title}>
            {post.data.image && <img src={imgUrl(post.data.image)} alt={post.data.title} loading="lazy" class="w-full aspect-video object-contain bg-surface-2" />}
          </a>
          <div class="p-5 pb-6">
            {cat && (
              <a
                href={getPath(lang, `/blog/category/${slugify(cat)}/`)}
                class="inline-block text-[.7rem] font-medium px-2.5 py-1 rounded-full bg-primary/10 text-primary mb-2 hover:bg-primary/20"
              >
                {cat}
              </a>
            )}
            <h2 class="text-[1.05rem] mb-2">
              <a href={postHref} class="hover:text-primary">{post.data.title}</a>
            </h2>
            <p class="text-[.88rem] text-text-muted mb-0">{post.data.description}</p>
          </div>
        </div>
      );
    })}
  </section>

  <Pagination lang={lang} basePath={basePath} current={page.currentPage} last={page.lastPage} />

  <BreadcrumbSchema
    items={[
      { name: strings.nav.home, url: siteUrl + getPath(lang, '/') },
      { name: strings.blog.listingTitle, url: siteUrl + getPath(lang, '/blog/') },
      { name: title, url: siteUrl + getPath(lang, basePath) },
      ...(page.currentPage > 1 ? [{ name: `${strings.blog.page} ${page.currentPage}`, url: pageUrl }] : []),
    ]}
  />
  <CollectionPageSchema
    name={`${title} ${strings.blog.archives}`}
    description={pageDescription}
    url={pageUrl}
    lang={lang}
    siteUrl={siteUrl + base}
    image={collectionImage}
    items={collectionItems}
  />
  <OrganizationSchema name={strings.site.name} siteUrl={siteUrl + base} logoUrl={logoUrl} />
  <WebSiteSchema name={strings.site.name} siteUrl={siteUrl + base} lang={lang} />
</BaseLayout>
