---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { t } from '../../i18n';
const strings = t('es');

const sections = [
  {
    title: "Qué recopilamos",
    text: "AestheticFonts no almacena el texto que escribes en el generador de fuentes. Toda la conversión se realiza directamente en tu navegador.",
  },
  {
    title: "Analítica",
    text: "Podemos usar analíticas básicas y respetuosas con la privacidad para entender el uso del sitio. No vendemos datos personales a terceros.",
  },
];
---
<BaseLayout lang="es" title={`Política de privacidad — ${strings.site.name}`} description="Política de privacidad de AestheticFonts." path="/privacy-policy/">
  <PageHero title="Política de privacidad" subtitle="Última actualización: enero de 2026" />

  <section class="wrap py-10 max-w-[680px] mx-auto flex flex-col gap-5">
    {sections.map((s) => (
      <div class="card p-5">
        <h2 class="text-[1.05rem] mb-2">{s.title}</h2>
        <p class="text-text-muted m-0">{s.text}</p>
      </div>
    ))}
  </section>
</BaseLayout>
