---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { t, getPath } from '../../i18n';
const strings = t('es');

const features = [
  { title: "No requiere registro", text: "Solo abre la página y empieza a escribir. Sin cuentas ni descargas." },
  { title: "Funciona en todas partes", text: "Pega en Instagram, WhatsApp, Discord, Twitter/X y más." },
  { title: "100 % gratis", text: "Sin costes ocultos ni plan premium, nunca." },
];
---
<BaseLayout lang="es" title={`Acerca de — ${strings.site.name}`} description="Conoce más sobre AestheticFonts, el generador de fuentes online gratuito." path="/about/">
  <PageHero
    title="Sobre nosotros"
    subtitle="Un generador de fuentes online gratuito que convierte el texto normal en elegantes fuentes Unicode que puedes copiar y pegar donde quieras."
  />

  <section class="wrap py-10 max-w-[820px] mx-auto">
    <div class="grid sm:grid-cols-3 gap-5 mb-8">
      {features.map((f) => (
        <div class="card p-5">
          <div class="w-8 h-8 rounded-md bg-primary/15 text-primary flex items-center justify-center mb-3">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
          </div>
          <h3 class="text-[1.02rem] mb-1.5">{f.title}</h3>
          <p class="text-text-muted text-[.9rem] m-0">{f.text}</p>
        </div>
      ))}
    </div>

    <p class="text-text-muted text-center max-w-[560px] mx-auto">
      Creado para creadores, profesionales del marketing y cualquiera que quiera que su texto destaque.
    </p>

    <p class="text-text-muted text-center mt-2">
      ¿Tienes una pregunta o sugerencia?
      <a href={getPath('es', '/contact/')} class="text-primary underline underline-offset-2 hover:text-primary-hover transition-colors duration-150">{strings.footer.contact}</a>
    </p>
  </section>
</BaseLayout>
