---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FancyTextTool from '../../components/FancyTextTool.astro';
---
<BaseLayout
  title="Generador de Texto Elegante — Estilos de Fuente Unicode estéticos, negrita, cursiva, burbuja, gótico"
  description="Genera texto unicode estético: negrita, cursiva, script, gótico, burbuja, encerrado, invertido y más de 30 estilos adicionales. Cada estilo es texto real en la página — cópialo con un clic."
  lang="es"
  path="/fancy-text/"
>
  <FancyTextTool
    title="Generador de Texto Elegante"
    intro="Escribe tu texto una vez — cada estilo abajo se actualiza al instante. Cada estilo es texto real y legible, no una imagen, así que se copia, pega y lee perfectamente en todas partes, incluidos los resultados de búsqueda."
  />
</BaseLayout>
