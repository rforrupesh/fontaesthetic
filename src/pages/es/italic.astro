---
import ItalicPage from '../../components/ItalicPage.astro';

const features = [
  {
    "label": "Conversión a caracteres Unicode:",
    "body": "Convierte las letras normales compatibles en caracteres de cursiva matemática."
  },
  {
    "label": "Copiar y pegar rápido:",
    "body": "Copia el texto generado y úsalo en otras aplicaciones."
  },
  {
    "label": "Sin instalar fuentes:",
    "body": "Crea letras de estilo cursivo sin descargar archivos de fuentes."
  },
  {
    "label": "Entrada de texto sencilla:",
    "body": "Escribe palabras, nombres o frases para generar texto inclinado."
  },
  {
    "label": "Herramienta en el navegador:",
    "body": "Usa el generador directamente desde tu navegador web."
  },
  {
    "label": "Uso gratuito:",
    "body": "Genera texto en cursiva sin registro ni pago."
  }
];
const where = [
  {
    "label": "Instagram:",
    "body": "Usa letras en cursiva en biografías, pies de foto y comentarios."
  },
  {
    "label": "Facebook:",
    "body": "Añade texto inclinado a publicaciones, comentarios y descripciones de perfil."
  },
  {
    "label": "WhatsApp:",
    "body": "Comparte texto Unicode de estilo cursivo en tus mensajes."
  },
  {
    "label": "TikTok:",
    "body": "Crea distintos estilos de texto para las descripciones de perfil."
  },
  {
    "label": "Discord:",
    "body": "Usa caracteres cursivos especiales en mensajes y campos de perfil compatibles."
  },
  {
    "label": "YouTube:",
    "body": "Añade letras decorativas a comentarios y descripciones de canal."
  },
  {
    "label": "Perfiles de juegos:",
    "body": "Crea nombres de usuario distintivos con caracteres Unicode compatibles."
  }
];
const steps = [
  "Abre la herramienta generador de cursiva.",
  "Escribe o pega tu texto normal en el cuadro de entrada.",
  "Mira el texto convertido a estilo cursivo.",
  "Haz clic en la opción de copiar para copiar el resultado.",
  "Pégalo en la aplicación o sitio web que prefieras."
];
const tools = [
  {
    "name": "Generador de fuentes",
    "url": "https://aestheticfonts.in/es/"
  },
  {
    "name": "Generador de texto subrayado",
    "url": "https://aestheticfonts.in/es/underline/"
  },
  {
    "name": "Generador de texto tachado",
    "url": "https://aestheticfonts.in/es/strikethrough/"
  }
];
const faqs = [
  {
    "question": "¿Puedo usar letras del alfabeto en cursiva sin formato?",
    "answer": "Sí. Las letras Unicode en cursiva se pueden copiar y pegar sin aplicar el formato de texto tradicional. Son caracteres Unicode independientes, por lo que su aspecto no depende de seleccionar la opción de cursiva en un editor de texto."
  },
  {
    "question": "¿Es gratis el creador de texto en cursiva?",
    "answer": "Sí. El creador de texto en cursiva es gratuito. Puedes convertir letras normales en texto de estilo cursivo y copiar el resultado sin pagar ni instalar software adicional."
  },
  {
    "question": "¿Puedo usar texto inclinado en mi nombre de usuario de redes sociales?",
    "answer": "Puedes usar caracteres Unicode inclinados en nombres para mostrar y descripciones de perfil si la plataforma los admite. Sin embargo, algunos sitios restringen los caracteres especiales en los nombres de usuario de las cuentas. Consulta las reglas de la plataforma antes de usar letras en cursiva en tu nombre de usuario."
  },
  {
    "question": "¿Funcionan las letras en cursiva en todos los dispositivos?",
    "answer": "Las letras Unicode en cursiva funcionan en dispositivos y aplicaciones que admitan los caracteres correspondientes. Sin embargo, su aspecto puede variar según el sistema operativo, el navegador y la fuente. Algunos caracteres pueden no mostrarse correctamente en dispositivos antiguos o aplicaciones no compatibles."
  }
];
---

<ItalicPage lang="es">
  <article class="wrap max-w-[900px] mx-auto py-10 text-text">
    <!-- Intro -->
    <header class="text-center mb-12">
      <h2 class="text-[clamp(1.6rem,3.4vw,2.2rem)] font-bold mb-4">Texto en cursiva: copiar y pegar</h2>
      <p class="text-text-muted text-[1.05rem] leading-[1.8]">El texto en cursiva usa letras inclinadas para dar a las palabras un aspecto diferente. Se utiliza comúnmente para enfatizar, para títulos, pies de foto y escritura decorativa. Un generador de texto en cursiva convierte las letras normales en caracteres Unicode especiales que se pueden copiar y pegar en perfiles de redes sociales, mensajes y otras aplicaciones.</p>
    </header>

    <!-- What is -->
    <section class="mb-12 rounded-2xl border border-border bg-surface p-6 md:p-8">
      <h2 class="text-2xl font-bold mb-3">¿Qué es el texto en cursiva Unicode?</h2>
      <p class="text-text-muted leading-[1.8]">El texto en cursiva Unicode usa caracteres especiales del bloque Símbolos alfanuméricos matemáticos (U+1D400 a U+1D7FF). Este bloque Unicode contiene distintos estilos de letras, como cursiva matemática, cursiva en negrita y caracteres de escritura manual. Estas letras tienen puntos de código Unicode propios y se pueden copiar y pegar sin aplicar el formato de cursiva tradicional.</p>
    </section>

    <!-- Why use -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-3">¿Por qué usar nuestro generador de cursiva?</h2>
      <p class="text-text-muted leading-[1.8]">Nuestro generador de cursiva convierte el texto normal en diferentes estilos de texto Unicode. Puedes crear texto Italic, Cursive, Script, Italic Bold (Serif) e Italic Bold (Sans) con un proceso de conversión sencillo. Escribe tu texto, mira el resultado convertido y cópialo para usarlo en biografías, pies de foto, comentarios y mensajes de redes sociales. La herramienta funciona directamente en tu navegador, sin necesidad de instalar fuentes ni software adicional.</p>
    </section>

    <!-- Extra features -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-3">Funciones adicionales del texto inclinado</h2>
      <p class="text-text-muted leading-[1.8] mb-5">El generador de texto en cursiva ofrece una forma sencilla de crear y copiar diferentes estilos de texto. Sus principales funciones son:</p>
      <ul class="list-none p-0 m-0 flex flex-col gap-3">
        {features.map((w) => (
          <li class="card px-5 py-3.5 text-sm leading-[1.7]"><strong class="font-semibold">{w.label}</strong> <span class="text-text-muted">{w.body}</span></li>
        ))}
      </ul>
    </section>

    <!-- Where to use -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-3">¿Dónde usar los estilos de fuente cursiva?</h2>
      <p class="text-text-muted leading-[1.8] mb-5">Los caracteres Unicode en cursiva se pueden usar en distintos sitios web y aplicaciones que los admitan. Se suelen usar para cambiar la apariencia de textos cortos y de la información del perfil.</p>
      <ul class="list-none p-0 m-0 flex flex-col gap-3">
        {where.map((w) => (
          <li class="card px-5 py-3.5 text-sm leading-[1.7]"><strong class="font-semibold">{w.label}</strong> <span class="text-text-muted">{w.body}</span></li>
        ))}
      </ul>
    </section>

    <!-- How to -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-3">¿Cómo poner el texto en cursiva?</h2>
      <p class="text-text-muted leading-[1.8] mb-4">Puedes poner texto en cursiva con un editor de texto o con un generador de texto en cursiva en línea. En aplicaciones como Microsoft Word y Google Docs, selecciona el texto y aplica la opción de formato cursiva.</p>
      <p class="text-text-muted leading-[1.8] mb-5">Para crear texto en cursiva que puedas copiar y pegar, sigue estos pasos:</p>
      <ol class="list-none p-0 m-0 flex flex-col gap-3">
        {steps.map((s, i) => (
          <li class="card px-5 py-3.5 text-sm leading-[1.7] flex gap-3"><span class="font-semibold text-primary">{i + 1}.</span> <span class="text-text-muted">{s}</span></li>
        ))}
      </ol>
    </section>

    <!-- Other tools -->
    <section>
      <h2 class="text-2xl font-bold mb-4">Otras herramientas</h2>
      <ul class="flex flex-wrap gap-2.5 list-none p-0 m-0">
        {tools.map((tool) => (
          <li>
            <a
              href={tool.url}
              class="inline-block rounded-full border border-border bg-surface px-4 py-2 text-sm font-medium hover:border-primary hover:text-primary transition-colors"
            >
              {tool.name}
            </a>
          </li>
        ))}
      </ul>
    </section>
  </article>

  <section class="wrap max-w-[900px] mx-auto pb-12">
    <h2 class="text-2xl font-bold mb-5 text-center">Preguntas frecuentes</h2>
    <div class="max-w-[720px] mx-auto flex flex-col gap-3">
      {faqs.map((item) => (
        <details class="card px-5 py-4 group">
          <summary class="cursor-pointer list-none flex items-center justify-between gap-4 font-medium text-[.95rem]">
            {item.question}
            <span class="shrink-0 text-text-muted transition-transform duration-200 group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 text-[.9rem] text-text-muted leading-[1.7]">{item.answer}</p>
        </details>
      ))}
    </div>
  </section>
</ItalicPage>
