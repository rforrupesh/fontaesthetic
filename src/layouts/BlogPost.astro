---
import Default from './Default.astro';
import Sidebar from '../components/Sidebar.astro';
import { t } from '../data/translations.js';

const {
  lang = 'en',
  title,
  description,
  date,
  slug,
  recentPosts = [],
  categories = [],
  relatedPosts = [],
} = Astro.props;

const tr = t(lang);
// path WITHOUT lang prefix — same slug is used for every language's translated post
const path = `/blog/${slug}/`;
---
<Default lang={lang} title={title} description={description} path={path}>
  <div class="row">
    <article class="col-lg-8">
      <h1 class="mb-2">{title}</h1>
      {date && <p class="text-muted">{new Date(date).toLocaleDateString(lang)}</p>}

      <div class="post-content mt-4">
        <slot />
      </div>

      {relatedPosts.length > 0 && (
        <div class="mt-5">
          <h4 class="mb-3">{tr.sidebar.relatedPosts}</h4>
          <div class="row">
            {relatedPosts.map((rp) => (
              <div class="col-md-6 mb-3">
                <div class="card h-100">
                  <div class="card-body">
                    <h6 class="card-title">
                      <a href={rp.url} class="text-decoration-none">{rp.title}</a>
                    </h6>
                    {rp.excerpt && <p class="card-text small text-muted">{rp.excerpt}</p>}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </article>

    <Sidebar tr={tr} recentPosts={recentPosts} categories={categories} />
  </div>
</Default>
