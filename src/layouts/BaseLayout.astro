---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  lang: 'en' | 'fr' | 'hi';
  title: string;
  description: string;
  path: string; // path without lang prefix, e.g. "/", "/about/", "/blog/my-post/"
  translations?: Partial<Record<'en' | 'fr' | 'hi', string>>; // full paths per lang for hreflang
}

const { lang, title, description, path, translations } = Astro.props;
const base = import.meta.env.BASE_URL;

function prefixFor(l: string) {
  return l === 'en' ? '' : `${l}/`;
}

function buildUrl(l: string, p: string) {
  const clean = p.replace(/^\/+/, '');
  return `${Astro.site}${base}${prefixFor(l)}${clean}`;
}

const altLinks = translations
  ? Object.entries(translations)
  : (['en', 'fr', 'hi'] as const).map((l) => [l, path]);

const htmlLang = lang === 'hi' ? 'hi' : lang;
---
<!DOCTYPE html>
<html lang={htmlLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={buildUrl(lang, path)} />
  {altLinks.map(([l, p]) => (
    <link rel="alternate" hreflang={l} href={buildUrl(l as string, p as string)} />
  ))}
  <link rel="alternate" hreflang="x-default" href={buildUrl('en', (translations?.en ?? path))} />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
</head>
<body>
  <header class="site-header">
    <Navbar lang={lang} translations={translations} />
  </header>
  <main class="wrap">
    <slot />
  </main>
  <Footer lang={lang} />
</body>
</html>
