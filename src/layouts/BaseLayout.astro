---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { languages, defaultLang, getPath, t } from '../i18n';

interface Props {
  lang: string;
  title: string;
  description?: string;
  path?: string; // path WITHOUT lang prefix, e.g. '/blog/my-post/' or '/'
  alternates?: Record<string, string>; // lang -> path (without lang prefix) for this exact page in other langs
  image?: string;
}

const {
  lang,
  title,
  description = '',
  path = '/',
  alternates,
  image,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const base = import.meta.env.BASE_URL;

function absoluteUrl(l: string, p: string) {
  return siteUrl + getPath(l, p);
}

const canonicalUrl = absoluteUrl(lang, path);
const strings = t(lang);

// Build the lang -> path map used for hreflang tags AND the language
// switcher. If the page didn't pass an explicit `alternates` prop (i.e. the
// same path exists under every language, like /about/, /blog/, /contact/),
// default every language to the current `path` so switching languages keeps
// you on the equivalent page instead of jumping to that language's homepage.
const langCodes = Object.keys(languages);
const resolvedAlternates: Record<string, string> =
  alternates ?? Object.fromEntries(langCodes.map((l) => [l, path]));
const hreflangEntries = Object.entries(resolvedAlternates);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <!-- Declaring our own generator tag stops Astro from auto-injecting
         "Astro vX.X.X" here, so view-source doesn't reveal the framework. -->
    <meta name="generator" content={strings.site.name} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalUrl} />
    {hreflangEntries.map(([l, p]) => (
      <link rel="alternate" hreflang={l} href={absoluteUrl(l, p)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(defaultLang, resolvedAlternates[defaultLang] ?? path)} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    {image && <meta property="og:image" content={siteUrl + base + image.replace(/^\/+/, '')} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const theme = stored || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <Navbar lang={lang} alternates={resolvedAlternates} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} alternates={resolvedAlternates} />
  </body>
</html>
