---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { languages, defaultLang, getPath, t } from '../i18n';

interface Props {
  lang: string;
  title: string;
  description?: string;
  path?: string; // path WITHOUT lang prefix, e.g. '/blog/my-post/' or '/'
  alternates?: Record<string, string>; // lang -> path (without lang prefix) for this exact page in other langs
  image?: string;
  // optional: restrict which languages appear in the language switcher, for
  // pages that only exist in one language (e.g. an English-only tool page).
  availableLangs?: string[];
  // article SEO (blog posts)
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  noindex?: boolean;
  // paginated pages (/blog/2/): other languages may not have that page, so
  // the language switcher links to this path instead and hreflang stays self-only.
  switcherPath?: string;
}

const {
  lang,
  title,
  description = '',
  path = '/',
  alternates,
  image,
  availableLangs,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  noindex = false,
  switcherPath,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const base = import.meta.env.BASE_URL;

function absoluteUrl(l: string, p: string) {
  return siteUrl + getPath(l, p);
}

const canonicalUrl = absoluteUrl(lang, path);
// Images may already be absolute (https://...) -- don't prefix those.
const ogImage = image
  ? (/^https?:\/\//.test(image) ? image : siteUrl + base + image.replace(/^\/+/, ''))
  : undefined;
const ogLocales: Record<string, string> = { en: 'en_US', fr: 'fr_FR', ar: 'ar_AR', th: 'th_TH', tr: 'tr_TR', id: 'id_ID', vi: 'vi_VN', pl: 'pl_PL', es: 'es_ES', it: 'it_IT', ja: 'ja_JP', de: 'de_DE', pt: 'pt_BR' };
const strings = t(lang);

// Build the lang -> path map used for hreflang tags AND the language
// switcher. If the page didn't pass an explicit `alternates` prop (i.e. the
// same path exists under every language, like /about/, /blog/, /contact/),
// default every language to the current `path` so switching languages keeps
// you on the equivalent page instead of jumping to that language's homepage.
const langCodes = availableLangs ?? Object.keys(languages);
const resolvedAlternates: Record<string, string> =
  alternates ?? Object.fromEntries(langCodes.map((l) => [l, path]));
const switcherAlternates: Record<string, string> = switcherPath
  ? Object.fromEntries(langCodes.map((l) => [l, switcherPath]))
  : resolvedAlternates;
const hreflangEntries = Object.entries(resolvedAlternates).filter(
  ([l]) => !availableLangs || availableLangs.includes(l)
);
// If this page has no English version (e.g. a French-only tag page), point
// x-default at the current page itself instead of assuming the raw `path`
// also applies to English -- that would build a broken/unrelated English URL.
const [xDefaultLang, xDefaultPath] = resolvedAlternates[defaultLang]
  ? [defaultLang, resolvedAlternates[defaultLang]]
  : [lang, path];
---

<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="generator" content={strings.site.name} />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalUrl} />
    {hreflangEntries.map(([l, p]) => (
      <link rel="alternate" hreflang={l} href={absoluteUrl(l, p)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(xDefaultLang, xDefaultPath)} />

    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />

    <meta property="og:site_name" content={strings.site.name} />
    <meta property="og:locale" content={ogLocales[lang] ?? 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {type === 'article' && tags.map((tg) => <meta property="article:tag" content={tg} />)}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

    <script is:inline>
      (function () {
        // pref = what the user picked: 'system' (default) | 'light' | 'dark'.
        // data-theme = what is actually shown ('light' or 'dark'), so the CSS only knows two themes.
        var pref = 'system';
        try {
          if (!localStorage.getItem('theme-v2')) {
            localStorage.removeItem('theme');
            localStorage.setItem('theme-v2', '1');
          }
          var stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark' || stored === 'system') pref = stored;
        } catch (e) {}
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        var root = document.documentElement;
        function apply() {
          root.setAttribute('data-theme-pref', pref);
          root.setAttribute('data-theme', pref === 'system' ? (mq.matches ? 'dark' : 'light') : pref);
        }
        apply();
        // In "system" mode, follow the OS when it switches (e.g. automatic night mode).
        mq.addEventListener('change', function () { if (pref === 'system') apply(); });
        window.__setThemePref = function (next) {
          pref = next;
          try { localStorage.setItem('theme', next); } catch (e) {}
          apply();
        };
      })();
    </script>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1820825216397031"
     crossorigin="anonymous"></script>
<script src="https://analytics.ahrefs.com/analytics.js" data-key="hjkiv3ee6nerJoiCLxFwVA" async></script>
<script async src="https://www.googletagmanager.com/gtm.js?id=GTM-56CFNLHF"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
</script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">{strings.a11y.skipToContent}</a>
    <Navbar lang={lang} alternates={switcherAlternates} availableLangs={availableLangs} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} alternates={switcherAlternates} availableLangs={availableLangs} />

    <button type="button" id="back-to-top" class="back-to-top" aria-label={strings.a11y.backToTop} title={strings.a11y.backToTop} hidden>
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6" /></svg>
    </button>
    <script is:inline>
      (function () {
        var btn = document.getElementById('back-to-top');
        if (!btn) return;
        var ticking = false;
        function update() {
          var show = window.scrollY > 500;
          if (show) { btn.hidden = false; requestAnimationFrame(function () { btn.classList.add('is-visible'); }); }
          else { btn.classList.remove('is-visible'); }
          ticking = false;
        }
        window.addEventListener('scroll', function () {
          if (!ticking) { ticking = true; requestAnimationFrame(update); }
        }, { passive: true });
        btn.addEventListener('transitionend', function () { if (!btn.classList.contains('is-visible')) btn.hidden = true; });
        btn.addEventListener('click', function () {
          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
        });
        update();
      })();
    </script>

    <script is:inline define:vars={{ base }}>
      // Registers the service worker that caches static assets and pages
      // so repeat visits (and full page navigations) load instantly from
      // the browser instead of hitting the network every time. It runs
      // after 'load' so it never competes with this page's own loading.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register(`${base}sw.js`, { scope: base });
        });
      }
    </script>
  </body>
</html>
