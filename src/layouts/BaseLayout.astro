---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  lang: 'en' | 'fr' | 'es';
  path: string; // path WITHOUT lang prefix — e.g. "/fancy-text/"
}
const { title, description, lang, path } = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <SEO title={title} description={description} lang={lang} path={path} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,wght@0,400;0,500;0,600;0,700&display=swap" rel="stylesheet" />
  <meta name="google-adsense-account" content="ca-pub-XXXXXXXXXXXXXXXX" />
</head>
<body>
  <Navbar lang={lang} path={path} />
  <div class="wrap">
    <slot />
  </div>
  <Footer lang={lang} />
  <script src="../scripts/site-chrome.js"></script>
</body>
</html>
